+func TestValidateSyzPilotConfigRequiresTrainingIdentity(t *testing.T) {
+	valid := mgrconfig.SyzPilotCfg{
+		TaskName:  "task",
+		TargetPCs: []string{"0x81234567"},
+		ReachFilter: mgrconfig.ReachFilterCfg{
+			Enable:     true,
+			Controller: "172.17.0.1:48000",
+		},
+	}
+	if err := validateSyzPilotConfig(valid); err != nil {
+		t.Fatalf("valid configuration rejected: %v", err)
+	}
+
+	tests := []struct {
+		name string
+		edit func(*mgrconfig.SyzPilotCfg)
+	}{
+		{"missing controller", func(cfg *mgrconfig.SyzPilotCfg) { cfg.ReachFilter.Controller = "" }},
+		{"missing task", func(cfg *mgrconfig.SyzPilotCfg) { cfg.TaskName = "" }},
+		{"missing targets", func(cfg *mgrconfig.SyzPilotCfg) { cfg.TargetPCs = nil }},
+		{"duplicate targets", func(cfg *mgrconfig.SyzPilotCfg) {
+			cfg.TargetPCs = []string{"0x81234567", "0xffffffff81234567"}
+		}},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			cfg := valid
+			test.edit(&cfg)
+			if err := validateSyzPilotConfig(cfg); err == nil {
+				t.Fatal("invalid configuration was accepted")
+			}
+		})
+	}
+
+	rfilterDisabled := valid
+	rfilterDisabled.ReachFilter.Enable = false
+	rfilterDisabled.ReachFilter.Controller = ""
+	rfilterDisabled.TargetPCs = []string{"0x81234567", "0xffffffff81234567"}
+	if err := validateSyzPilotConfig(rfilterDisabled); err == nil {
+		t.Fatal("duplicate target_pcs were accepted when reach filtering was disabled")
+	}
+}
