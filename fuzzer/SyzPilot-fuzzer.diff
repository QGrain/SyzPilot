+
+	result, err = fuzzer.ApplyGuidance(&syzpilotlib.GuidancePayload{
+		Version: 2,
+		SyscallWeights: map[string]float64{
+			call.Name: 2,
+			"unknown": math.Inf(1),
+		},
+	})
+	if err != nil || result.AcceptedWeights != 1 || result.RejectedWeights != 1 {
+		t.Fatalf("weight validation failed: result=%+v err=%v", result, err)
+	}
+	fuzzer.updateChoiceTable(nil)
+	count, total := fuzzer.ChoiceTable().GuidanceStats()
+	if count != 1 || total != 2 {
+		t.Fatalf("rebuilt table guidance = %d/%f, want 1/2", count, total)
+	}
+
+	result, err = fuzzer.ApplyGuidance(&syzpilotlib.GuidancePayload{Version: 3})
+	if err != nil || result.AcceptedWeights != 0 || result.AcceptedTemplates != 0 {
+		t.Fatalf("empty clear guidance failed: result=%+v err=%v", result, err)
+	}
+	count, total = fuzzer.ChoiceTable().GuidanceStats()
+	if count != 0 || total != 0 || len(fuzzer.MutateOpts().Templates) != 0 {
+		t.Fatalf("clear guidance retained stale state: weights=%d/%f templates=%d",
+			count, total, len(fuzzer.MutateOpts().Templates))
+	}
+	if _, err := fuzzer.ApplyGuidance(&syzpilotlib.GuidancePayload{
+		Version: 4,
+		SyscallWeights: map[string]float64{
+			"unknown": math.Inf(1),
+		},
+	}); err == nil {
+		t.Fatal("non-empty guidance with no valid entries was accepted as a clear")
+	}
+
+	accepted, rejected := fuzzer.convertGuidanceTemplates(
+		[]syzpilotlib.MutationTemplate{{
+			Type: "sequence", Syscalls: []string{call.Name}, Priority: 1,
+			InsertMode: "suffix", ArgHints: []syzpilotlib.ArgConstraint{{
+				Syscall: call.Name, ArgIdx: 0, Value: 99,
+			}},
+		}},
+	)
+	if len(accepted) != 0 || rejected != 1 {
+		t.Fatalf("unsafe arg hint was accepted: accepted=%d rejected=%d",
+			len(accepted), rejected)
+	}
+}
