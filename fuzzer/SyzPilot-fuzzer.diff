+func TestPermanentRejectionIsDeadLetteredAndDoesNotBlockNextBatch(t *testing.T) {
+	stream := &fakeTrainingStream{responses: []*pb.BatchResponse{
+		{BatchId: 1, Status: "rejected", Message: "invalid label"},
+		{BatchId: 2, Status: "success", ProcessedSamples: 1},
+	}}
+	collector := newTestCollector(t, stream, 10)
+	badPositive := trainingExample("bad-positive")
+	badNegative := trainingExample("bad-negative")
+	badNegative.TargetLabels = []bool{true, false}
+	first := &pb.TrainingBatch{
+		BatchId:  1,
+		Examples: []*pb.TrainingExample{badPositive, badNegative},
+	}
+	second := &pb.TrainingBatch{
+		BatchId:  2,
+		Examples: []*pb.TrainingExample{trainingExample("good")},
+	}
+	if err := collector.persistBatch(first); err != nil {
+		t.Fatal(err)
+	}
+	if err := collector.persistBatch(second); err != nil {
+		t.Fatal(err)
+	}
+	collector.pendingMu.Lock()
+	collector.pending = append(collector.pending, first, second)
+	collector.pendingMu.Unlock()
+	collector.updateStats(badPositive.TargetLabels)
+	collector.updateStats(badNegative.TargetLabels)
+	collector.updateStats(second.Examples[0].TargetLabels)
+	atomic.StoreInt64(&collector.stats.BatchID, 2)
+	collector.signalSender()
+	waitFor(t, func() bool { return collector.pendingCount() == 0 })
+
+	if got := atomic.LoadInt64(&collector.stats.SentBatches); got != 1 {
+		t.Fatalf("sent batches = %d, want 1", got)
+	}
+	if got := atomic.LoadInt64(&collector.stats.RejectedBatches); got != 1 {
+		t.Fatalf("rejected batches = %d, want 1", got)
+	}
+	if total, positive, negative := atomic.LoadInt64(&collector.stats.TotalSamples),
+		atomic.LoadInt64(&collector.stats.PositiveSamples),
+		atomic.LoadInt64(&collector.stats.NegativeSamples); total != 1 || positive != 1 || negative != 0 {
+		t.Fatalf("post-rejection stats = total/positive/negative %d/%d/%d, want 1/1/0",
+			total, positive, negative)
+	}
+	record, recordedBatch, err := loadRejectedRecord(collector.rejectedRecordPath(1))
+	if err != nil {
+		t.Fatalf("loadRejectedRecord() failed: %v", err)
+	}
+	if record.Message == "" || !proto.Equal(recordedBatch, first) {
+		t.Fatalf("dead letter did not preserve batch and metadata: %+v", record)
+	}
+	if _, err := os.Stat(collector.batchSpoolPath(1)); !os.IsNotExist(err) {
+		t.Fatalf("active rejected WAL still exists: %v", err)
+	}
+	stream.mu.Lock()
+	firstSentID := stream.sent[0].BatchId
+	secondSentID := stream.sent[1].BatchId
+	stream.mu.Unlock()
+	if firstSentID != 1 || secondSentID != 2 {
+		t.Fatalf("sent batch IDs = %d/%d, want 1/2", firstSentID, secondSentID)
+	}
+	if err := collector.Close(); err != nil {
+		t.Fatalf("Close() failed: %v", err)
+	}
+
+	restarted := &MLDataCollector{
+		spoolDir: collector.spoolDir,
+		buffer:   make([]*pb.TrainingExample, 0, 10),
+	}
+	if err := restarted.loadSpool(); err != nil {
+		t.Fatalf("loadSpool() failed: %v", err)
+	}
+	if restarted.pendingCount() != 0 {
+		t.Fatalf("dead-lettered batch was restored to pending queue")
+	}
+	if got := atomic.LoadInt64(&restarted.stats.BatchID); got != 2 {
+		t.Fatalf("restored terminal watermark = %d, want 2", got)
+	}
+	if got := atomic.LoadInt64(&restarted.stats.RejectedBatches); got != 1 {
+		t.Fatalf("restored rejected batches = %d, want 1", got)
+	}
+	restarted.buffer = append(restarted.buffer, trainingExample("next"))
+	if err := restarted.queueBufferedBatch(false); err != nil {
+		t.Fatal(err)
+	}
+	if got := restarted.pending[0].BatchId; got != 3 {
+		t.Fatalf("next batch ID = %d, want 3", got)
+	}
+}
