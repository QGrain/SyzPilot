+func TestStandaloneGuidanceRequiresExplicitConfig(t *testing.T) {
+	for _, test := range []struct {
+		name string
+		data string
+		want bool
+	}{
+		{name: "default", data: `{"target":"linux/amd64"}`, want: false},
+		{name: "enabled", data: `{"target":"linux/amd64","SyzPilot":{"allow_standalone_guidance":true}}`, want: true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			var cfg struct {
+				SyzPilot SyzPilotCfg `json:"SyzPilot"`
+			}
+			err := json.Unmarshal([]byte(test.data), &cfg)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if cfg.SyzPilot.AllowStandaloneGuidance != test.want {
+				t.Fatalf("standalone guidance = %v, want %v",
+					cfg.SyzPilot.AllowStandaloneGuidance, test.want)
+			}
+		})
+	}
+}
