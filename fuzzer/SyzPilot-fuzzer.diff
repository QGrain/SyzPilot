+func TestSignatureCacheEvictsLeastRecentlyUsedAtCapacity(t *testing.T) {
+	cache := newSignatureCache(2)
+	cache.record("oldest", 1)
+	cache.record("recent", 1)
+	if _, found := cache.lookup("oldest"); !found {
+		t.Fatal("expected oldest entry before recency update")
+	}
+	cache.record("new", 1)
+	if len(cache.entries) != 2 {
+		t.Fatalf("cache size = %d, want 2", len(cache.entries))
+	}
+	if _, found := cache.lookup("recent"); found {
+		t.Fatal("least recently used entry was not evicted")
+	}
+	if _, found := cache.lookup("oldest"); !found {
+		t.Fatal("recently touched entry was evicted")
+	}
+	if _, found := cache.lookup("new"); !found {
+		t.Fatal("new entry is missing")
+	}
