+// ApplyGuidance applies syscall guidance from the brain controller.
+// Updates ChoiceTable weights for guided syscall selection.
+func (fuzzer *Fuzzer) ApplyGuidance(
+	guidance *syzpilotlib.GuidancePayload,
+) (syzpilotlib.GuidanceApplyResult, error) {
+	if guidance == nil {
+		return syzpilotlib.GuidanceApplyResult{}, fmt.Errorf("guidance payload is nil")
+	}
+	if guidance.Version <= 0 {
+		return syzpilotlib.GuidanceApplyResult{}, fmt.Errorf("guidance version must be positive")
+	}
+	isClear := len(guidance.SyscallWeights) == 0 && len(guidance.MutationTemplates) == 0
+
+	fuzzer.guidanceMu.Lock()
+	defer fuzzer.guidanceMu.Unlock()
+	if guidance.Version < fuzzer.guidanceVersion {
+		return syzpilotlib.GuidanceApplyResult{}, fmt.Errorf(
+			"stale guidance version %d; current version is %d",
+			guidance.Version, fuzzer.guidanceVersion,
+		)
+	}
+	if guidance.Version == fuzzer.guidanceVersion {
+		result := fuzzer.guidanceResult
+		result.Status = "already_applied"
+		return result, nil
+	}
+
+	programs := fuzzer.Config.Corpus.Programs()
+	newChoiceTable := fuzzer.target.BuildChoiceTable(programs, fuzzer.Config.EnabledCalls)
+	acceptedWeights, rejectedWeights := newChoiceTable.UpdateGuidance(
+		guidance.SyscallWeights,
+	)
+	acceptedTemplates, rejectedTemplates := fuzzer.convertGuidanceTemplates(
+		guidance.MutationTemplates,
+	)
+	if !isClear && len(acceptedWeights) == 0 && len(acceptedTemplates) == 0 {
+		return syzpilotlib.GuidanceApplyResult{}, fmt.Errorf(
+			"guidance contains no valid generatable syscall or template",
+		)
+	}
+
+	fuzzer.ctMu.Lock()
+	fuzzer.ct = newChoiceTable
+	fuzzer.ctProgs = len(programs)
+	fuzzer.ctMu.Unlock()
+	fuzzer.guidanceVersion = guidance.Version
+	fuzzer.guidanceWeights = acceptedWeights
+	fuzzer.guidanceTemplates = acceptedTemplates
+	fuzzer.guidanceAnchors = fuzzer.convertGuidanceAnchors(
+		guidance.GenerationHints.PreferredSyscalls,
+	)
+	fuzzer.directedCorpus.replaceAnchors(fuzzer.guidanceAnchors)
+	fuzzer.guidanceResult = syzpilotlib.GuidanceApplyResult{
+		Status:            "applied",
+		Version:           guidance.Version,
+		AcceptedWeights:   len(acceptedWeights),
+		RejectedWeights:   rejectedWeights,
+		AcceptedTemplates: len(acceptedTemplates),
+		RejectedTemplates: rejectedTemplates,
+	}
+	fuzzer.Logf(0,
+		"[SyzPilot] Guidance v%d applied: weights=%d accepted/%d rejected, templates=%d accepted/%d rejected",
+		guidance.Version, len(acceptedWeights), rejectedWeights,
+		len(acceptedTemplates), rejectedTemplates,
+	)
+	return fuzzer.guidanceResult, nil
+}
+
+func (fuzzer *Fuzzer) convertGuidanceAnchors(names []string) []string {
+	seen := make(map[string]bool, len(names))
+	anchors := make([]string, 0, len(names))
+	for _, name := range names {
+		if seen[name] || fuzzer.target.SyscallMap[name] == nil {
+			continue
+		}
+		seen[name] = true
+		anchors = append(anchors, name)
+	}
+	return anchors
+}
+
+func (fuzzer *Fuzzer) convertGuidanceTemplates(
+	templates []syzpilotlib.MutationTemplate,
+) ([]prog.MutationTemplate, int) {
+	const maxTemplates = 64
+	const maxTemplateSyscalls = 32
+	const maxTemplateArgHints = 64
+	generatable := make(map[string]*prog.Syscall)
+	if fuzzer.Config.EnabledCalls == nil {
+		for _, call := range fuzzer.target.Syscalls {
+			if !call.Attrs.Disabled && !call.Attrs.NoGenerate {
+				generatable[call.Name] = call
+			}
+		}
+	} else {
+		for call, enabled := range fuzzer.Config.EnabledCalls {
+			if enabled && !call.Attrs.Disabled && !call.Attrs.NoGenerate {
+				generatable[call.Name] = call
+			}
+		}
+	}
+	accepted := make([]prog.MutationTemplate, 0, min(len(templates), maxTemplates))
+	rejected := 0
+	for index, template := range templates {
+		if index >= maxTemplates || template.Priority <= 0 ||
+			math.IsNaN(template.Priority) || math.IsInf(template.Priority, 0) ||
+			len(template.Syscalls) == 0 || len(template.Syscalls) > maxTemplateSyscalls ||
+			len(template.ArgHints) > maxTemplateArgHints ||
+			(template.Type != "sequence" && template.Type != "prefix" &&
+				template.Type != "splice") ||
+			(template.InsertMode != "prefix" && template.InsertMode != "suffix" &&
+				template.InsertMode != "replace") {
+			rejected++
+			continue
+		}
+		valid := true
+		templateCalls := make(map[string]bool, len(template.Syscalls))
+		for _, name := range template.Syscalls {
+			if generatable[name] == nil {
+				valid = false
+				break
+			}
+			templateCalls[name] = true
+		}
+		seenHints := make(map[string]bool, len(template.ArgHints))
+		for _, hint := range template.ArgHints {
+			call := generatable[hint.Syscall]
+			hintKey := fmt.Sprintf("%s\x00%d", hint.Syscall, hint.ArgIdx)
+			if call == nil || !templateCalls[hint.Syscall] || seenHints[hintKey] ||
+				prog.ValidateArgConstraint(call, hint.ArgIdx, hint.Value) != nil {
+				valid = false
+				break
+			}
+			seenHints[hintKey] = true
+		}
+		if !valid {
+			rejected++
+			continue
+		}
+		converted := prog.MutationTemplate{
+			Type:       template.Type,
+			Syscalls:   append([]string(nil), template.Syscalls...),
+			Priority:   template.Priority,
+			InsertMode: template.InsertMode,
+			ArgHints:   make([]prog.ArgConstraint, len(template.ArgHints)),
+		}
+		for hintIndex, hint := range template.ArgHints {
+			converted.ArgHints[hintIndex] = prog.ArgConstraint{
+				Syscall: hint.Syscall,
+				ArgIdx:  hint.ArgIdx,
+				Value:   hint.Value,
+			}
+		}
+		accepted = append(accepted, converted)
+	}
+	return accepted, rejected
+}
