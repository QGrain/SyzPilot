+		osutil.MkdirAll(filepath.Join(fuzzer.Config.SyzPilotCfg.DumpDir, lastTargetAddrStr, "programs"))
+		osutil.MkdirAll(filepath.Join(fuzzer.Config.SyzPilotCfg.DumpDir,
+			lastTargetAddrStr, "coverage"))
+	}
+	if fuzzer.Config.SyzPilotCfg.EnableDiverseCover {
+		fuzzer.DiverseCoverEnabled.Store(true)
+		fuzzer.DiverseCoverTargets = make(map[string]bool)
+		if len(fuzzer.Config.SyzPilotCfg.DiverseCoverTargets) != 0 {
+			for _, target := range fuzzer.Config.SyzPilotCfg.DiverseCoverTargets {
+				fuzzer.DiverseCoverTargets[target] = true
+			}
+		} else {
+			// Set smashQueue and genFuzzQueue to true by default
+			fuzzer.DiverseCoverTargets = map[string]bool{
+				"exec smash":   true,
+				"exec hints":   true,
+				"exec inject":  true,
+				"exec gen":     true,
+				"exec fuzz":    true,
+				"exec collide": true,
+			}
+		}
+		fuzzer.DiverseCoverRatio.Store(&fuzzer.Config.SyzPilotCfg.DiverseCoverRatio)
+	}
+	if fuzzer.Config.SyzPilotCfg.ReachFilter.Enable {
+		// once reachfilter is enabled, the addr of receiver and tsserver should be notified by the controller
+		if fuzzer.Config.SyzPilotRTCfg.ReceiverAddr == "" || fuzzer.Config.SyzPilotRTCfg.TSServerAddr == "" {
+			panic("data receiver addr and/or torchserve server addr are/is empty")
+		}
+		labelSchemaID := fmt.Sprintf(
+			"labels-v1|width=%d|targets=%s",
+			len(fuzzer.TargetAddrStrs)+1,
+			strings.Join(fuzzer.TargetAddrStrs, ","),
+		)
+		collectorCfg := &collector.Config{
+			ServerAddr:          fuzzer.Config.SyzPilotRTCfg.ReceiverAddr,
+			BufferSize:          100, // flush after 100 samples
+			BufferWALCheckpoint: 1,
+			FlushInterval:       5 * time.Minute, // periodic flush every 5 min
+			TargetAddrs:         fuzzer.TargetAddrVals,
+			MaxBatchSize:        300 * 1024 * 1024, // 1GB
+			SpoolDir: filepath.Join(
+				fuzzer.Config.SyzPilotSpoolDir,
+				hash.String([]byte(fuzzer.Config.SyzPilotCfg.TaskName)),
+				hash.String([]byte(labelSchemaID)),
+			),
+			SchemaID: labelSchemaID,
+		}
+		collector, err := collector.NewDataCollector(fuzzer.ctx, collectorCfg)
+		if err != nil {
+			panic(fmt.Sprintf("failed to create ML data collector: %v", err))
+		}
+		fuzzer.DataCollector = collector
+		// Only create predictor if a model is already deployed (ModelName is non-empty).
+		// Otherwise, the predictor will be created lazily when the brain controller
+		// sends a model deployment notification via /model_ready callback.
+		if fuzzer.Config.SyzPilotRTCfg.ModelName != "" {
+			predictorCfg := &predictor.Config{
+				ServerAddr:   fuzzer.Config.SyzPilotRTCfg.TSServerAddr,
+				ModelName:    fuzzer.Config.SyzPilotRTCfg.ModelName,
+				ModelVersion: fuzzer.Config.SyzPilotRTCfg.ModelVersion,
+				PoolSize:     4,
+			}
+			predictor, err := predictor.NewPredictor(fuzzer.ctx, predictorCfg)
+			if err != nil {
+				panic(fmt.Sprintf("failed to create predictor: %v", err))
+			}
+			fuzzer.Predictor = predictor
+		} else {
+			fuzzer.Logf(0, "[SyzPilot] No model deployed yet — predictor will be created when model becomes available via /model_ready callback")
+		}
+	}
+	fuzzer.initSyzPilotStats()
+}
