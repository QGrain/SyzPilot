+	stat.New("collector buffer wal file syncs", "Buffer WAL file sync attempts",
+		telemetryInt(&collectorTelemetry.bufferWALFileSyncs))
+	stat.New("collector buffer wal directory syncs", "Buffer WAL directory sync attempts",
+		telemetryInt(&collectorTelemetry.bufferWALDirSyncs))
+	stat.New("collector buffer wal failures", "Buffer WAL persistence failures",
