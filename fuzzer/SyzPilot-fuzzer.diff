+package collector
+
+import (
+	"testing"
+	"time"
+)
+
+func TestLatencyBucketsQuantiles(t *testing.T) {
+	var buckets latencyBuckets
+	if got := buckets.quantile(95, 100); got != 0 {
+		t.Fatalf("empty p95 = %d, want 0", got)
+	}
+	for _, duration := range []time.Duration{
+		25 * time.Microsecond,
+		75 * time.Microsecond,
+		200 * time.Microsecond,
+		400 * time.Microsecond,
+		750 * time.Microsecond,
+		2 * time.Millisecond,
+		4 * time.Millisecond,
+		9 * time.Millisecond,
+		20 * time.Millisecond,
+		40 * time.Millisecond,
+		90 * time.Millisecond,
+		200 * time.Millisecond,
+		400 * time.Millisecond,
+		900 * time.Millisecond,
+		2 * time.Second,
+	} {
+		buckets.observe(duration)
+	}
+	if got := buckets.quantile(50, 100); got != 10_000 {
+		t.Fatalf("p50 = %d, want 10000", got)
+	}
+	if got := buckets.quantile(95, 100); got != -1 {
+		t.Fatalf("p95 = %d, want overflow sentinel -1", got)
+	}
+}
+
+func TestLatencyBucketsRoundsUpMicroseconds(t *testing.T) {
+	var buckets latencyBuckets
+	buckets.observe(50*time.Microsecond + time.Nanosecond)
+	if got := buckets.quantile(50, 100); got != 100 {
+		t.Fatalf("rounded bucket = %d, want 100", got)
+	}
+}
