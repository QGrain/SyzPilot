@@ -0,0 +1,65 @@
+// Copyright 2026 syzkaller project authors. All rights reserved.
+// Use of this source code is governed by Apache 2 LICENSE that can be found in the LICENSE file.
+
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestWriteAtomicReplacesFileAndUsesPublicReadMode(t *testing.T) {
+	directory := t.TempDir()
+	path := filepath.Join(directory, "manifest.json")
+	if err := os.WriteFile(path, []byte("old"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := writeAtomic(path, []byte("new\n")); err != nil {
+		t.Fatal(err)
+	}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(data) != "new\n" {
+		t.Fatalf("published data = %q", data)
+	}
+	info, err := os.Stat(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if info.Mode().Perm() != 0o644 {
+		t.Fatalf("published mode = %#o, want 0644", info.Mode().Perm())
+	}
+	assertNoTemporaryFiles(t, directory)
+}
+
+func TestWriteAtomicCleansTemporaryFileAfterRenameFailure(t *testing.T) {
+	directory := t.TempDir()
+	path := filepath.Join(directory, "occupied")
+	if err := os.Mkdir(path, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(path, "sentinel"), []byte("keep"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := writeAtomic(path, []byte("new\n")); err == nil {
+		t.Fatal("rename onto a non-empty directory unexpectedly succeeded")
+	}
+	if _, err := os.Stat(filepath.Join(path, "sentinel")); err != nil {
+		t.Fatalf("destination was changed after failure: %v", err)
+	}
+	assertNoTemporaryFiles(t, directory)
+}
+
+func assertNoTemporaryFiles(t *testing.T, directory string) {
+	t.Helper()
+	matches, err := filepath.Glob(filepath.Join(directory, ".syzpilot-manifest-*"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(matches) != 0 {
+		t.Fatalf("temporary files remain: %v", matches)
+	}
+}
