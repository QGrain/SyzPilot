+func (fuzzer *Fuzzer) schedulePredictedSmash(req *queue.Request) {
+	if req == nil || req.Prog == nil {
+		return
+	}
+	program := req.Prog.Clone()
+	fuzzer.startJob(fuzzer.statJobsSmash, &smashJob{
+		exec: fuzzer.smashQueue,
+		p:    program,
+		info: &JobInfo{
+			Name: program.String(),
+			Type: "reachability-predicted smash",
+		},
+	})
+}
