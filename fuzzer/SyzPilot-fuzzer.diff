+// Copyright 2026 syzkaller project authors. All rights reserved.
+// Use of this source code is governed by Apache 2 LICENSE that can be found in the LICENSE file.
+
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/google/syzkaller/prog"
+	_ "github.com/google/syzkaller/sys"
+)
+
+func TestBuildSeedCatalogIncludesGeneratedNoGenerateSeedsOnly(t *testing.T) {
+	target, err := prog.GetTarget("linux", "amd64")
+	if err != nil {
+		t.Fatal(err)
+	}
+	sourceDir := filepath.Join("..", "..", "sys", "linux", "test")
+	directory := t.TempDir()
+	copyFile(t,
+		filepath.Join(sourceDir, "syz_mount_image_f2fs_0"),
+		filepath.Join(directory, "syz_mount_image_f2fs_0"),
+	)
+	copyFile(t,
+		filepath.Join(sourceDir, "syz_mount_image_f2fs_0"),
+		filepath.Join(directory, "syz_mount_image_f2fs_duplicate"),
+	)
+	if err := os.WriteFile(
+		filepath.Join(directory, "unrelated"), []byte("getpid()\n"), 0o600,
+	); err != nil {
+		t.Fatal(err)
+	}
+
+	catalog, err := buildSeedCatalog(directory, target)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if catalog.Schema != catalogSchema || catalog.SchemaVersion != catalogSchemaVersion ||
+		catalog.Target.Revision != target.Revision || len(catalog.Entries) != 1 {
+		t.Fatalf("unexpected catalog: %+v", catalog)
+	}
+	entry := catalog.Entries[0]
+	if entry.Path != "syz_mount_image_f2fs_0" || entry.Provenance != imagegenProvenance ||
+		len(entry.NoGenerateCalls) != 1 ||
+		entry.NoGenerateCalls[0] != "syz_mount_image$f2fs" {
+		t.Fatalf("unexpected entry: %+v", entry)
+	}
+}
+
+func copyFile(t *testing.T, source, destination string) {
+	t.Helper()
+	data, err := os.ReadFile(source)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(destination, data, 0o600); err != nil {
+		t.Fatal(err)
+	}
+}
