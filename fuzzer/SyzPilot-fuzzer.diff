+package collector
+
+import (
+	"sync/atomic"
+	"time"
+
+	"github.com/google/syzkaller/pkg/stat"
+)
+
+// latencyUpperBoundsUS keeps callback-side telemetry allocation-free. The
+// exported quantiles are bucket upper bounds rather than exact observations;
+// -1 denotes the unbounded overflow bucket.
+var latencyUpperBoundsUS = [...]uint64{
+	50, 100, 250, 500,
+	1_000, 2_500, 5_000, 10_000,
+	25_000, 50_000, 100_000, 250_000,
+	500_000, 1_000_000,
+}
+
+type latencyBuckets struct {
+	counts [len(latencyUpperBoundsUS) + 1]atomic.Uint64
+	total  atomic.Uint64
+}
+
+func (buckets *latencyBuckets) observe(duration time.Duration) {
+	microseconds := uint64((duration + time.Microsecond - 1) / time.Microsecond)
+	index := len(latencyUpperBoundsUS)
+	for current, upperBound := range latencyUpperBoundsUS {
+		if microseconds <= upperBound {
+			index = current
+			break
+		}
+	}
+	buckets.counts[index].Add(1)
+	buckets.total.Add(1)
+}
+
+func (buckets *latencyBuckets) quantile(numerator, denominator uint64) int {
+	total := buckets.total.Load()
+	if total == 0 || numerator == 0 || denominator == 0 || numerator > denominator {
+		return 0
+	}
+	rank := (total*numerator + denominator - 1) / denominator
+	var cumulative uint64
+	for index := range buckets.counts {
+		cumulative += buckets.counts[index].Load()
+		if cumulative < rank {
+			continue
+		}
+		if index < len(latencyUpperBoundsUS) {
+			return int(latencyUpperBoundsUS[index])
+		}
+		return -1
+	}
+	return 0
+}
+
+type collectorTelemetryState struct {
+	addLatency          latencyBuckets
+	bufferLockWait      latencyBuckets
+	bufferPersist       latencyBuckets
+	addCalls            atomic.Uint64
+	acceptedSamples     atomic.Uint64
+	duplicateDrops      atomic.Uint64
+	balanceDrops        atomic.Uint64
+	persistDrops        atomic.Uint64
+	bufferWALBytes      atomic.Uint64
+	bufferWALWrites     atomic.Uint64
+	bufferWALFileSyncs  atomic.Uint64
+	bufferWALDirSyncs   atomic.Uint64
+	bufferWALFailures   atomic.Uint64
+	bufferWALSyncErrors atomic.Uint64
+}
+
+var collectorTelemetry collectorTelemetryState
+
+func telemetryInt(value *atomic.Uint64) func() int {
+	return func() int { return int(value.Load()) }
+}
+
+func init() {
+	stat.New("collector add calls", "Collector callbacks, including dropped samples",
+		telemetryInt(&collectorTelemetry.addCalls))
+	stat.New("collector add latency p50 us",
+		"Approximate Collector callback p50 bucket upper bound in microseconds (-1 means overflow)",
+		func() int { return collectorTelemetry.addLatency.quantile(50, 100) })
+	stat.New("collector add latency p95 us",
+		"Approximate Collector callback p95 bucket upper bound in microseconds (-1 means overflow)",
+		func() int { return collectorTelemetry.addLatency.quantile(95, 100) })
+	stat.New("collector buffer lock wait p95 us",
+		"Approximate buffer-lock wait p95 bucket upper bound in microseconds (-1 means overflow)",
+		func() int { return collectorTelemetry.bufferLockWait.quantile(95, 100) })
+	stat.New("collector buffer wal persist p95 us",
+		"Approximate buffer WAL p95 bucket upper bound in microseconds (-1 means overflow)",
+		func() int { return collectorTelemetry.bufferPersist.quantile(95, 100) })
+	stat.New("collector accepted samples", "Samples admitted to Collector state",
+		telemetryInt(&collectorTelemetry.acceptedSamples))
+	stat.New("collector duplicate drops", "Samples suppressed by the signature cache",
+		telemetryInt(&collectorTelemetry.duplicateDrops))
+	stat.New("collector balance drops", "Samples rejected by Collector balancing",
