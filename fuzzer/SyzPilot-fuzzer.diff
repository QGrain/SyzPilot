@@ -0,0 +1,274 @@
+// Copyright 2026 syzkaller project authors. All rights reserved.
+// Use of this source code is governed by Apache 2 LICENSE that can be found in the LICENSE file.
+
+package syzlangmanifest
+
+import (
+	"bytes"
+	"encoding/json"
+	"slices"
+	"testing"
+
+	"github.com/google/syzkaller/prog"
+	_ "github.com/google/syzkaller/sys"
+)
+
+func TestLinuxManifestKnownSyzPilotCalls(t *testing.T) {
+	target, err := prog.GetTarget("linux", "amd64")
+	if err != nil {
+		t.Fatal(err)
+	}
+	manifest, err := Build(target)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if manifest.SchemaVersion != SchemaVersion || manifest.Target.Revision != target.Revision {
+		t.Fatalf("manifest identity = %+v, schema=%d", manifest.Target, manifest.SchemaVersion)
+	}
+	if manifest.Schema != SchemaName {
+		t.Fatalf("manifest schema = %q, want %q", manifest.Schema, SchemaName)
+	}
+	seenFlagSets := make(map[string]bool)
+	for _, flags := range manifest.FlagSets {
+		if flags.Name == "_" || seenFlagSets[flags.Name] {
+			t.Fatalf("unstable or duplicate global flag-set name %q", flags.Name)
+		}
+		seenFlagSets[flags.Name] = true
+	}
+	byName := make(map[string]Syscall, len(manifest.Calls))
+	for _, call := range manifest.Calls {
+		byName[call.Name] = call
+	}
+
+	mount := byName["syz_mount_image$f2fs"]
+	if mount.DeliveryMode != DeliverySeedOnly || !mount.Attrs.NoGenerate {
+		t.Fatalf("f2fs mount delivery = %q attrs=%+v", mount.DeliveryMode, mount.Attrs)
+	}
+	if !slices.Contains(mount.DeclaredOutputs, "fd_dir") {
+		t.Fatalf("f2fs mount declared outputs = %v, want fd_dir", mount.DeclaredOutputs)
+	}
+	if containsDependencyConstructor(manifest.ResourceDependencies, "syz_mount_image$f2fs") {
+		t.Fatal("no-generate f2fs call was exposed as a random resource constructor")
+	}
+	if !containsString(mount.FixedStrings, "f2fs\x00") {
+		t.Fatal("f2fs mount strings do not contain the exact NUL-terminated filesystem name")
+	}
+
+	for _, name := range []string{
+		"bpf$BPF_RAW_TRACEPOINT_OPEN",
+		"sendmsg$NL80211_CMD_CONNECT",
+		"ioctl$KVM_SET_VCPU_EVENTS",
+	} {
+		call, ok := byName[name]
+		if !ok {
+			t.Fatalf("compiled call %q is absent", name)
+		}
+		if call.DeliveryMode != DeliveryGeneratable {
+			t.Fatalf("call %q delivery = %q", name, call.DeliveryMode)
+		}
+	}
+
+	bpf := byName["bpf$BPF_RAW_TRACEPOINT_OPEN"]
+	if !containsRequirement(bpf.RequiredResources, manifest.ResourceDependencies,
+		"fd_bpf_prog_raw_tracepoint", "bpf$BPF_PROG_RAW_TRACEPOINT_LOAD") {
+		t.Fatalf("BPF requirements = %+v", bpf.RequiredResources)
+	}
+	nl80211 := byName["sendmsg$NL80211_CMD_CONNECT"]
+	if !containsRequirement(nl80211.RequiredResources, manifest.ResourceDependencies,
+		"sock_nl_generic", "socket$nl_generic") {
+		t.Fatalf("NL80211 requirements = %+v", nl80211.RequiredResources)
+	}
+	wantNL80211 := hexValue(target.ConstMap["NL80211_CMD_CONNECT"])
+	if !containsNumeric(nl80211.Constants, wantNL80211) {
+		t.Fatalf("NL80211 constants = %+v, want %s", nl80211.Constants, wantNL80211)
+	}
+
+	kvm := byName["ioctl$KVM_SET_VCPU_EVENTS"]
+	wantKVM := hexValue(target.ConstMap["KVM_SET_VCPU_EVENTS"])
+	if !containsNumeric(kvm.Constants, wantKVM) {
+		t.Fatalf("KVM call constants = %+v, want %s", kvm.Constants, wantKVM)
+	}
+	if !containsRequirement(kvm.RequiredResources, manifest.ResourceDependencies,
+		"fd_kvmcpu", "ioctl$KVM_CREATE_VCPU") {
+		t.Fatalf("KVM requirements = %+v", kvm.RequiredResources)
+	}
+
+	f2fsIOCTL := byName["ioctl$F2FS_IOC_SEC_TRIM_FILE"]
+	if f2fsIOCTL.DeliveryMode != DeliveryGeneratable {
+		t.Fatalf("F2FS ioctl delivery = %q", f2fsIOCTL.DeliveryMode)
+	}
+	wantF2FSIOCTL := hexValue(target.ConstMap["F2FS_IOC_SEC_TRIM_FILE"])
+	if !containsNumeric(f2fsIOCTL.Constants, wantF2FSIOCTL) {
+		t.Fatalf("F2FS ioctl constants = %+v, want %s", f2fsIOCTL.Constants, wantF2FSIOCTL)
+	}
+
+	framebuffer := byName["ioctl$FBIOPUT_VSCREENINFO"]
+	wantFramebuffer := hexValue(target.ConstMap["FBIOPUT_VSCREENINFO"])
+	if !containsFixedArgument(framebuffer.FixedArguments, 1, wantFramebuffer) {
+		t.Fatalf("framebuffer fixed args = %+v, want arg 1 = %s",
+			framebuffer.FixedArguments, wantFramebuffer)
+	}
+}
+
+func TestManifestMarshalIsDeterministic(t *testing.T) {
+	target, err := prog.GetTarget("test", "64")
+	if err != nil {
+		t.Fatal(err)
+	}
+	first, err := Marshal(target)
+	if err != nil {
+		t.Fatal(err)
+	}
+	second, err := Marshal(target)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(first, second) {
+		t.Fatal("manifest serialization is not deterministic")
+	}
+}
+
+func TestLinuxManifestArrayFieldsAreNeverNull(t *testing.T) {
+	target, err := prog.GetTarget("linux", "amd64")
+	if err != nil {
+		t.Fatal(err)
+	}
+	data, err := Marshal(target)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var document map[string]any
+	if err := json.Unmarshal(data, &document); err != nil {
+		t.Fatal(err)
+	}
+	for index, rawCall := range document["calls"].([]any) {
+		call := rawCall.(map[string]any)
+		for _, field := range []string{
+			"required_resources", "declared_output_resources",
+			"fixed_arguments", "constants", "flags", "fixed_strings",
+		} {
+			if call[field] == nil {
+				t.Fatalf("calls[%d].%s is null", index, field)
+			}
+		}
+	}
+	for index, rawDependency := range document["resource_dependencies"].([]any) {
+		dependency := rawDependency.(map[string]any)
+		if dependency["precise_constructors"] == nil {
+			t.Fatalf("resource_dependencies[%d].precise_constructors is null", index)
+		}
+	}
+	for setIndex, rawSet := range document["flag_sets"].([]any) {
+		set := rawSet.(map[string]any)
+		if set["symbols"] == nil {
+			t.Fatalf("flag_sets[%d].symbols is null", setIndex)
+		}
+		for symbolIndex, rawSymbol := range set["symbols"].([]any) {
+			symbol := rawSymbol.(map[string]any)
+			if symbol["values"] == nil {
+				t.Fatalf("flag_sets[%d].symbols[%d].values is null",
+					setIndex, symbolIndex)
+			}
+		}
+	}
+}
+
+func TestResolvedFlagValuesUseNumericOrder(t *testing.T) {
+	target := &prog.Target{
+		ConstMap: map[string]uint64{"FOUR": 4, "SIXTEEN": 16, "LARGE": 0x2000},
+		FlagsMap: map[string][]string{
+			"mixed": {"LARGE", "FOUR", "SIXTEEN"},
+		},
+	}
+	values, err := resolveValues(target, "mixed", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got := make([]string, 0, len(values))
+	for _, value := range values {
+		got = append(got, hexValue(value))
+	}
+	want := []string{"0x4", "0x10", "0x2000"}
+	if !slices.Equal(got, want) {
+		t.Fatalf("resolved values = %v, want numeric order %v", got, want)
+	}
+}
+
+func TestDeliveryModePrecedence(t *testing.T) {
+	tests := []struct {
+		attrs prog.SyscallAttrs
+		want  string
+	}{
+		{prog.SyscallAttrs{}, DeliveryGeneratable},
+		{prog.SyscallAttrs{NoGenerate: true}, DeliverySeedOnly},
+		{prog.SyscallAttrs{Disabled: true, NoGenerate: true}, DeliveryDisabled},
+		{prog.SyscallAttrs{NoGenerate: true, AutomaticHelper: true}, DeliverySeedOnly},
+		{prog.SyscallAttrs{Automatic: true}, DeliveryGeneratable},
+		{prog.SyscallAttrs{Disabled: true, Automatic: true}, DeliveryDisabled},
+	}
+	for _, test := range tests {
+		call := &prog.Syscall{Attrs: test.attrs}
+		if got := deliveryMode(call); got != test.want {
+			t.Fatalf("attrs=%+v delivery=%q, want %q", test.attrs, got, test.want)
+		}
+	}
+}
+
+func TestResolveEmptyFlagValue(t *testing.T) {
+	value, err := resolveValue(&prog.Target{}, "")
+	if err != nil || value != 0 {
+		t.Fatalf("empty flag value = %#x, %v; want 0, nil", value, err)
+	}
+}
+
+func containsNumeric(signatures []NumericTypeSignature, expected string) bool {
+	for _, signature := range signatures {
+		if slices.Contains(signature.Values, expected) {
+			return true
+		}
+	}
+	return false
+}
+
+func containsFixedArgument(arguments []FixedArgument, index int, value string) bool {
+	for _, argument := range arguments {
+		if argument.Index == index && argument.Value == value {
+			return true
+		}
+	}
+	return false
+}
+
+func containsString(signatures []StringTypeSignature, expected string) bool {
+	for _, signature := range signatures {
+		for _, value := range signature.Values {
+			if value.Text == expected {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func containsRequirement(requirements []string, dependencies []ResourceDependency,
+	resource, constructor string) bool {
+	if !slices.Contains(requirements, resource) {
+		return false
+	}
+	for _, dependency := range dependencies {
+		if dependency.Name == resource &&
+			slices.Contains(dependency.PreciseConstructors, constructor) {
+			return true
+		}
+	}
+	return false
+}
+
+func containsDependencyConstructor(dependencies []ResourceDependency, constructor string) bool {
+	for _, dependency := range dependencies {
+		if slices.Contains(dependency.PreciseConstructors, constructor) {
+			return true
+		}
+	}
+	return false
+}
