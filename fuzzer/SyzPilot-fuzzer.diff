diff --git a/pkg/syzpilotlib/lib.go b/pkg/syzpilotlib/lib.go
new file mode 100644
index 0000000..6e5fe11
--- /dev/null
+++ b/pkg/syzpilotlib/lib.go
@@ -0,0 +1,235 @@
+package syzpilotlib
+
+import (
+	"fmt"
+	"math/rand"
+	"net"
+	"strconv"
+	"time"
+
+	"github.com/google/syzkaller/pkg/debuglogger"
+)
+
+type SyzPilotRuntimeConfig struct {
+	// task ID assigned by the brain controller
+	TaskID string
+	// ip:port of gRPC server for data collection
+	ReceiverAddr string
+	// ip:port of torchserve server for model inference
+	TSServerAddr string
+	// model name in torchserve
+	ModelName string
+	// model version in torchserve
+	ModelVersion string
+}
+
+func SliceToMap(s []string) map[string]struct{} {
+	m := map[string]struct{}{}
+
+	for _, v := range s {
+		m[v] = struct{}{}
+	}
+
+	return m
+}
+
+// Validate target addresses read from mgrconfig and convert to address strings and uint64 values.
+func ValidateTargetAddrs(targetAddrs []string) (addrStrs []string, addrVals []uint64, err error) {
+	const high32 uint64 = 0xffffffff00000000
+	const low32 uint64 = 0x00000000ffffffff
+
+	addrStrs = make([]string, 0, len(targetAddrs))
+	addrVals = make([]uint64, 0, len(targetAddrs))
+	seen := make(map[uint64]struct{}, len(targetAddrs))
+	err = nil
+
+	if len(targetAddrs) == 0 {
+		err = fmt.Errorf("targetAddrs is empty")
+		return
+	}
+
+	for i, addrStr := range targetAddrs {
+		// parse string to uint64, support 0x prefix
+		addr, parseErr := strconv.ParseUint(addrStr, 0, 64)
+		if parseErr != nil {
+			err = fmt.Errorf("invalid address at index %d (%s): %v", i, addrStr, parseErr)
+			return
+		}
+
+		// lower 32 bits
+		low := addr & low32
+		// generate string (32-bit format without ffffffff prefix)
+		addrStrs = append(addrStrs, fmt.Sprintf("0x%08x", low))
+		// standardize to high 32 bits all 0xffffffff
+		standard := high32 | low
+		if _, exists := seen[standard]; exists {
+			err = fmt.Errorf("duplicate target address at index %d: %s", i, addrStr)
+			return
+		}
+		seen[standard] = struct{}{}
+		addrVals = append(addrVals, standard)
+	}
+	debuglogger.Log(true, "[syzpilotlib] addrStrs: %v, addrVals: %v", addrStrs, addrVals)
+	return
+}
+
+func ProbN(N int) bool {
+	if N < 0 || N > 100 {
+		panic(fmt.Sprintf("invalid value of N: %d, N must be in the range [0, 100]", N))
+	}
+	rand.New(rand.NewSource(time.Now().UnixNano()))
+	randomNumber := rand.Intn(100)
+	return randomNumber < N
+}
+
+// ParseIPPort: parse the IP and port from a string in the format of "ip:port".
+func ParseIPPort(ipPort string) (string, string, error) {
+	ip, port, err := net.SplitHostPort(ipPort)
+	if err != nil {
+		return "", "", err
+	}
+	return ip, port, err
+}
+
+func TransferDeepestLabels(labels []bool) []bool {
+	oneHotLabels := make([]bool, len(labels))
+	// traverse the labels from the end to the beginning, if the first true is encountered,
+	// set oneHotLabels[i] to true and break, finally return oneHotLabels
+	for i := len(labels) - 1; i >= 0; i-- {
+		if labels[i] {
+			oneHotLabels[i] = true
+			break
+		}
+	}
+	return oneHotLabels
+}
+
+// NormalizeReachabilityLabel validates a cumulative reachability label and
+// converts it to exactly-one-hot form. Unreachable must be encoded only as
+// class 0; it is invalid for class 0 and a reached class to be set together.
+func NormalizeReachabilityLabel(labels []bool) ([]bool, bool) {
+	if len(labels) == 0 {
+		return nil, false
+	}
+	if labels[0] {
+		for _, reached := range labels[1:] {
+			if reached {
+				return nil, false
+			}
+		}
+		oneHotLabels := make([]bool, len(labels))
+		oneHotLabels[0] = true
+		return oneHotLabels, true
+	}
+
+	oneHotLabels := TransferDeepestLabels(labels)
+	if _, valid := OneHotLabelClass(oneHotLabels); !valid {
+		return nil, false
+	}
+	return oneHotLabels, true
+}
+
+// OneHotLabelClass returns the selected class for an exactly-one-hot label.
+// Class 0 is the explicit Unreachable class and classes 1..N are reached
+// waypoints. Invalid all-zero and multi-hot labels are rejected.
+func OneHotLabelClass(labels []bool) (int, bool) {
+	class := -1
+	for i, label := range labels {
+		if !label {
+			continue
+		}
+		if class >= 0 {
+			return -1, false
+		}
+		class = i
+	}
+	return class, class >= 0
+}
+
+// IsPositiveLabel reports whether labels encode a valid reached class.
+// Unreachable (class 0) is a negative sample, not a positive sample.
+func IsPositiveLabel(labels []bool) bool {
+	class, valid := OneHotLabelClass(labels)
+	return valid && class > 0
+}
+
+// GuidancePayload is the JSON payload sent by Brain via POST /guidance.
+type GuidancePayload struct {
+	Version           int                `json:"version"`
+	Timestamp         string             `json:"timestamp"`
+	SyscallWeights    map[string]float64 `json:"syscall_weights"`
+	MutationTemplates []MutationTemplate `json:"mutation_templates"`
+	GenerationHints   GenerationHints    `json:"generation_hints"`
+}
+
+// GuidanceApplyResult describes whether guidance is pending or active and the
+// exact subset accepted for generation and mutation once active.
+type GuidanceApplyResult struct {
+	Status            string `json:"status"`
+	Version           int    `json:"version"`
+	AcceptedWeights   int    `json:"accepted_weights"`
+	RejectedWeights   int    `json:"rejected_weights"`
+	AcceptedTemplates int    `json:"accepted_templates"`
+	RejectedTemplates int    `json:"rejected_templates"`
+	// AcceptedSeeds preserves the original protocol meaning: trusted seed
+	// candidates newly appended for this guidance version.
+	AcceptedSeeds int `json:"accepted_seeds"`
+	// NativeSeeds were also observed in Syzkaller's unmodified candidate flow.
+	// They are still appended once on first matching guidance because a native
+	// candidate may already have executed and disappeared before guidance arrives.
+	NativeSeeds int `json:"native_seeds"`
+	// InjectedSeeds were newly appended by SyzPilot for this guidance version.
+	InjectedSeeds int `json:"injected_seeds"`
+	// ReusedSeeds were already appended during this fuzzer lifetime.
+	ReusedSeeds   int `json:"reused_seeds"`
+	RejectedSeeds int `json:"rejected_seeds"`
+}
+
+// CloneGuidancePayload returns a deep copy suitable for retaining after an
+// HTTP callback returns.
+func CloneGuidancePayload(source *GuidancePayload) *GuidancePayload {
+	if source == nil {
+		return nil
+	}
+	clone := *source
+	clone.SyscallWeights = make(map[string]float64, len(source.SyscallWeights))
+	for name, weight := range source.SyscallWeights {
+		clone.SyscallWeights[name] = weight
+	}
+	clone.MutationTemplates = make([]MutationTemplate, len(source.MutationTemplates))
+	for index, template := range source.MutationTemplates {
+		clone.MutationTemplates[index] = template
+		clone.MutationTemplates[index].Syscalls = append(
+			[]string(nil), template.Syscalls...,
+		)
+		clone.MutationTemplates[index].ArgHints = append(
+			[]ArgConstraint(nil), template.ArgHints...,
+		)
+	}
+	clone.GenerationHints.PreferredSyscalls = append(
+		[]string(nil), source.GenerationHints.PreferredSyscalls...,
+	)
+	return &clone
+}
+
+// ArgConstraint specifies a fixed value for a specific argument of a syscall.
+type ArgConstraint struct {
+	Syscall string `json:"syscall"` // syscall name (e.g., "socket$packet")
+	ArgIdx  int    `json:"arg_idx"` // 0-based argument index
+	Value   uint64 `json:"value"`   // fixed value to set
+}
+
+// MutationTemplate describes a sequence of syscalls to use as a mutation template.
+type MutationTemplate struct {
+	Type       string          `json:"type"` // "sequence", "prefix", "splice"
+	Syscalls   []string        `json:"syscalls"`
+	Priority   float64         `json:"priority"`
+	InsertMode string          `json:"insert_mode"`         // "prefix", "suffix", "replace"
+	ArgHints   []ArgConstraint `json:"arg_hints,omitempty"` // argument constraints for template syscalls
+}
+
+// GenerationHints provides hints for program generation.
+type GenerationHints struct {
+	PreferredSyscalls []string `json:"preferred_syscalls"`
+	PreferredRatio    float64  `json:"preferred_ratio"`
+}
