+package manager
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+type roundTripperFunc func(*http.Request) (*http.Response, error)
+
+func (fn roundTripperFunc) RoundTrip(request *http.Request) (*http.Response, error) {
+	return fn(request)
+}
+
+func TestControlHTTPClientDoesNotInheritEnvironmentProxy(t *testing.T) {
+	t.Setenv("HTTP_PROXY", "http://proxy.invalid:3128")
+	t.Setenv("HTTPS_PROXY", "http://proxy.invalid:3128")
+
+	client := newControlHTTPClient()
+	transport, ok := client.Transport.(*http.Transport)
+	if !ok {
+		t.Fatalf("transport type = %T, want *http.Transport", client.Transport)
+	}
+	if transport == http.DefaultTransport {
+		t.Fatal("control client reused the global default transport")
+	}
+	if transport.Proxy != nil {
+		t.Fatal("control client still honors ambient proxy settings")
+	}
+	defaultTransport, ok := http.DefaultTransport.(*http.Transport)
+	if !ok {
+		t.Fatalf("default transport type = %T, want *http.Transport", http.DefaultTransport)
+	}
+	if defaultTransport.Proxy == nil {
+		t.Fatal("control client mutated the global default transport")
+	}
+	if client.Timeout != defaultRequestTimeout {
+		t.Fatalf("timeout = %s, want %s", client.Timeout, defaultRequestTimeout)
+	}
+}
+
+func TestControlHTTPClientHandlesCustomDefaultTransport(t *testing.T) {
+	previous := http.DefaultTransport
+	custom := roundTripperFunc(func(*http.Request) (*http.Response, error) {
+		return nil, nil
+	})
+	http.DefaultTransport = custom
+	t.Cleanup(func() {
+		http.DefaultTransport = previous
+	})
+
+	client := newControlHTTPClient()
+	transport, ok := client.Transport.(*http.Transport)
+	if !ok {
+		t.Fatalf("transport type = %T, want *http.Transport", client.Transport)
+	}
+	if transport.Proxy != nil {
+		t.Fatal("fallback control transport honors ambient proxy settings")
+	}
+}
+
+func TestRegisterForwardsGuidanceContext(t *testing.T) {
+	var payload RegistrationPayload
+	server := httptest.NewServer(http.HandlerFunc(func(
+		writer http.ResponseWriter, request *http.Request,
+	) {
+		if request.URL.Path != "/register" {
+			t.Errorf("path = %q, want /register", request.URL.Path)
+		}
+		if err := json.NewDecoder(request.Body).Decode(&payload); err != nil {
+			t.Errorf("decode registration payload: %v", err)
+			http.Error(writer, "invalid payload", http.StatusBadRequest)
+			return
+		}
+		writer.Header().Set("Content-Type", "application/json")
+		_, _ = writer.Write([]byte(`{
+			"task_id":"fuzzer@task@1",
+			"receiver_port":31001,
+			"torchserve_port":37033,
+			"model_name":"",
+			"model_version":"1.0"
+		}`))
+	}))
+	defer server.Close()
+
+	client := &Client{
+		Config: Config{
+			NetworkMode:  "direct",
+			ServerAddr:   strings.TrimPrefix(server.URL, "http://"),
+			HostIP:       "127.0.0.1",
+			HostHttpPort: 39325,
+			TargetFunc:   "f2fs_is_valid_blkaddr",
+			ReportPath:   "/brain/configs/case_25.report",
+			KallgraphDir: "/brain/kallgraph/case_25",
+			TargetOS:     "linux", TargetArch: "amd64",
+			TargetRevision: "target-r1", ProducerRevision: "fuzzer-r1",
+			DescriptionsMode: "manual",
+		},
+		FuzzerID:   "fuzzer",
+		httpClient: server.Client(),
+	}
+
+	if _, err := client.Register(context.Background(), "task"); err != nil {
+		t.Fatalf("register: %v", err)
+	}
+	if payload.TargetFunc != client.Config.TargetFunc ||
+		payload.ReportPath != client.Config.ReportPath ||
+		payload.KallgraphDir != client.Config.KallgraphDir ||
+		payload.TargetOS != client.Config.TargetOS ||
+		payload.TargetArch != client.Config.TargetArch ||
+		payload.TargetRevision != client.Config.TargetRevision ||
+		payload.ProducerRevision != client.Config.ProducerRevision ||
+		payload.DescriptionsMode != client.Config.DescriptionsMode {
+		t.Fatalf("guidance context not forwarded: %#v", payload)
+	}
+}
+
+func newUnregisterTestClient(t *testing.T, handler http.HandlerFunc) (*Client, func()) {
+	t.Helper()
+	server := httptest.NewServer(handler)
+	client := &Client{
+		Config:     Config{ServerAddr: strings.TrimPrefix(server.URL, "http://")},
+		httpClient: server.Client(),
+		taskID:     "fuzzer@task name@1",
+	}
+	return client, server.Close
+}
+
+func TestCloseUnregistersTaskExactlyOnce(t *testing.T) {
+	var requests atomic.Int32
+	client, cleanup := newUnregisterTestClient(t, func(
+		writer http.ResponseWriter, request *http.Request,
+	) {
+		requests.Add(1)
+		if request.Method != http.MethodPost {
+			t.Errorf("method = %s, want POST", request.Method)
+		}
+		if request.URL.Path != "/unregister/fuzzer@task name@1" {
+			t.Errorf("path = %q", request.URL.Path)
+		}
+		writer.WriteHeader(http.StatusOK)
+	})
+	defer cleanup()
+
+	client.Close()
+	client.Close()
+	if got := requests.Load(); got != 1 {
+		t.Fatalf("unregister requests = %d, want 1", got)
+	}
+}
+
+func TestFailedUnregisterCanBeRetried(t *testing.T) {
+	var requests atomic.Int32
+	client, cleanup := newUnregisterTestClient(t, func(
+		writer http.ResponseWriter, request *http.Request,
+	) {
+		if requests.Add(1) == 1 {
+			writer.WriteHeader(http.StatusInternalServerError)
+			return
+		}
+		writer.WriteHeader(http.StatusNotFound)
+	})
+	defer cleanup()
+
+	if err := client.unregister(context.Background()); err == nil {
+		t.Fatal("first unregister succeeded despite server failure")
+	}
+	if err := client.unregister(context.Background()); err != nil {
+		t.Fatalf("retry unregister failed: %v", err)
+	}
+	if got := requests.Load(); got != 2 {
+		t.Fatalf("unregister requests = %d, want 2", got)
+	}
+}
+
+func TestCloseRetriesIncompleteBrainCleanup(t *testing.T) {
+	var requests atomic.Int32
+	client, cleanup := newUnregisterTestClient(t, func(
+		writer http.ResponseWriter, _ *http.Request,
+	) {
+		if requests.Add(1) == 1 {
+			writer.WriteHeader(http.StatusServiceUnavailable)
+			return
+		}
+		writer.WriteHeader(http.StatusOK)
+	})
+	defer cleanup()
+
+	client.Close()
+	if got := requests.Load(); got != 2 {
+		t.Fatalf("unregister requests = %d, want 2", got)
+	}
+	client.mu.Lock()
+	remainingTask := client.taskID
+	client.mu.Unlock()
+	if remainingTask != "" {
+		t.Fatalf("task ID not cleared after successful cleanup: %q", remainingTask)
+	}
+}
+
+func TestUnregisterRetryStopsOnPermanentError(t *testing.T) {
+	var requests atomic.Int32
+	client, cleanup := newUnregisterTestClient(t, func(
+		writer http.ResponseWriter, _ *http.Request,
+	) {
+		requests.Add(1)
+		writer.WriteHeader(http.StatusBadRequest)
+	})
+	defer cleanup()
+
+	if err := client.unregisterWithRetry(context.Background(), time.Millisecond); err == nil {
+		t.Fatal("permanent Brain error unexpectedly accepted")
+	}
+	if got := requests.Load(); got != 1 {
+		t.Fatalf("unregister requests = %d, want 1", got)
+	}
+}
+
+func TestUnregisterRetryAcceptsCompletedPreviousRequest(t *testing.T) {
+	var requests atomic.Int32
+	client, cleanup := newUnregisterTestClient(t, func(
+		writer http.ResponseWriter, _ *http.Request,
+	) {
+		if requests.Add(1) == 1 {
+			writer.WriteHeader(http.StatusServiceUnavailable)
+			return
+		}
+		writer.WriteHeader(http.StatusNotFound)
+	})
+	defer cleanup()
+
+	if err := client.unregisterWithRetry(context.Background(), time.Millisecond); err != nil {
+		t.Fatalf("completed Brain cleanup should be idempotent: %v", err)
+	}
+	if got := requests.Load(); got != 2 {
+		t.Fatalf("unregister requests = %d, want 2", got)
+	}
+}
