+// Use of this source code is governed by Apache 2 LICENSE that can be found in the LICENSE file.
+
+package prog
+
+import "sort"
+
+// SyzPilotResourceDependency describes one currently unsatisfied input
+// resource and the precise calls that can construct it. Returned slices are
+// copies and must be treated as read-only metadata.
+type SyzPilotResourceDependency struct {
+	Name         string
+	Constructors []*Syscall
+}
+
+// SyzPilotMissingResourceDependencies exposes the same resource model used by
+// TransitivelyEnabledCalls without duplicating its compatibility rules in the
+// SyzPilot manager extension.
+func (target *Target) SyzPilotMissingResourceDependencies(
+	enabled map[*Syscall]bool, call *Syscall,
+) []SyzPilotResourceDependency {
+	_, canCreate := target.transitivelyEnabled(enabled)
+	var dependencies []SyzPilotResourceDependency
+	for _, resource := range call.inputResources {
+		if canCreate[resource.Name] {
+			continue
+		}
+		seen := make(map[int]bool)
+		var constructors []*Syscall
+		for _, constructor := range target.calcResourceCtors(resource, true) {
+			if seen[constructor.Call.ID] {
+				continue
+			}
+			seen[constructor.Call.ID] = true
+			constructors = append(constructors, constructor.Call)
+		}
+		sort.Slice(constructors, func(i, j int) bool {
+			if constructors[i].Name != constructors[j].Name {
+				return constructors[i].Name < constructors[j].Name
+			}
+			return constructors[i].ID < constructors[j].ID
+		})
+		dependencies = append(dependencies, SyzPilotResourceDependency{
+			Name: resource.Name, Constructors: constructors,
+		})
+	}
+	sort.Slice(dependencies, func(i, j int) bool {
+		return dependencies[i].Name < dependencies[j].Name
+	})
+	return dependencies
+}
