+func (serv *HTTPServer) httpDump(w http.ResponseWriter, r *http.Request) {
+	op := r.URL.Query().Get("op")
+	fuzzerObj := serv.Fuzzer.Load()
+	if fuzzerObj == nil {
+		http.Error(w, "fuzzer not initialized", http.StatusInternalServerError)
+		return
+	}
+	cfg := fuzzerObj.Config
+
+	switch op {
+	case "start":
+		if cfg.SyzPilotCfg.EnableDump {
+			msg := "[SyzPilot] dump is already enabled, no need to enable it again"
+			log.Logf(0, msg)
+			fmt.Fprintln(w, msg)
+			return
+		}
+		cfg.SyzPilotCfg.EnableDump = true
+		if cfg.SyzPilotCfg.DumpDir == "" {
+			cfg.SyzPilotCfg.DumpDir = filepath.Join(serv.Cfg.Workdir, "dump")
+		}
+		osutil.MkdirAll(filepath.Join(cfg.SyzPilotCfg.DumpDir, "programs"))
+		osutil.MkdirAll(filepath.Join(cfg.SyzPilotCfg.DumpDir, "coverage"))
+		msg := fmt.Sprintf("[SyzPilot] dump is enabled (runtime), DumpDir=%s", cfg.SyzPilotCfg.DumpDir)
+		log.Logf(0, msg)
+		debuglogger.Log(false, msg)
+		fmt.Fprintln(w, msg)
+		return
+
+	case "stop":
+		if !cfg.SyzPilotCfg.EnableDump {
+			msg := "[SyzPilot] dump is already disabled, no need to disable it again"
+			log.Logf(0, msg)
+			fmt.Fprintln(w, msg)
+			return
+		}
+		cfg.SyzPilotCfg.EnableDump = false
+		msg := "[SyzPilot] dump is disabled (runtime)"
+		log.Logf(0, msg)
+		debuglogger.Log(false, msg)
+		fmt.Fprintln(w, msg)
+		return
+
+	case "status", "":
+		// show status when no op parameter is provided
+		status := "disabled"
+		if cfg.SyzPilotCfg.EnableDump {
+			status = "enabled"
+		}
+		dumpDir := cfg.SyzPilotCfg.DumpDir
+		if dumpDir == "" {
+			dumpDir = "not set"
+		}
+		dumpTotal := stat.GetValByName("dump total")
+		dirExists := "unknown"
+		if dumpDir != "not set" {
+			if _, err := os.Stat(dumpDir); err == nil {
+				dirExists = "exists"
+			} else {
+				dirExists = "not exists"
+			}
+		}
+		queryTime := time.Now().Format("2006-01-02 15:04:05")
+		if r.FormValue("json") == "1" {
+			w.Header().Set("Content-Type", "application/json")
+			json.NewEncoder(w).Encode(map[string]interface{}{
+				"status":     status,
+				"dump_dir":   dumpDir,
+				"dump_total": dumpTotal,
+				"dir_exists": dirExists,
+				"query_time": queryTime,
+			})
+		} else {
+			w.Header().Set("Content-Type", "text/plain; charset=utf-8")
+			fmt.Fprintf(w, "Dump Status:\n")
+			fmt.Fprintf(w, "  Status: %s\n", status)
+			fmt.Fprintf(w, "  Dump Directory: %s\n", dumpDir)
+			fmt.Fprintf(w, "  Dump Total: %d\n", dumpTotal)
+			fmt.Fprintf(w, "  Directory Exists: %s\n", dirExists)
+			fmt.Fprintf(w, "  Query Time: %s\n", queryTime)
+		}
+		return
+
+	default:
+		http.Error(w, "unknown op for /dump, must be one of: start, stop, status", http.StatusBadRequest)
+		return
+	}
+}
