+	recorder.mu.Lock()
+	defer recorder.mu.Unlock()
+	if len(recorder.outcomes) == 0 {
+		t.Fatal("template mutation observer received no outcome")
+	}
+	return recorder.outcomes[len(recorder.outcomes)-1]
+}
