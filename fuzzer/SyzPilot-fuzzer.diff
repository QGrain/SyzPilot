+
+type fakeTrainingStream struct {
+	mu        sync.Mutex
+	sent      []*pb.TrainingBatch
+	responses []*pb.BatchResponse
+	recvErr   error
+	closed    bool
+}
+
+func (stream *fakeTrainingStream) Send(batch *pb.TrainingBatch) error {
+	stream.mu.Lock()
+	defer stream.mu.Unlock()
+	stream.sent = append(stream.sent, batch)
+	return nil
+}
+
+func (stream *fakeTrainingStream) Recv() (*pb.BatchResponse, error) {
+	stream.mu.Lock()
+	defer stream.mu.Unlock()
+	if stream.recvErr != nil {
+		return nil, stream.recvErr
+	}
+	if len(stream.responses) > 0 {
+		response := stream.responses[0]
+		stream.responses = stream.responses[1:]
+		return response, nil
+	}
+	if len(stream.sent) == 0 {
+		return nil, fmt.Errorf("no sent batch")
+	}
+	batch := stream.sent[len(stream.sent)-1]
+	return &pb.BatchResponse{
+		BatchId:          batch.BatchId,
+		Status:           "success",
+		ProcessedSamples: uint32(len(batch.Examples)),
+	}, nil
+}
+
+func (stream *fakeTrainingStream) CloseSend() error {
+	stream.mu.Lock()
+	stream.closed = true
+	stream.mu.Unlock()
+	return nil
+}
+
+func (stream *fakeTrainingStream) sentCount() int {
+	stream.mu.Lock()
+	defer stream.mu.Unlock()
+	return len(stream.sent)
+}
+
+func (stream *fakeTrainingStream) isClosed() bool {
+	stream.mu.Lock()
+	defer stream.mu.Unlock()
+	return stream.closed
+}
+
+type blockingTrainingStream struct {
+	ctx    context.Context
+	closed atomic.Bool
+}
+
+func (stream *blockingTrainingStream) Send(batch *pb.TrainingBatch) error {
+	return nil
+}
+
+func (stream *blockingTrainingStream) Recv() (*pb.BatchResponse, error) {
+	<-stream.ctx.Done()
+	return nil, stream.ctx.Err()
+}
+
+func (stream *blockingTrainingStream) CloseSend() error {
+	stream.closed.Store(true)
+	return nil
+}
+
+func newTestCollector(t *testing.T, stream trainingStream, bufferSize int) *MLDataCollector {
+	t.Helper()
+	ctx, cancel := context.WithCancel(context.Background())
+	collector := &MLDataCollector{
+		buffer:              make([]*pb.TrainingExample, 0, bufferSize),
+		bufferSize:          bufferSize,
+		bufferWALCheckpoint: 1,
+		flushInterval:       time.Hour,
+		ackTimeout:          100 * time.Millisecond,
+		closeTimeout:        time.Second,
+		retryInterval:       time.Hour,
+		lastFlush:           time.Now(),
+		spoolDir:            t.TempDir(),
+		ctx:                 ctx,
+		cancel:              cancel,
+		wakeSender:          make(chan struct{}, 1),
+		closeDone:           make(chan struct{}),
+		closeFinished:       make(chan struct{}),
+		balancer:            NewSampleBalancer(),
+		signatures:          newSignatureCache(65536),
+		streamFactory: func(context.Context) (trainingStream, error) {
+			return stream, nil
+		},
+	}
+	atomic.StoreInt64(&collector.stats.LastPositiveUnixNano, time.Now().UnixNano())
+	go collector.senderLoop()
+	return collector
+}
+
+func trainingExample(signature string) *pb.TrainingExample {
+	return &pb.TrainingExample{
+		ProgData:     []byte("test()"),
+		ProgSig:      signature,
+		TargetLabels: []bool{false, true},
+	}
+}
+
+func waitFor(t *testing.T, predicate func() bool) {
+	t.Helper()
+	deadline := time.Now().Add(2 * time.Second)
+	for !predicate() {
+		if time.Now().After(deadline) {
+			t.Fatal("condition was not met before deadline")
+		}
+		time.Sleep(time.Millisecond)
+	}
+}
+
+func TestFlushCommitsOnlyAfterMatchingSuccessAck(t *testing.T) {
+	stream := &fakeTrainingStream{}
+	collector := newTestCollector(t, stream, 10)
+	collector.buffer = append(collector.buffer, trainingExample("one"))
+
+	if err := collector.flushBuffer(); err != nil {
+		t.Fatalf("flushBuffer() failed: %v", err)
+	}
+	waitFor(t, func() bool {
+		return collector.pendingCount() == 0 &&
+			atomic.LoadInt64(&collector.stats.SentBatches) == 1
+	})
+	if stream.sentCount() != 1 {
+		t.Fatalf("sent batches = %d, want 1", stream.sentCount())
+	}
+	if err := collector.Close(); err != nil {
+		t.Fatalf("Close() failed: %v", err)
+	}
+}
+
+func TestNonTerminalResponseStatusRetainsSameIDForRetry(t *testing.T) {
+	tests := []struct {
+		name      string
+		status    string
+		processed uint32
+	}{
+		{name: "retry", status: "retry"},
+		{name: "legacy-error", status: "error"},
+		{name: "unknown", status: "future-status"},
+		{name: "rejected-with-progress", status: "rejected", processed: 1},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			stream := &fakeTrainingStream{responses: []*pb.BatchResponse{
+				{BatchId: 1, Status: test.status, Message: "not committed",
+					ProcessedSamples: test.processed},
+				{BatchId: 1, Status: "success", ProcessedSamples: 1},
+			}}
+			collector := newTestCollector(t, stream, 10)
+			collector.buffer = append(collector.buffer, trainingExample("one"))
+			collector.updateStats(collector.buffer[0].TargetLabels)
+			collector.signatures.record("one", 1)
+			if err := collector.flushBuffer(); err != nil {
+				t.Fatalf("flushBuffer() failed: %v", err)
+			}
+			waitFor(t, func() bool {
+				return stream.sentCount() == 1 && collector.pendingCount() == 1
+			})
+			if atomic.LoadInt64(&collector.stats.SentBatches) != 0 {
+				t.Fatal("uncommitted batch was counted as sent")
+			}
+			if atomic.LoadInt64(&collector.stats.RejectedBatches) != 0 {
+				t.Fatal("retryable batch was counted as permanently rejected")
+			}
+			collector.signalSender()
+			waitFor(t, func() bool { return collector.pendingCount() == 0 })
+			stream.mu.Lock()
+			firstID := stream.sent[0].BatchId
+			secondID := stream.sent[1].BatchId
+			stream.mu.Unlock()
+			if firstID != secondID {
+				t.Fatalf("retry IDs = %d/%d, want the same ID", firstID, secondID)
+			}
+			if got := atomic.LoadInt64(&collector.stats.TotalSamples); got != 1 {
+				t.Fatalf("samples after retry and success = %d, want 1", got)
+			}
+			if positive, negative := atomic.LoadInt64(&collector.stats.PositiveSamples),
+				atomic.LoadInt64(&collector.stats.NegativeSamples); positive != 1 || negative != 0 {
+				t.Fatalf("retry stats = positive/negative %d/%d, want 1/0",
+					positive, negative)
+			}
+			if class, found := collector.signatures.lookup("one"); !found || class != 1 {
+				t.Fatalf("retry signature = class %d found %v, want class 1", class, found)
+			}
+			if err := collector.Close(); err != nil {
+				t.Fatalf("Close() failed: %v", err)
+			}
+		})
+	}
+}
