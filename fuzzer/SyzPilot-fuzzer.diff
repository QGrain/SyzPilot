+// MergeExtraRaw combines executor background-coverage fragments into Extra.
+// Flags must be preserved across every fragment because CoverageOverflow on
+// any fragment makes the combined coverage incomplete.
+func MergeExtraRaw(info *ProgInfo) {
+	if info == nil || len(info.ExtraRaw) == 0 {
+		return
+	}
+	info.Extra = info.ExtraRaw[0]
+	for _, extra := range info.ExtraRaw[1:] {
+		info.Extra.Flags |= extra.Flags
+		info.Extra.Cover = append(info.Extra.Cover, extra.Cover...)
+		info.Extra.Signal = append(info.Extra.Signal, extra.Signal...)
+	}
+	info.ExtraRaw = nil
+}
+
 func EmptyProgInfo(calls int) *ProgInfo {
