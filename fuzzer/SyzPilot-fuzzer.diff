+func writeSingleSeedCatalog(
+	t *testing.T, target *prog.Target, seedName string, seedData []byte,
+) string {
+	t.Helper()
+	digest := sha256.Sum256(seedData)
+	catalog := coldStartSeedCatalog{
+		Schema:        coldStartCatalogSchema,
+		SchemaVersion: coldStartCatalogSchemaVersion,
+		Target: coldStartSeedCatalogTarget{
+			OS: target.OS, Arch: target.Arch, Revision: target.Revision,
+		},
+		Entries: []coldStartSeedCatalogEntry{{
+			Path:            seedName,
+			SHA256:          fmt.Sprintf("%x", digest),
+			Provenance:      coldStartImagegenProvenance,
+			Requirements:    []string{"manual"},
+			NoGenerateCalls: []string{"syz_mount_image$f2fs"},
+		}},
+	}
+	data, err := json.Marshal(catalog)
+	if err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(t.TempDir(), "catalog.json")
+	if err := os.WriteFile(path, data, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
