+func mutatePreservingAnchor(source *prog.Prog, anchors []string, first *prog.Prog,
+	mutate func() *prog.Prog) (*prog.Prog, int, bool) {
+	const maxAnchorMutationAttempts = 4
+	mutated := first
+	retries := 0
+	for attempt := 1; !containsAnySyscall(mutated, anchors) &&
+		attempt < maxAnchorMutationAttempts; attempt++ {
+		retries++
+		mutated = mutate()
+	}
+	if containsAnySyscall(mutated, anchors) {
