+// SyzPilot stats are registered in pkg/fuzzer/stats.go and initialized here.
+func (fuzzer *Fuzzer) initSyzPilotStats() {
+	fuzzer.statDumpTotal = stat.New("dump total", "Number of dumped program evidence artifacts",
+		stat.Simple, stat.NoGraph)
+	fuzzer.statFilteredTotal = stat.New("rfilter filtered total", "Number of programs filtered by reachability filter",
+		stat.Simple, stat.NoGraph)
+	fuzzer.statDebugTimeOverhead = stat.New("debug time overhead", "Total time spent on debug operations (s)",
+		stat.Simple, stat.NoGraph)
+	fuzzer.statTemplateAttempts = stat.New("template mutation attempts",
+		"Number of selected template-insertion mutation operations", stat.Simple, stat.NoGraph)
+	fuzzer.statTemplateSucceeded = stat.New("template mutation succeeded",
+		"Number of template insertions that modified a program", stat.Simple, stat.NoGraph)
+	fuzzer.statTemplateUnavailable = stat.New("template mutation unavailable",
+		"Number of template insertion attempts without a selectable template", stat.Simple, stat.NoGraph)
+	fuzzer.statTemplateNoCapacity = stat.New("template mutation no capacity",
+		"Number of template insertion attempts with no available call capacity", stat.Simple, stat.NoGraph)
+	fuzzer.statTemplateGeneration = stat.New("template mutation generation failed",
+		"Number of template insertion attempts that generated no calls", stat.Simple, stat.NoGraph)
+	fuzzer.statTemplateConstraint = stat.New("template mutation constraint failed",
+		"Number of template insertion attempts rejected by argument constraints", stat.Simple, stat.NoGraph)
+	fuzzer.statTemplateTooLarge = stat.New("template mutation too large",
+		"Number of template insertion attempts whose generated calls exceeded capacity", stat.Simple, stat.NoGraph)
+	fuzzer.statDirectedCorpusPrograms = stat.New("directed corpus programs",
+		"Current number of runtime-only target-directed programs", stat.Simple, stat.NoGraph)
+	fuzzer.statDirectedCorpusMutations = stat.New("directed corpus mutations",
+		"Number of mutations sourced from the target-directed corpus", stat.Simple, stat.NoGraph)
+	fuzzer.statDirectedAnchorRetries = stat.New("directed anchor retries",
+		"Number of directed mutations retried after deleting every selected anchor", stat.Simple, stat.NoGraph)
+	fuzzer.statDirectedAnchorFallbacks = stat.New("directed anchor fallbacks",
+		"Number of directed mutations restored to their source to preserve an anchor", stat.Simple, stat.NoGraph)
+	if len(fuzzer.TargetAddrStrs) != 0 {
+		fuzzer.statReachabilityIncomplete = stat.New("reachability incomplete execution",
+			"Number of non-successful or unfinished executions excluded from reachability labels",
+			stat.Simple, stat.NoGraph)
+		fuzzer.statReachabilityTruncated = stat.New("reachability truncated",
+			"Number of programs excluded from reachability labels because KCOV coverage was truncated",
+			stat.Simple, stat.NoGraph)
+		fuzzer.statReachabilityTruncatedDeepest = make([]*stat.Val, len(fuzzer.TargetAddrStrs)+1)
+		fuzzer.statReachabilityTruncatedDeepest[0] = stat.New(
+			"reachability truncated deepest none",
+			"Number of excluded truncated programs in which no configured target was observed",
+			stat.Simple, stat.NoGraph)
+		fuzzer.statReachability = make([]*stat.Val, len(fuzzer.TargetAddrStrs)+1)
+		fuzzer.statReachability[0] = stat.New("reachability unreachable", "Number of programs reachable to no target",
+			stat.Simple, stat.NoGraph)
+		for i := 0; i < len(fuzzer.TargetAddrStrs); i++ {
+			fuzzer.statReachability[i+1] = stat.New(fmt.Sprintf("reachability %s", fuzzer.TargetAddrStrs[i]), fmt.Sprintf("Number of programs reachable to %s", fuzzer.TargetAddrStrs[i]),
+				stat.Simple, stat.NoGraph)
+			fuzzer.statReachabilityTruncatedDeepest[i+1] = stat.New(
+				fmt.Sprintf("reachability truncated deepest %s", fuzzer.TargetAddrStrs[i]),
+				fmt.Sprintf("Number of excluded truncated programs whose deepest observed target was %s", fuzzer.TargetAddrStrs[i]),
+				stat.Simple, stat.NoGraph)
+		}
+	}
+}
