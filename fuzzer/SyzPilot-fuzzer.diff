@@ -0,0 +1,86 @@
+package main
+
+import (
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/google/syzkaller/pkg/syzpilotlib"
+)
+
+func TestConcurrentDuplicateModelActivationIsIdempotent(t *testing.T) {
+	mgr := &Manager{SyzPilotRTCfg: &syzpilotlib.SyzPilotRuntimeConfig{}}
+	var enableCalls atomic.Int64
+	start := make(chan struct{})
+	release := make(chan struct{})
+	enable := func() error {
+		enableCalls.Add(1)
+		close(start)
+		<-release
+		return nil
+	}
+
+	var wait sync.WaitGroup
+	wait.Add(2)
+	go func() {
+		defer wait.Done()
+		if err := mgr.activateModel("model", "1", enable); err != nil {
+			t.Errorf("first activation failed: %v", err)
+		}
+	}()
+	<-start
+	go func() {
+		defer wait.Done()
+		if err := mgr.activateModel("model", "1", enable); err != nil {
+			t.Errorf("duplicate activation failed: %v", err)
+		}
+	}()
+	time.Sleep(10 * time.Millisecond)
+	close(release)
+	wait.Wait()
+
+	if enableCalls.Load() != 1 {
+		t.Fatalf("enable called %d times, want 1", enableCalls.Load())
+	}
+	if mgr.activeModel != "model" || mgr.activeVersion != "1" {
+		t.Fatalf("active model = %s/%s, want model/1", mgr.activeModel, mgr.activeVersion)
+	}
+}
+
+func TestConcurrentModelActivationsKeepSourceAndStatusConsistent(t *testing.T) {
+	mgr := &Manager{SyzPilotRTCfg: &syzpilotlib.SyzPilotRuntimeConfig{}}
+	var sourceMu sync.Mutex
+	activeSource := ""
+	activate := func(version string) func() error {
+		return func() error {
+			sourceMu.Lock()
+			activeSource = version
+			sourceMu.Unlock()
+			return nil
+		}
+	}
+
+	var wait sync.WaitGroup
+	for _, version := range []string{"1", "2"} {
+		version := version
+		wait.Add(1)
+		go func() {
+			defer wait.Done()
+			if err := mgr.activateModel("model", version, activate(version)); err != nil {
+				t.Errorf("activation %s failed: %v", version, err)
+			}
+		}()
+	}
+	wait.Wait()
+
+	sourceMu.Lock()
+	gotSource := activeSource
+	sourceMu.Unlock()
+	mgr.modelMu.RLock()
+	gotVersion := mgr.activeVersion
+	mgr.modelMu.RUnlock()
+	if gotSource != gotVersion {
+		t.Fatalf("active source version %s differs from status version %s", gotSource, gotVersion)
+	}
+}
diff --git a/syz-manager/syzpilot_resource_closure.go b/syz-manager/syzpilot_resource_closure.go
new file mode 100644
index 0000000..f6c8988
--- /dev/null
+++ b/syz-manager/syzpilot_resource_closure.go
@@ -0,0 +1,296 @@
+// Copyright 2026 syzkaller project authors. All rights reserved.
+// Use of this source code is governed by Apache 2 LICENSE that can be found in the LICENSE file.
+
+package main
+
+import (
+	"container/heap"
+	"fmt"
+	"sort"
+	"strings"
+
+	"github.com/google/syzkaller/pkg/mgrconfig"
+	"github.com/google/syzkaller/prog"
+)
+
+const maxColdStartDependencyStates = 4096
+
+type coldStartDependencyState struct {
+	additions map[int]bool
+	required  map[int]bool
+	key       string
+}
+
+type coldStartDependencyQueue []*coldStartDependencyState
+
+func (queue coldStartDependencyQueue) Len() int { return len(queue) }
+
+func (queue coldStartDependencyQueue) Less(i, j int) bool {
+	if len(queue[i].additions) != len(queue[j].additions) {
+		return len(queue[i].additions) < len(queue[j].additions)
+	}
+	return queue[i].key < queue[j].key
+}
+
+func (queue coldStartDependencyQueue) Swap(i, j int) {
+	queue[i], queue[j] = queue[j], queue[i]
+}
+
+func (queue *coldStartDependencyQueue) Push(value any) {
+	*queue = append(*queue, value.(*coldStartDependencyState))
+}
+
+func (queue *coldStartDependencyQueue) Pop() any {
+	old := *queue
+	last := len(old) - 1
+	value := old[last]
+	old[last] = nil
+	*queue = old[:last]
+	return value
+}
+
+func planColdStartDependencies(
+	cfg *mgrconfig.Config, seeds []coldStartSeed,
+) ([]*prog.Syscall, error) {
+	target := cfg.Target
+	base := make(map[int]bool, len(cfg.Syscalls))
+	for _, id := range cfg.Syscalls {
+		base[id] = true
+	}
+	required := make(map[int]bool)
+	for _, seed := range seeds {
+		for _, call := range seed.program.Calls {
+			if !base[call.Meta.ID] {
+				return nil, fmt.Errorf(
+					"authenticated seed call %q is not selected by enable_syscalls",
+					call.Meta.Name,
+				)
+			}
+			required[call.Meta.ID] = true
+		}
+	}
+	if len(required) == 0 {
+		return nil, nil
+	}
+
+	initial := &coldStartDependencyState{
+		additions: make(map[int]bool),
+		required:  required,
+	}
+	initial.key = coldStartDependencyStateKey(target, initial)
+	queue := &coldStartDependencyQueue{initial}
+	heap.Init(queue)
+	visited := map[string]bool{initial.key: true}
+	stateLimitReached := false
+	var lastFailure string
+
+	for queue.Len() != 0 {
+		state := heap.Pop(queue).(*coldStartDependencyState)
+		enabled := coldStartDependencyEnabledCalls(target, base, state.additions)
+		supported, _ := target.TransitivelyEnabledCalls(enabled)
+		missingCalls := unsupportedRequiredCalls(target, state.required, supported)
+		if len(missingCalls) == 0 {
+			return minimizeColdStartDependencies(target, base, required, state.additions), nil
+		}
+
+		// A selected constructor can itself be unsupported. Expand every current
+		// blocker so that such multi-level resource chains keep making progress.
+		for _, missingCall := range missingCalls {
+			dependencies := target.SyzPilotMissingResourceDependencies(enabled, missingCall)
+			if len(dependencies) == 0 {
+				lastFailure = fmt.Sprintf("%s has no diagnosable resource dependency", missingCall.Name)
+				continue
+			}
+			dependency := dependencies[0]
+			lastFailure = fmt.Sprintf("%s requires resource %s", missingCall.Name, dependency.Name)
+			for _, constructor := range dependency.Constructors {
+				if !coldStartDependencyAllowed(cfg, constructor) {
+					continue
+				}
+				next := &coldStartDependencyState{
+					additions: cloneIDSet(state.additions),
+					required:  cloneIDSet(state.required),
+				}
+				if !base[constructor.ID] {
+					next.additions[constructor.ID] = true
+				}
+				if next.required[constructor.ID] {
+					continue
+				}
+				next.required[constructor.ID] = true
+				next.key = coldStartDependencyStateKey(target, next)
+				if visited[next.key] {
+					continue
+				}
+				if len(visited) >= maxColdStartDependencyStates {
+					stateLimitReached = true
+					continue
+				}
+				visited[next.key] = true
+				heap.Push(queue, next)
+			}
+		}
+	}
+	if stateLimitReached {
+		return nil, fmt.Errorf(
+			"resource dependency search exceeded %d states; last blocker: %s",
+			maxColdStartDependencyStates, lastFailure,
+		)
+	}
+	return nil, fmt.Errorf("no allowed resource-constructor closure: %s", lastFailure)
+}
+
+func coldStartDependencyAllowed(cfg *mgrconfig.Config, call *prog.Syscall) bool {
+	if call.Attrs.Disabled || call.Attrs.NoGenerate {
+		return false
+	}
+	switch cfg.Experimental.DescriptionsMode {
+	case "", "manual":
+		if call.Attrs.Automatic {
+			return false
+		}
+	case "auto":
+		if !call.Attrs.Automatic && !call.Attrs.AutomaticHelper {
+			return false
+		}
+	case "any":
+	default:
+		return false
+	}
+	for _, pattern := range cfg.DisabledSyscalls {
+		if mgrconfig.MatchSyscall(call.Name, pattern) {
+			return false
+		}
+	}
+	return true
+}
+
+func coldStartDependencyEnabledCalls(
+	target *prog.Target, base, additions map[int]bool,
+) map[*prog.Syscall]bool {
+	enabled := make(map[*prog.Syscall]bool, len(base)+len(additions))
+	for id := range base {
+		enabled[target.Syscalls[id]] = true
+	}
+	for id := range additions {
+		enabled[target.Syscalls[id]] = true
+	}
+	return enabled
+}
+
+func firstUnsupportedRequiredCall(
+	target *prog.Target, required map[int]bool, supported map[*prog.Syscall]bool,
+) *prog.Syscall {
+	calls := unsupportedRequiredCalls(target, required, supported)
+	if len(calls) == 0 {
+		return nil
+	}
+	return calls[0]
+}
+
+func unsupportedRequiredCalls(
+	target *prog.Target, required map[int]bool, supported map[*prog.Syscall]bool,
+) []*prog.Syscall {
+	var calls []*prog.Syscall
+	for id := range required {
+		call := target.Syscalls[id]
+		if !supported[call] {
+			calls = append(calls, call)
+		}
+	}
+	sort.Slice(calls, func(i, j int) bool {
+		if calls[i].Name != calls[j].Name {
+			return calls[i].Name < calls[j].Name
+		}
+		return calls[i].ID < calls[j].ID
+	})
+	return calls
+}
+
+func minimizeColdStartDependencies(
+	target *prog.Target, base, required, additions map[int]bool,
+) []*prog.Syscall {
+	ids := sortedCallIDs(target, additions)
+	minimal := cloneIDSet(additions)
+	for _, id := range ids {
+		delete(minimal, id)
+		enabled := coldStartDependencyEnabledCalls(target, base, minimal)
+		supported, _ := target.TransitivelyEnabledCalls(enabled)
+		if firstUnsupportedRequiredCall(target, required, supported) != nil {
+			minimal[id] = true
+		}
+	}
+	ids = sortedCallIDs(target, minimal)
+	result := make([]*prog.Syscall, 0, len(ids))
+	for _, id := range ids {
+		result = append(result, target.Syscalls[id])
+	}
+	return result
+}
+
+func sortedCallIDs(target *prog.Target, calls map[int]bool) []int {
+	ids := make([]int, 0, len(calls))
+	for id := range calls {
+		ids = append(ids, id)
+	}
+	sort.Slice(ids, func(i, j int) bool {
+		left, right := target.Syscalls[ids[i]], target.Syscalls[ids[j]]
+		if left.Name != right.Name {
+			return left.Name < right.Name
+		}
+		return left.ID < right.ID
+	})
+	return ids
+}
+
+func coldStartDependencyStateKey(
+	target *prog.Target, state *coldStartDependencyState,
+) string {
+	format := func(calls map[int]bool) string {
+		ids := sortedCallIDs(target, calls)
+		names := make([]string, 0, len(ids))
+		for _, id := range ids {
+			names = append(names, target.Syscalls[id].Name)
+		}
+		return strings.Join(names, ",")
+	}
+	return format(state.additions) + "|" + format(state.required)
+}
+
+func cloneIDSet(source map[int]bool) map[int]bool {
+	clone := make(map[int]bool, len(source))
+	for id := range source {
+		clone[id] = true
+	}
+	return clone
+}
+
+func coldStartMachineCheckStatus(
+	seeds []coldStartSeed, dependencies []*prog.Syscall,
+	enabled map[*prog.Syscall]bool,
+) ([]string, []string) {
+	unsupported := make(map[string]bool)
+	for _, seed := range seeds {
+		for _, call := range seed.program.Calls {
+			if !enabled[call.Meta] {
+				unsupported[call.Meta.Name] = true
+			}
+		}
+	}
+	unavailable := make(map[string]bool)
+	for _, call := range dependencies {
+		if !enabled[call] {
+			unavailable[call.Name] = true
+		}
+	}
+	return sortedNames(unsupported), sortedNames(unavailable)
+}
+
+func sortedNames(names map[string]bool) []string {
+	result := make([]string, 0, len(names))
+	for name := range names {
+		result = append(result, name)
+	}
+	sort.Strings(result)
+	return result
+}
