+		{size: 2, bufferSize: 100, checkpoint: 16, want: false},
+		{size: 15, bufferSize: 100, checkpoint: 16, want: false},
+		{size: 16, bufferSize: 100, checkpoint: 16, want: true},
+		{size: 17, bufferSize: 100, checkpoint: 16, want: false},
+		{size: 32, bufferSize: 100, checkpoint: 16, want: true},
+		{size: 99, bufferSize: 100, checkpoint: 16, want: false},
+		{size: 100, bufferSize: 100, checkpoint: 16, want: true},
+		{size: 1, bufferSize: 1, checkpoint: 16, want: true},
+	}
+	for _, test := range tests {
+		if got := shouldCheckpointBuffer(
+			test.size, test.bufferSize, test.checkpoint,
+		); got != test.want {
+			t.Errorf("shouldCheckpointBuffer(%d, %d, %d) = %v, want %v",
+				test.size, test.bufferSize, test.checkpoint, got, test.want)
