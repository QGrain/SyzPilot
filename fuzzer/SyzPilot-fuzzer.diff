@@ -0,0 +1,200 @@
+// Copyright 2026 syzkaller project authors. All rights reserved.
+// Use of this source code is governed by Apache 2 LICENSE that can be found in the LICENSE file.
+
+// syzpilot-seed-catalog indexes generic generated programs that make
+// no_generate calls actionable without adding them to random generation.
+package main
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/json"
+	"flag"
+	"fmt"
+	"os"
+	"path/filepath"
+	"runtime"
+	"sort"
+
+	"github.com/google/syzkaller/pkg/manager"
+	"github.com/google/syzkaller/prog"
+	_ "github.com/google/syzkaller/sys"
+)
+
+const (
+	catalogSchema        = "syzpilot.generic-seed-catalog"
+	catalogSchemaVersion = 1
+	imagegenProvenance   = "syz-imagegen"
+	imagegenHeader       = "# Code generated by tools/syz-imagegen. DO NOT EDIT.\n"
+	maxSeedBytes         = 20 << 20
+)
+
+type seedCatalog struct {
+	Schema        string             `json:"schema"`
+	SchemaVersion int                `json:"schema_version"`
+	Target        seedCatalogTarget  `json:"target"`
+	Entries       []seedCatalogEntry `json:"entries"`
+}
+
+type seedCatalogTarget struct {
+	OS       string `json:"os"`
+	Arch     string `json:"arch"`
+	Revision string `json:"revision"`
+}
+
+type seedCatalogEntry struct {
+	Path            string   `json:"path"`
+	SHA256          string   `json:"sha256"`
+	Provenance      string   `json:"provenance"`
+	Requirements    []string `json:"requirements"`
+	NoGenerateCalls []string `json:"no_generate_calls"`
+}
+
+var (
+	flagOS      = flag.String("os", runtime.GOOS, "target operating system")
+	flagArch    = flag.String("arch", runtime.GOARCH, "target architecture")
+	flagSeedDir = flag.String("seed-dir", "", "directory containing generic seed programs")
+	flagOutput  = flag.String("output", "-", "output path, or - for stdout")
+)
+
+func main() {
+	flag.Parse()
+	if *flagSeedDir == "" {
+		fail(fmt.Errorf("-seed-dir is required"))
+	}
+	target, err := prog.GetTarget(*flagOS, *flagArch)
+	if err != nil {
+		fail(err)
+	}
+	catalog, err := buildSeedCatalog(*flagSeedDir, target)
+	if err != nil {
+		fail(err)
+	}
+	data, err := json.MarshalIndent(catalog, "", "  ")
+	if err != nil {
+		fail(fmt.Errorf("marshal catalog: %w", err))
+	}
+	data = append(data, '\n')
+	if *flagOutput == "-" {
+		if _, err := os.Stdout.Write(data); err != nil {
+			fail(fmt.Errorf("write stdout: %w", err))
+		}
+		return
+	}
+	if err := writeAtomic(*flagOutput, data); err != nil {
+		fail(err)
+	}
+}
+
+func buildSeedCatalog(seedDir string, target *prog.Target) (*seedCatalog, error) {
+	files, err := os.ReadDir(seedDir)
+	if err != nil {
+		return nil, fmt.Errorf("read seed directory: %w", err)
+	}
+	entries := make([]seedCatalogEntry, 0)
+	seenPrograms := make(map[[sha256.Size]byte]string)
+	for _, file := range files {
+		if !file.Type().IsRegular() {
+			continue
+		}
+		path := filepath.Join(seedDir, file.Name())
+		data, err := os.ReadFile(path)
+		if err != nil {
+			return nil, fmt.Errorf("read seed %q: %w", path, err)
+		}
+		if len(data) == 0 || len(data) > maxSeedBytes ||
+			!bytes.HasPrefix(data, []byte(imagegenHeader)) {
+			continue
+		}
+		program, requirements, err := manager.ParseSeedWithRequirements(
+			target, data, map[string]bool{"manual": true},
+		)
+		if err != nil {
+			return nil, fmt.Errorf("parse generated seed %q: %w", path, err)
+		}
+		if len(requirements) != 1 || !requirements["manual"] {
+			return nil, fmt.Errorf("generated seed %q must require only manual", path)
+		}
+		calls := noGenerateCallNames(program)
+		if len(calls) == 0 {
+			continue
+		}
+		canonicalDigest := sha256.Sum256(program.Serialize())
+		if _, exists := seenPrograms[canonicalDigest]; exists {
+			continue
+		}
+		seenPrograms[canonicalDigest] = file.Name()
+		digest := sha256.Sum256(data)
+		entries = append(entries, seedCatalogEntry{
+			Path:            file.Name(),
+			SHA256:          fmt.Sprintf("%x", digest),
+			Provenance:      imagegenProvenance,
+			Requirements:    []string{"manual"},
+			NoGenerateCalls: calls,
+		})
+	}
+	sort.Slice(entries, func(i, j int) bool {
+		return entries[i].Path < entries[j].Path
+	})
+	return &seedCatalog{
+		Schema:        catalogSchema,
+		SchemaVersion: catalogSchemaVersion,
+		Target: seedCatalogTarget{
+			OS: target.OS, Arch: target.Arch, Revision: target.Revision,
+		},
+		Entries: entries,
+	}, nil
+}
+
+func noGenerateCallNames(program *prog.Prog) []string {
+	names := make(map[string]bool)
+	for _, call := range program.Calls {
+		if call.Meta.Attrs.NoGenerate {
+			names[call.Meta.Name] = true
+		}
+	}
+	result := make([]string, 0, len(names))
+	for name := range names {
+		result = append(result, name)
+	}
+	sort.Strings(result)
+	return result
+}
+
+func writeAtomic(path string, data []byte) (retErr error) {
+	directory := filepath.Dir(path)
+	temporary, err := os.CreateTemp(directory, ".syzpilot-seed-catalog-*")
+	if err != nil {
+		return fmt.Errorf("create temporary catalog: %w", err)
+	}
+	temporaryPath := temporary.Name()
+	defer func() {
+		if retErr != nil {
+			os.Remove(temporaryPath)
+		}
+	}()
+	if err := temporary.Chmod(0o644); err != nil {
+		temporary.Close()
+		return fmt.Errorf("chmod temporary catalog: %w", err)
+	}
+	if _, err := temporary.Write(data); err != nil {
+		temporary.Close()
+		return fmt.Errorf("write temporary catalog: %w", err)
+	}
+	if err := temporary.Sync(); err != nil {
+		temporary.Close()
+		return fmt.Errorf("sync temporary catalog: %w", err)
+	}
+	if err := temporary.Close(); err != nil {
+		return fmt.Errorf("close temporary catalog: %w", err)
+	}
+	if err := os.Rename(temporaryPath, path); err != nil {
+		return fmt.Errorf("publish catalog: %w", err)
+	}
+	return nil
+}
+
+func fail(err error) {
+	fmt.Fprintf(os.Stderr, "syzpilot-seed-catalog: %v\n", err)
+	os.Exit(1)
+}
