+		return []map[string]float64{{"Unreachable": 1, "Reach_Func1": 0}}, []error{nil}
+	})
+	options := SourceOptions{OnFiltered: func() { filteredTotal.Add(1) }}
+
+	for index := 0; index < 2; index++ {
+		executionStat := stat.New("exec gen", "rfilter cumulative stat test")
+		filtered := testRequest(executionStat)
+		bypassed := testRequest(executionStat)
+		config.ReachFilter.StartAfter = ""
+		source := NewRFSource(
+			&testSource{requests: []*queue.Request{filtered, bypassed}},
+			config,
+			predict,
+			options,
+		)
+		source.maxFilterRounds = 1
+		if got := source.Next(); got != bypassed {
+			t.Fatalf("replacement %d returned %p, want %p", index, got, bypassed)
+		}
+		source.Close()
+	}
+	if filteredTotal.Load() != 2 {
+		t.Fatalf("cumulative filtered count = %d, want 2", filteredTotal.Load())
+	}
+}
