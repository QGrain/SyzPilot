+
+type testSource struct {
+	mu       sync.Mutex
+	requests []*queue.Request
+}
+
+func (source *testSource) Next() *queue.Request {
+	source.mu.Lock()
+	defer source.mu.Unlock()
+	if len(source.requests) == 0 {
+		return nil
+	}
+	request := source.requests[0]
+	source.requests = source.requests[1:]
+	return request
+}
+
+type predictorFunc func([][]byte) ([]map[string]float64, []error)
+
+func (function predictorFunc) PredictBatch(programs [][]byte) ([]map[string]float64, []error) {
+	return function(programs)
+}
+
+func testConfig() mgrconfig.SyzPilotCfg {
+	return mgrconfig.SyzPilotCfg{
+		TargetPCs:   []string{"0x1234"},
+		ReachFilter: mgrconfig.ReachFilterCfg{BatchSize: 4},
+		SchedulingStrategy: mgrconfig.SchedulingStrategy{
+			Type:  1,
+			Alpha: 1,
+			Beta:  1,
+		},
+	}
+}
+
+func TestValidatePredictionSchemas(t *testing.T) {
+	valid := []struct {
+		name        string
+		prediction  map[string]float64
+		targetCount int
+	}{
+		{"binary-one-target", map[string]float64{"Unreachable": 0.4, "Reachable": 0.6}, 1},
+		{"ternary-two-targets", map[string]float64{
+			"Unreachable": 0.2, "Reach_Shallow": 0.3, "Reach_Deep": 0.5,
+		}, 2},
+		{"ternary-three-targets", map[string]float64{
+			"Unreachable": 0.2, "Reach_Shallow": 0.3, "Reach_Deep": 0.5,
+		}, 3},
+		{"waypoint-one-target", map[string]float64{
+			"Unreachable": 0.2, "Reach_Func1": 0.8,
+		}, 1},
+		{"waypoint-two-targets", map[string]float64{
+			"Unreachable": 0.2, "Reach_Func1": 0.3, "Reach_Func2": 0.5,
+		}, 2},
+	}
+	for _, test := range valid {
+		t.Run(test.name, func(t *testing.T) {
+			if err := ValidatePrediction(test.prediction, test.targetCount); err != nil {
+				t.Fatalf("valid prediction rejected: %v", err)
+			}
+		})
+	}
+
+	invalid := []map[string]float64{
+		{"Unreachable": 0.8, "Reach_Shallow": 0.2},
+		{"Unreachable": 0.2, "Reach_Shallow": 0.3, "Reach_Deep": 0.4},
+		{"Unreachable": 0.5, "Reach_Func2": 0.5},
+		{"Unreachable": 1.1, "Reachable": -0.1},
+		{"Unreachable": 0.5, "Reachable": 0.5, "Reach_Deep": 0},
+		{"Unreachable": 0.5, "Reachable": math.NaN()},
+		{"Unreachable": 0.5, "Reachable": math.Inf(1)},
+	}
+	for index, prediction := range invalid {
+		if err := ValidatePrediction(prediction, 2); err == nil {
+			t.Fatalf("invalid prediction %d was accepted: %#v", index, prediction)
+		}
+	}
+	if err := ValidatePrediction(map[string]float64{
+		"Unreachable": 0.2, "Reach_Shallow": 0.3, "Reach_Deep": 0.5,
