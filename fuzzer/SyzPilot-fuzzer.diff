+
+func TestMergeExtraRawPreservesOverflow(t *testing.T) {
+	info := &ProgInfo{
+		ExtraRaw: []*CallInfo{
+			{Flags: CallFlagExecuted, Cover: []uint64{1}, Signal: []uint64{2}},
+			{
+				Flags:  CallFlagFinished | CallFlagCoverageOverflow,
+				Cover:  []uint64{3},
+				Signal: []uint64{4},
+			},
+		},
+	}
+	MergeExtraRaw(info)
+
+	if info.Extra == nil {
+		t.Fatal("Extra was not populated")
+	}
+	wantFlags := CallFlagExecuted | CallFlagFinished | CallFlagCoverageOverflow
+	if info.Extra.Flags != wantFlags {
+		t.Fatalf("flags = %v, want %v", info.Extra.Flags, wantFlags)
+	}
+	if !slices.Equal(info.Extra.Cover, []uint64{1, 3}) {
+		t.Fatalf("cover = %v, want [1 3]", info.Extra.Cover)
+	}
+	if !slices.Equal(info.Extra.Signal, []uint64{2, 4}) {
+		t.Fatalf("signal = %v, want [2 4]", info.Extra.Signal)
+	}
+	if info.ExtraRaw != nil {
+		t.Fatalf("ExtraRaw was not cleared: %v", info.ExtraRaw)
+	}
+}
diff --git a/pkg/fuzzer/directed_corpus.go b/pkg/fuzzer/directed_corpus.go
new file mode 100644
index 0000000..8435e31
--- /dev/null
+++ b/pkg/fuzzer/directed_corpus.go
@@ -0,0 +1,173 @@
+// Copyright 2026 SyzPilot authors. All rights reserved.
+// Use of this source code is governed by Apache 2 LICENSE that can be found in the LICENSE file.
+
+package fuzzer
+
+import (
+	"crypto/sha256"
+	"math/rand"
+	"sort"
+	"sync"
+
+	"github.com/google/syzkaller/prog"
+)
+
+// directedCorpus is an additive, runtime-only pool. It deliberately does not
+// implement corpus persistence or native signal-based admission semantics.
+type directedCorpus struct {
+	mu       sync.RWMutex
+	capacity int
+	nextAge  uint64
+	entries  []*directedCorpusEntry
+	index    map[[sha256.Size]byte]int
+}
+
+type directedCorpusEntry struct {
+	program *prog.Prog
+	anchors map[string]struct{}
+	depth   int
+	age     uint64
+	digest  [sha256.Size]byte
+}
+
+func newDirectedCorpus(capacity int) *directedCorpus {
+	return &directedCorpus{
+		capacity: capacity,
+		index:    make(map[[sha256.Size]byte]int),
+	}
+}
+
+// save retains p when it is new or carries stronger target evidence. It
+// returns the change in corpus size, which is either zero or one.
+func (corpus *directedCorpus) save(p *prog.Prog, anchors []string, depth int) int {
+	if corpus == nil || p == nil || len(p.Calls) == 0 || corpus.capacity <= 0 {
+		return 0
+	}
+	digest := sha256.Sum256(p.Serialize())
+	anchorSet := make(map[string]struct{}, len(anchors))
+	for _, anchor := range anchors {
+		if programContainsSyscall(p, anchor) {
+			anchorSet[anchor] = struct{}{}
+		}
+	}
+
+	corpus.mu.Lock()
+	defer corpus.mu.Unlock()
+	if index, ok := corpus.index[digest]; ok {
+		entry := corpus.entries[index]
+		for anchor := range anchorSet {
+			entry.anchors[anchor] = struct{}{}
+		}
+		if depth > entry.depth {
+			entry.depth = depth
+		}
+		return 0
+	}
+
+	corpus.nextAge++
+	entry := &directedCorpusEntry{
+		program: p.Clone(),
+		anchors: anchorSet,
+		depth:   depth,
+		age:     corpus.nextAge,
+		digest:  digest,
+	}
+	if len(corpus.entries) < corpus.capacity {
+		corpus.index[digest] = len(corpus.entries)
+		corpus.entries = append(corpus.entries, entry)
+		return 1
+	}
+
+	// Prefer deeper target evidence. Break equal-depth ties by evicting the
+	// oldest entry so stale cold-start seeds cannot occupy the pool forever.
+	victim := 0
+	for index := 1; index < len(corpus.entries); index++ {
+		current := corpus.entries[index]
+		selected := corpus.entries[victim]
+		if current.depth < selected.depth ||
+			(current.depth == selected.depth && current.age < selected.age) {
+			victim = index
+		}
+	}
+	if entry.depth < corpus.entries[victim].depth {
+		return 0
+	}
+	delete(corpus.index, corpus.entries[victim].digest)
+	corpus.entries[victim] = entry
+	corpus.index[digest] = victim
+	return 0
+}
+
+func (corpus *directedCorpus) choose(rnd *rand.Rand) (*prog.Prog, []string) {
+	if corpus == nil {
+		return nil, nil
+	}
+	corpus.mu.RLock()
+	defer corpus.mu.RUnlock()
+	if len(corpus.entries) == 0 {
+		return nil, nil
+	}
+	entry := corpus.entries[rnd.Intn(len(corpus.entries))]
+	anchors := make([]string, 0, len(entry.anchors))
+	for anchor := range entry.anchors {
+		anchors = append(anchors, anchor)
+	}
+	sort.Strings(anchors)
+	return entry.program.Clone(), anchors
+}
+
+func (corpus *directedCorpus) programs() []*prog.Prog {
+	if corpus == nil {
+		return nil
+	}
+	corpus.mu.RLock()
+	defer corpus.mu.RUnlock()
+	programs := make([]*prog.Prog, len(corpus.entries))
+	for index, entry := range corpus.entries {
+		programs[index] = entry.program
+	}
+	return programs
+}
+
+func (corpus *directedCorpus) replaceAnchors(anchors []string) {
+	if corpus == nil {
+		return
+	}
+	corpus.mu.Lock()
+	defer corpus.mu.Unlock()
+	for _, entry := range corpus.entries {
+		entry.anchors = make(map[string]struct{})
+		for _, anchor := range anchors {
+			if programContainsSyscall(entry.program, anchor) {
+				entry.anchors[anchor] = struct{}{}
+			}
+		}
+	}
+}
+
+func (corpus *directedCorpus) len() int {
+	if corpus == nil {
+		return 0
+	}
+	corpus.mu.RLock()
+	defer corpus.mu.RUnlock()
+	return len(corpus.entries)
+}
+
+func programContainsSyscall(program *prog.Prog, name string) bool {
+	for _, call := range program.Calls {
+		if call.Meta.Name == name {
+			return true
+		}
+	}
+	return false
+}
+
+func containsAnySyscall(program *prog.Prog, names []string) bool {
+	for _, name := range names {
+		if programContainsSyscall(program, name) {
+			return true
+		}
+	}
+	return false
+}
