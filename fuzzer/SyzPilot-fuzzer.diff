+package syzpilotlib
+
+import "testing"
+
+func TestOneHotLabelClass(t *testing.T) {
+	tests := []struct {
+		name     string
+		labels   []bool
+		class    int
+		valid    bool
+		positive bool
+	}{
+		{name: "empty", labels: nil, class: -1, valid: false},
+		{name: "unknown", labels: []bool{false, false, false}, class: -1, valid: false},
+		{name: "unreachable", labels: []bool{true, false, false}, class: 0, valid: true},
+		{name: "shallow reached", labels: []bool{false, true, false}, class: 1, valid: true, positive: true},
+		{name: "deep reached", labels: []bool{false, false, true}, class: 2, valid: true, positive: true},
+		{name: "multi hot", labels: []bool{true, true, false}, class: -1, valid: false},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			class, valid := OneHotLabelClass(test.labels)
+			if class != test.class || valid != test.valid {
+				t.Fatalf("OneHotLabelClass(%v) = (%d, %v), want (%d, %v)",
+					test.labels, class, valid, test.class, test.valid)
+			}
+			if got := IsPositiveLabel(test.labels); got != test.positive {
+				t.Fatalf("IsPositiveLabel(%v) = %v, want %v", test.labels, got, test.positive)
+			}
+		})
+	}
+}
+
+func TestTransferDeepestLabelsIncludesUnreachableClass(t *testing.T) {
+	tests := []struct {
+		name  string
+		input []bool
+		want  []bool
+	}{
+		{name: "unreachable", input: []bool{true, false, false}, want: []bool{true, false, false}},
+		{name: "deepest reached", input: []bool{false, true, true}, want: []bool{false, false, true}},
+		{name: "unknown remains invalid", input: []bool{false, false, false}, want: []bool{false, false, false}},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			got := TransferDeepestLabels(test.input)
+			if len(got) != len(test.want) {
+				t.Fatalf("length = %d, want %d", len(got), len(test.want))
+			}
+			for i := range got {
+				if got[i] != test.want[i] {
+					t.Fatalf("TransferDeepestLabels(%v) = %v, want %v", test.input, got, test.want)
+				}
+			}
+		})
+	}
+}
+
+func TestNormalizeReachabilityLabel(t *testing.T) {
+	tests := []struct {
+		name  string
+		input []bool
+		want  []bool
+		valid bool
+	}{
+		{name: "empty", input: nil, valid: false},
+		{name: "unknown", input: []bool{false, false, false}, valid: false},
+		{name: "unreachable", input: []bool{true, false, false}, want: []bool{true, false, false}, valid: true},
+		{name: "unreachable and reached", input: []bool{true, true, false}, valid: false},
+		{name: "shallow reached", input: []bool{false, true, false, false}, want: []bool{false, true, false, false}, valid: true},
+		{name: "cumulative reached", input: []bool{false, true, false, true}, want: []bool{false, false, false, true}, valid: true},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			got, valid := NormalizeReachabilityLabel(test.input)
+			if valid != test.valid {
+				t.Fatalf("NormalizeReachabilityLabel(%v) valid = %v, want %v", test.input, valid, test.valid)
+			}
+			if len(got) != len(test.want) {
+				t.Fatalf("NormalizeReachabilityLabel(%v) length = %d, want %d", test.input, len(got), len(test.want))
+			}
+			for i := range got {
+				if got[i] != test.want[i] {
+					t.Fatalf("NormalizeReachabilityLabel(%v) = %v, want %v", test.input, got, test.want)
+				}
+			}
+		})
+	}
+}
diff --git a/pkg/syzpilotlib/manager/client.go b/pkg/syzpilotlib/manager/client.go
new file mode 100644
index 0000000..dffa6df
--- /dev/null
+++ b/pkg/syzpilotlib/manager/client.go
@@ -0,0 +1,439 @@
+// Package manager provides the client functionality for interacting with the SyzPilot-brain controller.
+// It handles the registration of fuzzer instances, the establishment of SSH tunnels in isolated mode, and the management of these resources.
+package manager
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"log"
+	"net"
+	"net/http"
+	"net/url"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"sync"
+	"syscall"
+	"time"
+
+	"github.com/google/uuid"
+)
+
+const (
+	// keyAlgorithm: the encryption algorithm used to generate SSH keys (ed25519 by default).
+	keyAlgorithm = "ed25519"
+	// defaultRequestTimeout: the default timeout for registering with the server (30 seconds by default).
+	defaultRequestTimeout = 30 * time.Second
+	// The Brain may need up to 15 seconds to cancel a concurrent trainer launch.
+	unregisterShutdownTimeout = 50 * time.Second
+	unregisterRetryDelay      = time.Second
+	unregisterMaxAttempts     = 3
+)
+
+var errTemporaryUnregister = errors.New("Brain task cleanup is incomplete")
+
+// --- data structure definitions ---
+
+// Config: contains all the configuration information needed to initialize the client.
+type Config struct {
+	NetworkMode      string // network mode: "isolated" or "direct"
+	ServerAddr       string // IP address of the brain controller, ip:port
+	HostIP           string // IP address of the host where the fuzzer instance is located (only required in direct mode)
+	HostHttpPort     int    // HTTP server port of the fuzzer instance (loaded from mgrconfig)
+	TargetFunc       string // optional target function interpreted by the Brain
+	ReportPath       string // optional crash-report path on the Brain host
+	KallgraphDir     string // optional KallGraph output directory on the Brain host
+	TargetOS         string // compiled prog.Target operating system
+	TargetArch       string // compiled prog.Target architecture
+	TargetRevision   string // compiled syscall-description revision
+	ProducerRevision string // syzkaller revision embedded in this binary
+	DescriptionsMode string // manual, auto, or any
+}
+
+// Client: the main structure for interacting with the SyzPilot-brain controller.
+type Client struct {
+	Config       Config
+	FuzzerID     string
+	httpClient   *http.Client
+	autosshCmd   *exec.Cmd
+	mu           sync.Mutex
+	unregisterMu sync.Mutex
+	taskID       string
+	closeOnce    sync.Once
+}
+
+// RegistrationPayload: the data structure for sending to the server for registration.
+// using a single structure and the omitempty tag, it is easier to manage than multiple nested structures.
+type RegistrationPayload struct {
+	UUID             string `json:"uuid"`
+	TaskName         string `json:"task_name"`
+	Mode             string `json:"mode"`
+	PublicKey        string `json:"public_key,omitempty"` // omitempty in direct mode
+	HostIP           string `json:"host_ip,omitempty"`    // omitempty in isolated mode
+	HttpPort         int    `json:"http_port,omitempty"`  // omitempty in isolated mode
+	TargetFunc       string `json:"target_func,omitempty"`
+	ReportPath       string `json:"report_path,omitempty"`
+	KallgraphDir     string `json:"kallgraph_dir,omitempty"`
+	TargetOS         string `json:"target_os"`
+	TargetArch       string `json:"target_arch"`
+	TargetRevision   string `json:"target_revision"`
+	ProducerRevision string `json:"producer_revision"`
+	DescriptionsMode string `json:"descriptions_mode"`
+}
+
+// RegistrationResponse: the data structure for receiving from the controller for registration.
+type RegistrationResponse struct {
+	TaskID         string `json:"task_id"`
+	ReceiverPort   int    `json:"receiver_port"`
+	TunnelPort     int    `json:"tunnel_port,omitempty"` // omitempty in direct mode
+	TorchservePort int    `json:"torchserve_port"`
+	ModelName      string `json:"model_name"`
+	ModelVersion   string `json:"model_version"`
+}
+
+// NewClient: create and initialize a new SyzPilot-fuzzer client.
+// will automatically generate a new V1 UUID for the FuzzerID.
+func NewClient(cfg Config) (*Client, error) {
+	if err := validateConfig(cfg); err != nil {
+		return nil, fmt.Errorf("invalid configuration: %w", err)
+	}
+
+	// generate a V1 UUID based on time and MAC address, which can identify the instance uniquely
+	FuzzerID, err := uuid.NewUUID()
+	if err != nil {
+		return nil, fmt.Errorf("failed to generate V1 UUID: %w", err)
+	}
+	log.Printf("[SyzPilot Client] Generated new fuzzer UUID: %s", FuzzerID.String())
+
+	return &Client{
+		Config:     cfg,
+		FuzzerID:   FuzzerID.String(),
+		httpClient: newControlHTTPClient(),
+	}, nil
+}
+
+// newControlHTTPClient creates a dedicated direct transport for the Brain
+// control plane. Registration and unregistration must not inherit ambient
+// HTTP proxy settings: the configured Controller also owns direct gRPC and SSH
+// endpoints, and registration carries task metadata and an SSH public key.
+func newControlHTTPClient() *http.Client {
+	transport, ok := http.DefaultTransport.(*http.Transport)
+	if ok {
+		transport = transport.Clone()
+	} else {
+		transport = &http.Transport{
+			DialContext: (&net.Dialer{
+				Timeout:   30 * time.Second,
+				KeepAlive: 30 * time.Second,
+			}).DialContext,
+			ForceAttemptHTTP2:     true,
+			MaxIdleConns:          100,
+			IdleConnTimeout:       90 * time.Second,
+			TLSHandshakeTimeout:   10 * time.Second,
+			ExpectContinueTimeout: 1 * time.Second,
+		}
+	}
+	transport.Proxy = nil
+	return &http.Client{
+		Transport: transport,
+		Timeout:   defaultRequestTimeout,
+	}
+}
+
+// validateConfig: check if the incoming configuration is valid.
+func validateConfig(cfg Config) error {
+	for _, field := range []struct {
+		name  string
+		value string
+	}{
+		{"target OS", cfg.TargetOS},
+		{"target arch", cfg.TargetArch},
+		{"target revision", cfg.TargetRevision},
+		{"producer revision", cfg.ProducerRevision},
+	} {
+		if field.value == "" {
+			return fmt.Errorf("%s is required", field.name)
+		}
+	}
+	if cfg.DescriptionsMode != "manual" && cfg.DescriptionsMode != "auto" &&
+		cfg.DescriptionsMode != "any" {
+		return fmt.Errorf("invalid descriptions mode %q", cfg.DescriptionsMode)
+	}
+	if cfg.ServerAddr == "" {
+		return fmt.Errorf("server address is required")
+	}
+	_, serverPortStr, err := net.SplitHostPort(cfg.ServerAddr)
+	if err != nil {
+		return fmt.Errorf("failed to split server address: %w", err)
+	}
+	serverPort, err := strconv.Atoi(serverPortStr)
+	if err != nil {
+		return fmt.Errorf("failed to convert server port to int: %w", err)
+	}
+	if serverPort <= 0 || serverPort > 65535 {
+		return fmt.Errorf("server port is invalid: %d", serverPort)
+	}
+	if cfg.NetworkMode != "isolated" && cfg.NetworkMode != "direct" {
+		return fmt.Errorf("network mode must be 'isolated' or 'direct', got '%s'", cfg.NetworkMode)
+	}
+	networkInfo := CheckNetworkInfo()
+	if cfg.NetworkMode != networkInfo.NetworkMode {
+		return fmt.Errorf("detected network mode: %s, but configured network mode: %s", networkInfo.NetworkMode, cfg.NetworkMode)
+	}
+	if cfg.NetworkMode == "direct" && cfg.HostIP == "" {
+		return fmt.Errorf("callback IP is required in 'direct' mode")
+	}
+	if cfg.HostHttpPort <= 0 || cfg.HostHttpPort > 65535 {
+		return fmt.Errorf("local http port is invalid: %d", cfg.HostHttpPort)
+	}
+	return nil
+}
+
+// Register: register the fuzzer instance to the brain controller.
+// after successful registration, if in isolated mode, it will automatically start the SSH tunnel.
+func (c *Client) Register(ctx context.Context, taskName string) (*RegistrationResponse, error) {
+	log.Printf("[SyzPilot Client] Starting registration for fuzzer '%s' in '%s' mode...", c.FuzzerID, c.Config.NetworkMode)
+
+	payload := RegistrationPayload{
+		UUID:         c.FuzzerID,
+		TaskName:     taskName,
+		Mode:         c.Config.NetworkMode,
+		TargetFunc:   c.Config.TargetFunc,
+		ReportPath:   c.Config.ReportPath,
+		KallgraphDir: c.Config.KallgraphDir,
+		TargetOS:     c.Config.TargetOS, TargetArch: c.Config.TargetArch,
+		TargetRevision:   c.Config.TargetRevision,
+		ProducerRevision: c.Config.ProducerRevision,
+		DescriptionsMode: c.Config.DescriptionsMode,
+	}
+
+	if c.Config.NetworkMode == "direct" {
+		payload.HostIP = c.Config.HostIP
+		payload.HttpPort = c.Config.HostHttpPort
+	} else { // isolated mode
+		publicKey, err := ensureSshKeys()
+		if err != nil {
+			return nil, fmt.Errorf("SSH key management failed: %w", err)
+		}
+		payload.PublicKey = publicKey
+	}
+
+	payloadBytes, err := json.Marshal(payload)
+	if err != nil {
+		return nil, fmt.Errorf("failed to marshal registration payload: %w", err)
+	}
+
+	registerURL := fmt.Sprintf("http://%s/register", c.Config.ServerAddr)
+	req, err := http.NewRequestWithContext(ctx, "POST", registerURL, bytes.NewReader(payloadBytes))
+	if err != nil {
+		return nil, fmt.Errorf("failed to create registration request: %w", err)
+	}
+	req.Header.Set("Content-Type", "application/json")
+
+	resp, err := c.httpClient.Do(req)
+	if err != nil {
+		return nil, fmt.Errorf("failed to send registration request to server: %w", err)
+	}
+	defer resp.Body.Close()
+
+	if resp.StatusCode != http.StatusOK {
+		var errBody struct {
+			Detail string `json:"detail"`
+		}
+		json.NewDecoder(resp.Body).Decode(&errBody)
+		return nil, fmt.Errorf("registration failed with status %d: %s", resp.StatusCode, errBody.Detail)
+	}
+
+	var regResponse RegistrationResponse
+	if err := json.NewDecoder(resp.Body).Decode(&regResponse); err != nil {
+		return nil, fmt.Errorf("failed to decode server response: %w", err)
+	}
+	if regResponse.TaskID == "" {
+		return nil, fmt.Errorf("registration response did not include a task ID")
+	}
+	c.mu.Lock()
+	c.taskID = regResponse.TaskID
+	c.mu.Unlock()
+
+	log.Printf("[SyzPilot Client] Registration successful. Task ID: %s, assigned receiver port: %d, torchserve port: %d", regResponse.TaskID, regResponse.ReceiverPort, regResponse.TorchservePort)
+
+	// if in isolated mode, start the autossh tunnel
+	if c.Config.NetworkMode == "isolated" {
+		log.Printf("[SyzPilot Client] Server assigned remote tunnel port: %d. Starting SSH tunnel...", regResponse.TunnelPort)
+		if err := c.startAutosshTunnel(regResponse.TunnelPort); err != nil {
+			cleanupCtx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+			defer cancel()
+			if cleanupErr := c.unregister(cleanupCtx); cleanupErr != nil {
+				log.Printf("[SyzPilot Client] Failed to roll back registration: %v", cleanupErr)
+			}
+			return nil, fmt.Errorf("registration successful, but failed to start SSH tunnel: %w", err)
+		}
+	}
+
+	return &regResponse, nil
+}
+
+// Close: gracefully terminate the autossh and clean up related resources
+func (c *Client) Close() {
+	c.closeOnce.Do(func() {
+		log.Println("[SyzPilot Client] Shutting down...")
+		if c.autosshCmd != nil && c.autosshCmd.Process != nil {
+			log.Println("[SyzPilot Client] Terminating autossh process group...")
+			// Kill the process group so both autossh and its ssh child exit.
+			if err := syscall.Kill(-c.autosshCmd.Process.Pid, syscall.SIGKILL); err != nil {
+				log.Printf("[SyzPilot Client] Failed to kill autossh process group (PID: %d): %v", c.autosshCmd.Process.Pid, err)
+			} else {
+				log.Printf("[SyzPilot Client] Autossh process group (PID: %d) terminated.", c.autosshCmd.Process.Pid)
+			}
+		}
+	})
+	ctx, cancel := context.WithTimeout(context.Background(), unregisterShutdownTimeout)
+	defer cancel()
+	if err := c.unregisterWithRetry(ctx, unregisterRetryDelay); err != nil {
+		log.Printf("[SyzPilot Client] Failed to unregister Brain task: %v", err)
+	}
+	log.Println("[SyzPilot Client] Shutdown complete.")
+}
+
+// unregisterWithRetry handles transient shutdown races without treating a
+// permanent HTTP error as a reason to delay manager exit. A failed attempt
+// leaves taskID intact; a completed previous request returns 404 on retry.
+func (c *Client) unregisterWithRetry(ctx context.Context, retryDelay time.Duration) error {
+	for attempt := 0; attempt < unregisterMaxAttempts; attempt++ {
+		err := c.unregister(ctx)
+		if err == nil {
+			return nil
+		}
+		var requestError *url.Error
+		if attempt+1 == unregisterMaxAttempts ||
+			(!errors.Is(err, errTemporaryUnregister) && !errors.As(err, &requestError)) {
+			return err
+		}
+		log.Printf("[SyzPilot Client] Retrying incomplete Brain unregistration: %v", err)
+		timer := time.NewTimer(retryDelay)
+		select {
+		case <-ctx.Done():
+			timer.Stop()
+			return fmt.Errorf("unregister retry cancelled: %w", ctx.Err())
+		case <-timer.C:
+		}
+	}
+	panic("unreachable unregister retry loop")
+}
+
+func (c *Client) unregister(ctx context.Context) error {
+	c.unregisterMu.Lock()
+	defer c.unregisterMu.Unlock()
+	c.mu.Lock()
+	taskID := c.taskID
+	c.mu.Unlock()
+	if taskID == "" {
+		return nil
+	}
+	unregisterURL := fmt.Sprintf(
+		"http://%s/unregister/%s", c.Config.ServerAddr, url.PathEscape(taskID),
+	)
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, unregisterURL, nil)
+	if err != nil {
+		return fmt.Errorf("create unregister request: %w", err)
+	}
+	resp, err := c.httpClient.Do(req)
+	if err != nil {
+		return fmt.Errorf("send unregister request: %w", err)
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode == http.StatusServiceUnavailable {
+		return fmt.Errorf("unregister failed with status %d: %w",
+			resp.StatusCode, errTemporaryUnregister)
+	}
+	if resp.StatusCode != http.StatusOK && resp.StatusCode != http.StatusNotFound {
+		return fmt.Errorf("unregister failed with status %d", resp.StatusCode)
+	}
+	c.mu.Lock()
+	if c.taskID == taskID {
+		c.taskID = ""
+	}
+	c.mu.Unlock()
+	return nil
+}
+
+// startAutosshTunnel: start and manage the autossh background process.
+func (c *Client) startAutosshTunnel(remoteTunnelPort int) error {
+	if c.autosshCmd != nil {
+		return fmt.Errorf("autossh process is already running")
+	}
+
+	// Extract IP from ServerAddr (which includes HTTP port); SSH uses port 22 by default
+	serverHost, _, err := net.SplitHostPort(c.Config.ServerAddr)
+	if err != nil {
+		serverHost = c.Config.ServerAddr // fallback: use as-is if no port
+	}
+	serverUserAndIP := fmt.Sprintf("fuzzer-tunnel@%s", serverHost)
+	remotePortSpec := fmt.Sprintf("%d:localhost:%d", remoteTunnelPort, c.Config.HostHttpPort)
+
+	cmd := exec.Command("autossh", "-M", "0",
+		"-o", "StrictHostKeyChecking=no", // avoid the interactive prompt for the first connection
+		"-o", "ServerAliveInterval=60",
+		"-o", "ServerAliveCountMax=3",
+		"-o", "ExitOnForwardFailure=yes",
+		"-o", "ConnectTimeout=10",
+		"-NR", remotePortSpec, serverUserAndIP,
+	)
+
+	// create a new process group, so that we can kill the entire group (autossh and its ssh child processes)
+	cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
+
+	log.Printf("[AutoSSH] Starting background process: %s", cmd.String())
+	if err := cmd.Start(); err != nil {
+		return fmt.Errorf("failed to start autossh: %w", err)
+	}
+
+	c.autosshCmd = cmd
+	log.Printf("[AutoSSH] Process started with PID: %d, PGID: %d", cmd.Process.Pid, cmd.Process.Pid)
+
+	// start a goroutine to monitor the process, in case it exits unexpectedly
+	go func() {
+		err := cmd.Wait()
+		log.Printf("[AutoSSH] Process with PID %d exited. Error: %v", cmd.Process.Pid, err)
+		// TODO: add reconnection here (low priority)
+	}()
+
+	return nil
+}
+
+// ensureSshKeys: ensure the SSH keys exist, if not, create them. return the public key content.
+func ensureSshKeys() (string, error) {
+	homeDir, err := os.UserHomeDir()
+	if err != nil {
+		return "", fmt.Errorf("could not get user home directory: %w", err)
+	}
+	sshDir := filepath.Join(homeDir, ".ssh")
+	privKeyPath := filepath.Join(sshDir, "id_"+keyAlgorithm)
+	pubKeyPath := privKeyPath + ".pub"
+
+	if _, err := os.Stat(privKeyPath); os.IsNotExist(err) {
+		log.Printf("[SSH] Key not found. Generating new %s key at %s...", keyAlgorithm, privKeyPath)
+		cmd := exec.Command("ssh-keygen",
+			"-t", keyAlgorithm,
+			"-f", privKeyPath,
+			"-N", "",
+			"-C", "syzpilot-fuzzer-key-for-tunnel",
+		)
+		if output, err := cmd.CombinedOutput(); err != nil {
+			return "", fmt.Errorf("ssh-keygen failed: %w\nOutput: %s", err, output)
+		}
+		log.Println("[SSH] Key generated successfully.")
+	} else {
+		log.Println("[SSH] Found existing SSH key.")
+	}
+
+	pubKeyBytes, err := os.ReadFile(pubKeyPath)
+	if err != nil {
+		return "", fmt.Errorf("failed to read public key: %w", err)
+	}
+	return string(pubKeyBytes), nil
+}
diff --git a/pkg/syzpilotlib/manager/client_test.go b/pkg/syzpilotlib/manager/client_test.go
