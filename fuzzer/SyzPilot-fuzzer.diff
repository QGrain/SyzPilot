+#!/usr/bin/env python3
+"""
+Analyze debuglogger.log to extract empty coverage statistics by queue type.
+This script helps understand which queue types are producing empty coverage.
+"""
+
+import argparse
+import re
+from collections import defaultdict
+from pathlib import Path
+from typing import Dict, List
+
+try:
+    from tqdm import tqdm
+    TQDM_AVAILABLE = True
+except ImportError:
+    TQDM_AVAILABLE = False
+    print("Warning: tqdm not available. Install with 'pip install tqdm' for progress bars.")
+
+
+class DebugLoggerAnalyzer:
+    def __init__(self, log_file: str, max_examples: int = 2):
+        self.log_file = Path(log_file)
+        self.max_examples = max_examples
+
+        # Analysis results - use lists to track all occurrences
+        self.empty_coverage_by_queue: Dict[str, List[str]] = defaultdict(list)
+        self.non_empty_coverage_by_queue: Dict[str, List[str]] = defaultdict(list)
+
+    def analyze(self) -> Dict:
+        """Perform complete analysis of debuglogger.log file."""
+        print(f"Analyzing debuglogger.log: {self.log_file}")
+        print("=" * 80)
+
+        if not self.log_file.exists():
+            print(f"Error: Log file '{self.log_file}' does not exist!")
+            return {}
+
+        self._parse_log_file()
+        return self._generate_summary()
+
+    def _parse_log_file(self):
+        """Parse the debuglogger.log file to extract coverage information."""
+        print("Parsing debuglogger.log file...")
+
+        # Patterns for matching log entries
+        patterns = {
+            'empty_coverage': re.compile(r'Empty coverage for program ([a-f0-9]+) from queue: (.+)'),
+            'non_empty_coverage': re.compile(r'Non-empty coverage for program ([a-f0-9]+) from queue: (.+)'),
+        }
+
+        lines = self._read_file()
+        iterator = tqdm(lines, desc="Parsing log lines") if TQDM_AVAILABLE else lines
+
+        for line in iterator:
+            self._process_line(line, patterns)
+
+    def _read_file(self) -> List[str]:
+        """Read log file lines."""
+        with open(self.log_file, 'r', encoding='utf-8', errors='ignore') as f:
+            return f.readlines()
+
+    def _process_line(self, line: str, patterns: Dict[str, re.Pattern]):
+        """Process a single log line."""
+        # Track empty coverage
+        match = patterns['empty_coverage'].search(line)
+        if match:
+            program_sig = match.group(1)
+            queue_type = match.group(2).strip()
+            self.empty_coverage_by_queue[queue_type].append(program_sig)
+
+        # Track non-empty coverage
+        match = patterns['non_empty_coverage'].search(line)
+        if match:
+            program_sig = match.group(1)
+            queue_type = match.group(2).strip()
+            self.non_empty_coverage_by_queue[queue_type].append(program_sig)
+
+    def _generate_summary(self) -> Dict:
+        """Generate and print summary statistics."""
+        # Calculate totals
+        total_empty_executions = sum(len(programs) for programs in self.empty_coverage_by_queue.values())
+        total_non_empty_executions = sum(len(programs) for programs in self.non_empty_coverage_by_queue.values())
+        total_executions = total_empty_executions + total_non_empty_executions
+
+        print("SUMMARY STATISTICS")
+        print("=" * 80)
+        print(f"Total Empty Coverage Executions: {total_empty_executions}")
+        print(f"Total Non-Empty Coverage Executions: {total_non_empty_executions}")
+        print(f"Total Executions: {total_executions}")
+
+        if total_executions > 0:
+            overall_rate = (total_empty_executions / total_executions) * 100
+            print(f"Overall Empty Coverage Rate: {overall_rate:.2f}%")
+        print()
+
+        # Queue-specific analysis
+        print("QUEUE TYPE ANALYSIS")
+        print("=" * 80)
+        print(f"{'Queue Type':<20} {'Empty':<8} {'Total':<8} {'Rate':<8} {'Examples'}")
+        print("-" * 80)
+
+        summary = {
+            'total_empty_executions': total_empty_executions,
+            'total_non_empty_executions': total_non_empty_executions,
+            'total_executions': total_executions,
+            'overall_rate': (total_empty_executions / total_executions * 100) if total_executions > 0 else 0,
+            'queue_statistics': {}
+        }
+
+        # Get all queue types
+        all_queue_types = set(self.empty_coverage_by_queue.keys()) | set(self.non_empty_coverage_by_queue.keys())
+        queue_stats = []
+
+        for queue_type in all_queue_types:
+            empty_count = len(self.empty_coverage_by_queue[queue_type])
+            non_empty_count = len(self.non_empty_coverage_by_queue[queue_type])
+            total_count = empty_count + non_empty_count
+            rate = (empty_count / total_count * 100) if total_count > 0 else 0
+
+            queue_stats.append({
+                'queue_type': queue_type,
+                'empty_count': empty_count,
+                'non_empty_count': non_empty_count,
+                'total_count': total_count,
+                'rate': rate,
+                'examples': self.empty_coverage_by_queue[queue_type][:self.max_examples]
+            })
+
+        # Sort by empty count descending
+        queue_stats.sort(key=lambda x: x['empty_count'], reverse=True)
+
+        for stat in queue_stats:
+            # Format examples for display
+            if stat['examples']:
+                examples_str = ', '.join(stat['examples'][:self.max_examples])
+                if len(stat['examples']) > self.max_examples:
+                    examples_str += f", +{len(stat['examples'])-self.max_examples}"
+            else:
+                examples_str = "-"
+
+            print(f"{stat['queue_type']:<20} "
+                  f"{stat['empty_count']:<8} "
+                  f"{stat['total_count']:<8} "
+                  f"{stat['rate']:<7.1f}% "
+                  f"{examples_str}")
+
+            summary['queue_statistics'][stat['queue_type']] = stat
+
+        print()
+        print("INSIGHTS")
+        print("=" * 80)
+
+        # Find queues with highest empty rates
+        high_rate_queues = [q for q in queue_stats if q['rate'] > 50 and q['total_count'] > 10]
+        if high_rate_queues:
+            print("Queues with high empty coverage rates (>50% and >10 executions):")
+            for q in high_rate_queues[:5]:
+                print(f"  - {q['queue_type']}: {q['rate']:.1f}% ({q['empty_count']}/{q['total_count']})")
+        else:
+            print("No queues with high empty coverage rates found.")
+
+        print()
+        # Find queues with most empty coverage in absolute numbers
+        high_volume_queues = [q for q in queue_stats if q['empty_count'] > 100]
+        if high_volume_queues:
+            print("Queues with most empty coverage (>100 executions):")
+            for q in high_volume_queues[:5]:
+                print(f"  - {q['queue_type']}: {q['empty_count']} executions ({q['rate']:.1f}%)")
+        else:
+            print("No queues with high volume empty coverage found.")
+
+        return summary
+
+
+def main():
+    """Main function to run the debuglogger analysis."""
+    parser = argparse.ArgumentParser(
+        description="Analyze debuglogger.log to extract empty coverage statistics by queue type.",
+        formatter_class=argparse.RawDescriptionHelpFormatter,
+        epilog="""
+Examples:
+  python3 analyze_debuglogger.py debuglogger.log
+  python3 analyze_debuglogger.py debuglogger.log --max-examples 3
+        """
+    )
+
+    parser.add_argument("log_file", help="Path to the debuglogger.log file")
+    parser.add_argument("--max-examples", type=int, default=2,
+                       help="Maximum number of examples to show for each queue type (default: 2)")
+
+    args = parser.parse_args()
+
+    try:
+        analyzer = DebugLoggerAnalyzer(args.log_file, args.max_examples)
+        analyzer.analyze()
+    except Exception as e:
+        print(f"Error during analysis: {e}")
+        return 1
+
+    return 0
+
+
+if __name__ == "__main__":
+    exit(main())
