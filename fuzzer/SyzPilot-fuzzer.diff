+	case "replace":
+		if len(p.Calls) > 0 {
+			replaceLen = r.Intn(min(len(p.Calls), max(1, len(tmpl.Syscalls)))) + 1
+			insertIndex = r.Intn(len(p.Calls) - replaceLen + 1)
+		}
+	default: // prefix
+		insertIndex = 0
+	}
+	capacity := ctx.ncalls - (len(p.Calls) - replaceLen)
+	if capacity <= 0 {
+		return ctx.finishTemplateMutation(TemplateMutationNoCapacity, false)
+	}
+
+	// Analyze resources visible at the actual insertion point. Calls generated
+	// for the template are analyzed immediately, so later template calls can
+	// consume resources produced by earlier ones.
+	var insertionCall *Call
+	if insertIndex < len(p.Calls) {
+		insertionCall = p.Calls[insertIndex]
+	}
+	var allCalls []*Call
+	s := analyze(ctx.ct, ctx.corpus, p, insertionCall)
+	for _, scName := range tmpl.Syscalls {
+		meta, ok := p.Target.SyscallMap[scName]
+		if !ok || meta.Attrs.Disabled || meta.Attrs.NoGenerate {
+			continue
+		}
+		calls := r.generateParticularCall(s, meta)
+		for _, call := range calls {
+			allCalls = append(allCalls, call)
+			s.analyze(call)
+		}
+	}
+
+	if len(allCalls) == 0 {
+		return ctx.finishTemplateMutation(TemplateMutationGenerationFailed, false)
+	}
+	if !applyArgConstraints(allCalls, tmpl.ArgHints) {
+		discardGeneratedCalls(p.Target, allCalls)
+		return ctx.finishTemplateMutation(TemplateMutationConstraintFailed, false)
+	}
+
+	if len(allCalls) > capacity {
+		// Truncating generated calls can retain only resource prerequisites and
+		// discard the syscall named by the template. Reject the whole insertion
+		// so a successful mutation always represents the complete template.
+		discardGeneratedCalls(p.Target, allCalls)
+		return ctx.finishTemplateMutation(TemplateMutationTooLarge, false)
+	}
+
+	var anchor *Call
+	if insertIndex+replaceLen < len(p.Calls) {
+		anchor = p.Calls[insertIndex+replaceLen]
+	}
+	for index := 0; index < replaceLen; index++ {
+		p.RemoveCall(insertIndex)
+	}
+	p.insertBefore(anchor, allCalls)
+	return ctx.finishTemplateMutation(TemplateMutationSucceeded, true)
+}
+
+func (ctx *mutator) finishTemplateMutation(outcome TemplateMutationOutcome, succeeded bool) bool {
+	if ctx.opts.TemplateObserver != nil {
+		ctx.opts.TemplateObserver.ObserveTemplateMutation(outcome)
+	}
+	return succeeded
+}
+
+// selectTemplate selects a template weighted by priority.
+func (ctx *mutator) selectTemplate() *MutationTemplate {
+	r := ctx.r
+	if len(ctx.templates) == 0 {
+		return nil
+	}
+
+	totalPrio := 0.0
+	for i := range ctx.templates {
+		totalPrio += ctx.templates[i].Priority
+	}
+	if totalPrio <= 0 {
+		return &ctx.templates[r.Intn(len(ctx.templates))]
+	}
+
+	x := r.Float64() * totalPrio
+	cumulative := 0.0
+	for i := range ctx.templates {
+		cumulative += ctx.templates[i].Priority
+		if x <= cumulative {
+			return &ctx.templates[i]
+		}
+	}
+	return &ctx.templates[len(ctx.templates)-1]
+}
+
+// ValidateArgConstraint verifies that an external template may safely override
+// one top-level scalar syscall argument without violating syzkaller invariants.
+func ValidateArgConstraint(meta *Syscall, argIndex int, value uint64) error {
+	if meta == nil || argIndex < 0 || argIndex >= len(meta.Args) {
+		return fmt.Errorf("argument index is out of range")
+	}
+	field := meta.Args[argIndex]
+	if field.Dir(DirIn) == DirOut {
+		return fmt.Errorf("output arguments cannot be constrained")
+	}
+	valueFits := func(bitSize uint64) bool {
+		return bitSize == 64 || bitSize > 0 && value < uint64(1)<<bitSize
+	}
+	switch typ := field.Type.(type) {
+	case *IntType:
+		if !valueFits(typ.TypeBitSize()) {
+			return fmt.Errorf("integer value does not fit argument width")
+		}
+		if typ.Kind == IntRange && (value < typ.RangeBegin || value > typ.RangeEnd ||
+			typ.Align != 0 && (value-typ.RangeBegin)%typ.Align != 0) {
+			return fmt.Errorf("integer value is outside the declared range")
+		}
+	case *FlagsType:
+		if !valueFits(typ.TypeBitSize()) {
+			return fmt.Errorf("flags value does not fit argument width")
+		}
+	case *ConstType:
+		if typ.IsPad || value != typ.Val {
+			return fmt.Errorf("constant argument can only retain its declared value")
+		}
+	case *ProcType:
+		if value >= typ.ValuesPerProc {
+			return fmt.Errorf("per-process value is outside the declared range")
+		}
+	default:
+		return fmt.Errorf("argument type %T is not a supported scalar", field.Type)
+	}
+	return nil
+}
+
+// applyArgConstraints validates the complete hint set before changing any call.
+func applyArgConstraints(calls []*Call, hints []ArgConstraint) bool {
+	if len(hints) == 0 {
+		return true
+	}
+	for _, hint := range hints {
+		matched := false
+		for _, call := range calls {
+			if call == nil || call.Meta == nil || call.Meta.Name != hint.Syscall {
+				continue
+			}
+			if err := ValidateArgConstraint(call.Meta, hint.ArgIdx, hint.Value); err != nil ||
+				hint.ArgIdx >= len(call.Args) {
+				return false
+			}
+			if _, ok := call.Args[hint.ArgIdx].(*ConstArg); !ok {
+				return false
+			}
+			matched = true
+		}
+		if !matched {
+			return false
+		}
+	}
+	for _, hint := range hints {
+		for _, call := range calls {
+			if call.Meta.Name == hint.Syscall {
+				call.Args[hint.ArgIdx].(*ConstArg).Val = hint.Value
+			}
+		}
+	}
+	return true
+}
+
+func discardGeneratedCalls(target *Target, calls []*Call) {
+	discarded := &Prog{Target: target, Calls: calls}
+	for len(discarded.Calls) > 0 {
+		discarded.RemoveCall(0)
+	}
+}
