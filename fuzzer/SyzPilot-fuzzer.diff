+func TestLoadCatalogedGenericColdStartSeeds(t *testing.T) {
+	target, err := prog.GetTarget("linux", "amd64")
+	if err != nil {
+		t.Fatal(err)
+	}
+	seedDir, catalogPath := coldStartFixturePaths(t)
