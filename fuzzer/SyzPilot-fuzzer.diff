+func (recorder *templateMutationRecorder) ObserveTemplateMutation(outcome TemplateMutationOutcome) {
+	recorder.mu.Lock()
+	defer recorder.mu.Unlock()
+	recorder.outcomes = append(recorder.outcomes, outcome)
+	if outcome == TemplateMutationSucceeded && recorder.program != nil {
+		callNames := make([]string, 0, len(recorder.program.Calls))
+		for _, call := range recorder.program.Calls {
+			callNames = append(callNames, call.Meta.Name)
+		}
+		recorder.successCallSnapshots = append(
+			recorder.successCallSnapshots, callNames,
+		)
+	}
