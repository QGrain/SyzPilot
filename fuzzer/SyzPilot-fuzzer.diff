+func reachabilityObservationComplete(req *queue.Request, res *queue.Result) bool {
+	if req == nil || req.Prog == nil || res == nil || res.Status != queue.Success ||
+		res.Info == nil || len(res.Info.Calls) != len(req.Prog.Calls) {
