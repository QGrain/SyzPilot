+)
+
+func TestDirectedCorpusDisabledDoesNotRetainCandidates(t *testing.T) {
+	target, err := prog.GetTarget(targets.TestOS, targets.TestArch64Fuzz)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	nativeCorpus := corpus.NewCorpus(ctx)
+	fuzzer := NewFuzzer(ctx, &Config{
+		Corpus: nativeCorpus,
+	}, rand.New(rand.NewSource(1)), target)
+	seed := target.Generate(rand.NewSource(2), 1, target.DefaultChoiceTable())
+	fuzzer.AddDirectedCandidates([]Candidate{{Prog: seed}}, []string{seed.CallName(0)})
+	if fuzzer.directedCorpus != nil {
+		t.Fatal("disabled directed corpus was initialized")
+	}
+	if got := len(nativeCorpus.Programs()); got != 0 {
+		t.Fatalf("disabled directed retention changed native corpus size to %d", got)
+	}
+}
+
+func TestTruncatedPositiveObservationEntersDirectedCorpusOnly(t *testing.T) {
+	target, err := prog.GetTarget(targets.TestOS, targets.TestArch64Fuzz)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	fuzzer := NewFuzzer(ctx, &Config{
+		Corpus:   corpus.NewCorpus(ctx),
+		Coverage: true,
+		SyzPilotCfg: mgrconfig.SyzPilotCfg{
+			DumpDir:   t.TempDir(),
+			TargetPCs: []string{"0x81234567", "0x87654321"},
+			DirectedCorpus: mgrconfig.DirectedCorpusCfg{
+				Enable:                    true,
+				Capacity:                  8,
+				MutationProbability:       0.2,
+				AnchorPreserveProbability: 0.95,
+			},
+		},
+	}, rand.New(rand.NewSource(1)), target)
+	program := target.Generate(rand.NewSource(2), 1, target.DefaultChoiceTable())
+	request := &queue.Request{
+		Prog:     program,
+		ExecOpts: flatrpc.ExecOpts{ExecFlags: flatrpc.ExecFlagCollectCover},
+	}
+	result := &queue.Result{
+		Status: queue.Success,
+		Info: &flatrpc.ProgInfo{Calls: []*flatrpc.CallInfo{{
+			Flags: flatrpc.CallFlagExecuted | flatrpc.CallFlagFinished |
+				flatrpc.CallFlagCoverageOverflow,
+			Cover: []uint64{fuzzer.TargetAddrVals[0]},
+		}}},
+	}
+	if !fuzzer.processResult(request, result, 0, 0) {
+		t.Fatal("complete execution was unexpectedly requeued")
+	}
+	if got := fuzzer.directedCorpus.len(); got != 1 {
+		t.Fatalf("directed corpus size = %d, want 1", got)
+	}
+	if got := fuzzer.statReachabilityTruncated.Val(); got != 1 {
+		t.Fatalf("truncated label count = %d, want 1", got)
+	}
+	if got := len(fuzzer.Config.Corpus.Programs()); got != 0 {
+		t.Fatalf("positive retention bypassed native signal admission: %d programs", got)
+	}
+}
+
+func TestDirectedCorpusConcurrentAccess(t *testing.T) {
+	target, err := prog.GetTarget(targets.TestOS, targets.TestArch64Fuzz)
+	if err != nil {
+		t.Fatal(err)
+	}
+	programs := generateDistinctPrograms(t, target, 8)
+	corpus := newDirectedCorpus(4)
+	var wait sync.WaitGroup
+	for worker := 0; worker < 8; worker++ {
+		worker := worker
+		wait.Add(1)
+		go func() {
+			defer wait.Done()
+			rnd := rand.New(rand.NewSource(int64(worker + 1)))
+			for iteration := 0; iteration < 100; iteration++ {
+				program := programs[(worker+iteration)%len(programs)]
+				anchor := program.Calls[0].Meta.Name
+				corpus.save(program, []string{anchor}, iteration%4)
+				corpus.replaceAnchors([]string{anchor})
+				corpus.choose(rnd)
+				corpus.programs()
+			}
+		}()
+	}
+	wait.Wait()
+	if got := corpus.len(); got != 4 {
+		t.Fatalf("concurrent bounded corpus size = %d, want 4", got)
+	}
+}
+
+func TestDirectedCandidateFeedsNormalMutationWithoutNativeCorpusAdmission(t *testing.T) {
+	target, err := prog.GetTarget(targets.TestOS, targets.TestArch64Fuzz)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	nativeCorpus := corpus.NewCorpus(ctx)
+	fuzzer := NewFuzzer(ctx, &Config{
+		Corpus:   nativeCorpus,
+		Coverage: true,
+		SyzPilotCfg: mgrconfig.SyzPilotCfg{
+			DumpDir:   t.TempDir(),
+			TargetPCs: []string{"0x1000"},
+			DirectedCorpus: mgrconfig.DirectedCorpusCfg{
+				Enable:                    true,
+				Capacity:                  8,
+				MutationProbability:       1,
+				AnchorPreserveProbability: 1,
+			},
+		},
+	}, rand.New(rand.NewSource(1)), target)
+	seed := target.Generate(rand.NewSource(2), 3, target.DefaultChoiceTable())
+	anchor := seed.Calls[0].Meta.Name
+	fuzzer.AddDirectedCandidates([]Candidate{{Prog: seed}}, []string{anchor})
+
+	if got := len(nativeCorpus.Programs()); got != 0 {
+		t.Fatalf("directed retention changed native corpus size to %d", got)
+	}
+	request := mutateProgRequest(fuzzer, rand.New(rand.NewSource(3)))
+	if request == nil || request.Prog == nil {
+		t.Fatal("directed corpus did not feed the normal mutation path")
+	}
+	if !containsAnySyscall(request.Prog, []string{anchor}) {
+		t.Fatalf("fully preserved mutation lost anchor %q:\n%s", anchor, request.Prog)
+	}
+	if got := fuzzer.statDirectedCorpusMutations.Val(); got != 1 {
+		t.Fatalf("directed mutation count = %d, want 1", got)
+	}
+}
+
+func TestDirectedCorpusDeduplicatesAndKeepsDeeperPrograms(t *testing.T) {
+	target, err := prog.GetTarget(targets.TestOS, targets.TestArch64Fuzz)
+	if err != nil {
+		t.Fatal(err)
+	}
+	programs := generateDistinctPrograms(t, target, 3)
+	corpus := newDirectedCorpus(2)
+	anchor := programs[0].Calls[0].Meta.Name
+	if delta := corpus.save(programs[0], []string{anchor, "not-present"}, 3); delta != 1 {
+		t.Fatalf("first save size delta = %d, want 1", delta)
+	}
+	if delta := corpus.save(programs[0], []string{anchor}, 4); delta != 0 {
+		t.Fatalf("duplicate save size delta = %d, want 0", delta)
+	}
+	if corpus.entries[0].depth != 4 || len(corpus.entries[0].anchors) != 1 {
+		t.Fatalf("duplicate metadata was not merged: %+v", corpus.entries[0])
+	}
+	var secondAnchor string
+	for _, call := range programs[0].Calls {
+		if call.Meta.Name != anchor {
+			secondAnchor = call.Meta.Name
+			break
+		}
+	}
+	if secondAnchor != "" {
+		corpus.replaceAnchors([]string{secondAnchor})
+		if _, ok := corpus.entries[0].anchors[secondAnchor]; !ok {
+			t.Fatalf("later guidance did not attach anchor %q", secondAnchor)
+		}
+		if _, ok := corpus.entries[0].anchors[anchor]; ok {
+			t.Fatalf("later guidance retained stale anchor %q", anchor)
+		}
+		corpus.replaceAnchors(nil)
+		if len(corpus.entries[0].anchors) != 0 {
+			t.Fatalf("cleared guidance retained anchors: %v", corpus.entries[0].anchors)
+		}
+	}
+	corpus.save(programs[1], nil, 2)
+	corpus.save(programs[2], nil, 1)
+	if corpus.len() != 2 {
+		t.Fatalf("bounded corpus size = %d, want 2", corpus.len())
+	}
+	weakDigest := sha256.Sum256(programs[2].Serialize())
+	if _, ok := corpus.index[weakDigest]; ok {
+		t.Fatal("weaker target evidence evicted a deeper program")
+	}
+	corpus.save(programs[2], nil, 2)
+	if _, ok := corpus.index[weakDigest]; !ok {
+		t.Fatal("equally deep newer program did not replace the oldest peer")
+	}
+}
+
+func TestMutatePreservingAnchorRetriesAndFallsBack(t *testing.T) {
+	target, err := prog.GetTarget(targets.TestOS, targets.TestArch64Fuzz)
+	if err != nil {
+		t.Fatal(err)
+	}
+	programs := generateDistinctSingleCallPrograms(t, target, 2)
+	source, withoutAnchor := programs[0], programs[1]
+	anchor := source.Calls[0].Meta.Name
+
+	calls := 0
+	mutated, retries, fallback := mutatePreservingAnchor(
+		source, []string{anchor}, withoutAnchor.Clone(), func() *prog.Prog {
+			calls++
+			return source.Clone()
+		},
+	)
+	if calls != 1 || retries != 1 || fallback || !containsAnySyscall(mutated, []string{anchor}) {
+		t.Fatalf("anchor retry result: calls=%d retries=%d fallback=%v program=%s",
+			calls, retries, fallback, mutated)
+	}
+
+	mutated, retries, fallback = mutatePreservingAnchor(
+		source, []string{anchor}, withoutAnchor.Clone(), func() *prog.Prog {
+			return withoutAnchor.Clone()
+		},
+	)
+	if retries != 3 || !fallback || !containsAnySyscall(mutated, []string{anchor}) {
+		t.Fatalf("anchor fallback result: retries=%d fallback=%v program=%s",
+			retries, fallback, mutated)
+	}
+}
+
+func generateDistinctPrograms(t *testing.T, target *prog.Target, count int) []*prog.Prog {
+	t.Helper()
+	programs := make([]*prog.Prog, 0, count)
+	seen := make(map[[sha256.Size]byte]bool)
+	for seed := int64(1); len(programs) < count && seed < 1000; seed++ {
+		program := target.Generate(rand.NewSource(seed), 3, target.DefaultChoiceTable())
+		digest := sha256.Sum256(program.Serialize())
+		if !seen[digest] {
+			seen[digest] = true
+			programs = append(programs, program)
+		}
+	}
+	if len(programs) != count {
+		t.Fatalf("generated %d distinct programs, want %d", len(programs), count)
+	}
+	return programs
+}
+
+func generateDistinctSingleCallPrograms(t *testing.T, target *prog.Target, count int) []*prog.Prog {
+	t.Helper()
+	programs := make([]*prog.Prog, 0, count)
+	seenCalls := make(map[string]bool)
+	for seed := int64(1); len(programs) < count && seed < 1000; seed++ {
+		program := target.Generate(rand.NewSource(seed), 1, target.DefaultChoiceTable())
+		name := program.Calls[0].Meta.Name
+		if !seenCalls[name] {
+			seenCalls[name] = true
+			programs = append(programs, program)
+		}
+	}
+	if len(programs) != count {
+		t.Fatalf("generated %d distinct single-call programs, want %d", len(programs), count)
+	}
+	return programs
+}
