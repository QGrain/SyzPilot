+func (fuzzer *Fuzzer) dumpProgAndCover(
+	req *queue.Request, cov cover.Cover, reachability []bool,
+) (err error) {
+	prog := req.Prog
+	if prog == nil || len(reachability) == 0 {
+		return nil
+	}
+	targetReach := reachability[len(reachability)-1]
+	if !targetReach && !fuzzer.Config.SyzPilotCfg.EnableDump {
+		return nil
+	}
+	fuzzer.DumpMu.Lock()
+	defer fuzzer.DumpMu.Unlock()
+	start := time.Now()
+
+	if targetReach {
+		progBytes := prog.Serialize()
+		sig := hash.String(progBytes)
+		dir := filepath.Join(fuzzer.Config.SyzPilotCfg.DumpDir, fuzzer.TargetAddrStrs[len(fuzzer.TargetAddrStrs)-1])
+		err = fuzzer.writeProgAndCoverToDir(dir, sig, progBytes, cov)
+		if err != nil {
+			return err
+		}
+	}
+
+	if !fuzzer.Config.SyzPilotCfg.EnableDump {
+		return nil
+	}
+
+	// Get the signature of the program.
+	progBytes := prog.Serialize()
+	sig := hash.String(progBytes)
+
+	// Log the operation name of the queue that generated the empty coverage.
+	// Get queue type for statistics
+	var queueType string
+	if req != nil && req.Stat != nil {
+		queueType = req.Stat.Name()
+	} else {
+		queueType = "unknown"
+	}
+	if len(cov) == 0 {
+		debuglogger.Log(false, "Empty coverage for program %s from queue: %s", sig, queueType)
+		return nil // do not dump if the coverage is empty
+	} else {
+		debuglogger.Log(false, "Non-empty coverage for program %s from queue: %s", sig, queueType)
+	}
+
+	err = fuzzer.writeProgAndCoverToDir(fuzzer.Config.SyzPilotCfg.DumpDir, sig, progBytes, cov)
+	if err != nil {
+		return err
+	}
+	duration := time.Since(start)
+	debuglogger.Log(false, "dumpProgAndCover() took %vms", duration.Milliseconds())
+	return nil
+}
