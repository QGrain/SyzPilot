+// MutateOpts returns mutation options with templates if available.
+func (fuzzer *Fuzzer) MutateOpts() prog.MutateOpts {
+	opts := prog.DefaultMutateOpts
+	opts.TemplateObserver = &fuzzer.Stats
+	fuzzer.guidanceMu.RLock()
+	templates := append([]prog.MutationTemplate(nil), fuzzer.guidanceTemplates...)
+	fuzzer.guidanceMu.RUnlock()
+	if len(templates) > 0 && fuzzer.Config.SyzPilotCfg.TemplateInsertWeight > 0 {
+		opts.TemplateInsertWeight = fuzzer.Config.SyzPilotCfg.TemplateInsertWeight
+		opts.Templates = templates
+	}
+	return opts
+}
