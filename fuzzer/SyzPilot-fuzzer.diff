+		t.Fatal("tampered seed set was accepted")
+	}
+
+	symlinkDir := t.TempDir()
+	if err := os.Symlink(
+		filepath.Join(seedDir, "syz_mount_image_f2fs_0"),
+		filepath.Join(symlinkDir, "syz_mount_image_f2fs_0"),
+	); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := loadTrustedColdStartSeeds(symlinkDir, tamperedCatalog, target); err == nil {
+		t.Fatal("symlinked seed was accepted")
+	}
+
+	duplicateDir := t.TempDir()
+	for _, name := range []string{"duplicate_a", "duplicate_b"} {
