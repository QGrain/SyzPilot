+func TestNextFiltersOnceAndCompletesWaitingRequest(t *testing.T) {
+	executionStat := stat.New("exec gen", "rfilter test executions")
+	filtered := testRequest(executionStat)
+	kept := testRequest(executionStat)
+	var callbackCalls atomic.Int64
+	filtered.OnDone(func(*queue.Request, *queue.Result) bool {
+		callbackCalls.Add(1)
+		return true
+	})
+
+	var calls atomic.Int64
+	predict := predictorFunc(func([][]byte) ([]map[string]float64, []error) {
+		if calls.Add(1) == 1 {
+			return []map[string]float64{{"Unreachable": 1, "Reach_Func1": 0}}, []error{nil}
+		}
+		return []map[string]float64{{"Unreachable": 0, "Reach_Func1": 1}}, []error{nil}
+	})
+	source := NewRFSource(&testSource{requests: []*queue.Request{filtered, kept}}, testConfig(), predict)
+	defer source.Close()
+
+	if got := source.Next(); got != kept {
+		t.Fatalf("Next() returned %p, want kept request %p", got, kept)
+	}
+	result := filtered.Wait(context.Background())
+	if result.Status != queue.Filtered || !errors.Is(result.Err, ErrReachabilityFiltered) {
+		t.Fatalf("filtered result = %+v, want reachability-filtered result", result)
+	}
+	if result.Stop() {
+		t.Fatal("a filtered execution must not stop the containing fuzzing job")
+	}
+	if callbackCalls.Load() != 0 {
+		t.Fatalf("filtered request ran %d execution callbacks", callbackCalls.Load())
+	}
+	if executionStat.Val() != 0 {
+		t.Fatalf("filtered request incremented execution stat to %d", executionStat.Val())
+	}
+	if source.GetTotalCnt() != 2 || source.GetFilteredCnt() != 1 {
+		t.Fatalf("counts = total %d filtered %d, want 2/1",
+			source.GetTotalCnt(), source.GetFilteredCnt())
+	}
+}
