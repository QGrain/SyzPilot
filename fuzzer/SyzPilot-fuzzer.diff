diff --git a/pkg/syzpilotlib/Makefile b/pkg/syzpilotlib/Makefile
new file mode 100644
index 0000000..94584d9
--- /dev/null
+++ b/pkg/syzpilotlib/Makefile
@@ -0,0 +1,128 @@
+LOG_PREFIX := [SyzPilot]
+GO ?= go
+PROTOC ?= protoc
+PROTOC_GEN_GO_VERSION := v1.36.6
+PROTOC_GEN_GO_GRPC_VERSION := v1.5.1
+
+# Resolve the directory containing this Makefile.
+SYZPILOTLIB_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
+COLLECTORLIB_DIR := $(SYZPILOTLIB_DIR)/collectorlib
+PREDICTORLIB_DIR := $(SYZPILOTLIB_DIR)/predictorlib
+TRANSMISSION_PROTO := $(SYZPILOTLIB_DIR)/transmission.proto
+INFERENCE_PROTO := $(SYZPILOTLIB_DIR)/inference.proto
+
+# Locate the Git repository that contains this Makefile.
+REPO_ROOT := $(shell git -C "$(SYZPILOTLIB_DIR)" rev-parse --show-toplevel 2>/dev/null)
+
+# Fall back to the expected source-tree layout when Git metadata is unavailable,
+# for example when building from an extracted source archive.
+ifeq ($(strip $(REPO_ROOT)),)
+REPO_ROOT := $(abspath $(SYZPILOTLIB_DIR)/../..)
+endif
+
+TOOLS_ROOT := $(REPO_ROOT)/bin/syzpilot-tools
+
+PROTOC_GEN_GO := \
+	$(TOOLS_ROOT)/protoc-gen-go/$(PROTOC_GEN_GO_VERSION)/protoc-gen-go
+
+PROTOC_GEN_GO_GRPC := \
+	$(TOOLS_ROOT)/protoc-gen-go-grpc/$(PROTOC_GEN_GO_GRPC_VERSION)/protoc-gen-go-grpc
+
+GOOGLEAPIS_REPO := https://github.com/googleapis/googleapis.git
+GOOGLEAPIS_COMMIT := 0e42ad0c17e1
+GOOGLEAPIS_DIR := $(TOOLS_ROOT)/googleapis/$(GOOGLEAPIS_COMMIT)
+GOOGLEAPIS_READY := $(GOOGLEAPIS_DIR)/.syzpilot-ready
+
+.PHONY: all tools check-protoc collectorlib predictorlib clean help
+
+all: collectorlib predictorlib
+
+$(GOOGLEAPIS_READY):
+	@echo "$(LOG_PREFIX) Preparing googleapis at revision $(GOOGLEAPIS_COMMIT)..."
+	@mkdir -p "$(dir $(GOOGLEAPIS_DIR))"
+	@if [ -e "$(GOOGLEAPIS_DIR)" ] && \
+		[ ! -d "$(GOOGLEAPIS_DIR)/.git" ]; then \
+			echo "$(LOG_PREFIX) error: $(GOOGLEAPIS_DIR) exists but is not a Git repository"; \
+			echo "$(LOG_PREFIX) remove the incomplete directory and retry"; \
+			exit 1; \
+	fi
+	@if [ ! -d "$(GOOGLEAPIS_DIR)/.git" ]; then \
+		echo "$(LOG_PREFIX) Cloning googleapis..."; \
+		git clone --filter=blob:none --no-checkout "$(GOOGLEAPIS_REPO)" "$(GOOGLEAPIS_DIR)"; \
+	fi
+	git -C "$(GOOGLEAPIS_DIR)" checkout --detach "$(GOOGLEAPIS_COMMIT)"
+	@touch "$@"
+
+check-protoc:
+	@command -v $(PROTOC) >/dev/null 2>&1 || { \
+		echo "$(LOG_PREFIX) error: protoc is not installed"; \
+		echo "$(LOG_PREFIX) Ubuntu/Debian: apt-get install protobuf-compiler libprotobuf-dev"; \
+		exit 1; \
+	}
+
+tools: $(PROTOC_GEN_GO) $(PROTOC_GEN_GO_GRPC)
+
+$(PROTOC_GEN_GO):
+	@echo "$(LOG_PREFIX) Installing protoc-gen-go $(PROTOC_GEN_GO_VERSION)..."
+	@mkdir -p "$(@D)"
+	GOBIN="$(@D)" $(GO) install \
+		google.golang.org/protobuf/cmd/protoc-gen-go@$(PROTOC_GEN_GO_VERSION)
+
+$(PROTOC_GEN_GO_GRPC):
+	@echo "$(LOG_PREFIX) Installing protoc-gen-go-grpc $(PROTOC_GEN_GO_GRPC_VERSION)..."
+	@mkdir -p "$(@D)"
+	GOBIN="$(@D)" $(GO) install \
+		google.golang.org/grpc/cmd/protoc-gen-go-grpc@$(PROTOC_GEN_GO_GRPC_VERSION)
+
+collectorlib: check-protoc $(PROTOC_GEN_GO) $(PROTOC_GEN_GO_GRPC)
+	@echo "$(LOG_PREFIX) Generating Go protobuf code for collector client..."
+	mkdir -p "$(COLLECTORLIB_DIR)"
+	$(PROTOC) \
+		-I "$(SYZPILOTLIB_DIR)" \
+		--plugin=protoc-gen-go="$(PROTOC_GEN_GO)" \
+		--plugin=protoc-gen-go-grpc="$(PROTOC_GEN_GO_GRPC)" \
+		--go_out="$(COLLECTORLIB_DIR)" \
+		--go_opt=paths=source_relative \
+		--go-grpc_out="$(COLLECTORLIB_DIR)" \
+		--go-grpc_opt=paths=source_relative \
+		"$(TRANSMISSION_PROTO)"
+	@echo "$(LOG_PREFIX) Generated collector client code in $(COLLECTORLIB_DIR)/"
+
+predictorlib: $(GOOGLEAPIS_READY) check-protoc $(PROTOC_GEN_GO) $(PROTOC_GEN_GO_GRPC)
+	@echo "$(LOG_PREFIX) Generating Go protobuf code for predictor client..."
+	mkdir -p "$(PREDICTORLIB_DIR)"
+	$(PROTOC) \
+		-I "$(GOOGLEAPIS_DIR)" \
+		-I "$(SYZPILOTLIB_DIR)" \
+		--plugin=protoc-gen-go="$(PROTOC_GEN_GO)" \
+		--plugin=protoc-gen-go-grpc="$(PROTOC_GEN_GO_GRPC)" \
+		--go_out="$(PREDICTORLIB_DIR)" \
+		--go_opt=paths=source_relative,Minference.proto=github.com/google/syzkaller/pkg/syzpilotlib/predictorlib \
+		--go-grpc_out="$(PREDICTORLIB_DIR)" \
+		--go-grpc_opt=paths=source_relative,Minference.proto=github.com/google/syzkaller/pkg/syzpilotlib/predictorlib \
+		--experimental_allow_proto3_optional \
+		"$(INFERENCE_PROTO)"
+	@echo "$(LOG_PREFIX) Generated predictor client code in $(PREDICTORLIB_DIR)/"
+
+## Generate Python protobuf code for the collector server (build on SyzPilot-brain side)
+# collectorserver:
+# 	@echo "$(LOG_PREFIX) Generating Python protobuf code for collector server..."
+# 	mkdir -p collectorserver
+# 	python -m grpc_tools.protoc -I. \
+# 		--python_out=collectorserver \
+# 		--grpc_python_out=collectorserver \
+# 		transmission.proto
+# 	@echo "$(LOG_PREFIX) Generated Python server code in collectorserver/"
+
+# clean generated files
+clean:
+	rm -rf "$(COLLECTORLIB_DIR)" "$(PREDICTORLIB_DIR)" "$(TOOLS_ROOT)"
+
+help:
+	@echo "$(LOG_PREFIX) Available targets:"
+	@echo "  all           - Generate all protobuf code"
+	@echo "  tools         - Install pinned protobuf generators"
+	@echo "  collectorlib  - Generate collector client code"
+	@echo "  predictorlib  - Generate predictor client code"
+	@echo "  clean         - Remove generated code and cached build tools"
+	@echo "  help          - Show this help message"
diff --git a/pkg/syzpilotlib/collector/balancequeue.go b/pkg/syzpilotlib/collector/balancequeue.go
new file mode 100644
index 0000000..0144936
--- /dev/null
+++ b/pkg/syzpilotlib/collector/balancequeue.go
@@ -0,0 +1,86 @@
+package collector
+
+import (
+	"math"
+	"math/rand"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/google/syzkaller/pkg/syzpilotlib"
+)
+
+// SampleBalancer
+type SampleBalancer struct {
+	mu                  sync.Mutex
+	maxNegativeRatio    float64 // maximum negative sample ratio
+	baseSamplingRate    float64 // base sampling rate
+	minSamplingRate     float64 // minimum sampling rate
+	samplingDecayFactor float64 // sampling rate decay factor
+	rng                 *rand.Rand
+}
+
+// NewSampleBalancer: create a sample balancer
+func NewSampleBalancer() *SampleBalancer {
+	return &SampleBalancer{
+		maxNegativeRatio:    10.0,  // maximum negative sample ratio is 10:1
+		baseSamplingRate:    0.1,   // base sampling rate is 10%
+		minSamplingRate:     0.001, // minimum sampling rate is 0.1%
+		samplingDecayFactor: 0.96,  // sampling rate decays by 4% each time
+		rng:                 rand.New(rand.NewSource(time.Now().UnixNano())),
+	}
+}
+
+// ShouldKeepSample: check if the sample should be kept
+func (sb *SampleBalancer) ShouldKeepSample(labels []bool, stats *CollectorStats) bool {
+	sb.mu.Lock()
+	defer sb.mu.Unlock()
+
+	class, valid := syzpilotlib.OneHotLabelClass(labels)
+	if !valid {
+		return false
+	}
+
+	// Always keep reached classes. Class 0 is explicitly Unreachable and is
+	// balanced as a negative sample.
+	if class > 0 {
+		return true
+	}
+
+	return sb.shouldKeepNegativeSample(stats)
+}
+
+// shouldKeepNegativeSample: negative sample sampling strategy
+func (sb *SampleBalancer) shouldKeepNegativeSample(stats *CollectorStats) bool {
+	// if there are no samples, keep some negative samples initially
+	if atomic.LoadInt64(&stats.TotalSamples) == 0 {
+		return sb.rng.Float64() < sb.baseSamplingRate
+	}
+
+	// if there are positive samples, sample according to the balance ratio
+	negativeSamples := atomic.LoadInt64(&stats.NegativeSamples)
+	positiveSamples := atomic.LoadInt64(&stats.PositiveSamples)
+	if positiveSamples > 0 {
+		currentNegativeRatio := float64(negativeSamples) / float64(positiveSamples)
+
+		// if the negative sample ratio is too high, lower the sampling rate
+		if currentNegativeRatio >= sb.maxNegativeRatio {
+			return sb.rng.Float64() < sb.minSamplingRate
+		} else if currentNegativeRatio > 1.0 {
+			// cubic decay
+			samplingRate := 1.0 / math.Pow(currentNegativeRatio, 3)
+			return sb.rng.Float64() < samplingRate
+		} else {
+			return true // keep normally
+		}
+	}
+
+	// if there has been no positive samples for a long time, gradually lower the sampling rate for negative samples
+	lastPositive := atomic.LoadInt64(&stats.LastPositiveUnixNano)
+	timeSinceLastPositive := time.Since(time.Unix(0, lastPositive))
+	decayMinutes := int(timeSinceLastPositive.Minutes())
+	adjustedRate := sb.baseSamplingRate * math.Pow(sb.samplingDecayFactor, float64(decayMinutes))
+	adjustedRate = math.Max(adjustedRate, sb.minSamplingRate)
+
+	return sb.rng.Float64() < adjustedRate
+}
diff --git a/pkg/syzpilotlib/collector/balancequeue_test.go b/pkg/syzpilotlib/collector/balancequeue_test.go
new file mode 100644
index 0000000..7e2457c
--- /dev/null
+++ b/pkg/syzpilotlib/collector/balancequeue_test.go
@@ -0,0 +1,30 @@
+package collector
+
+import (
+	"math/rand"
+	"testing"
+)
+
+func TestSampleBalancerUsesExplicitUnreachableClass(t *testing.T) {
+	balancer := NewSampleBalancer()
+	balancer.minSamplingRate = 0
+	balancer.rng = rand.New(rand.NewSource(1))
+	stats := &CollectorStats{
+		TotalSamples:    11,
+		PositiveSamples: 1,
+		NegativeSamples: 10,
+	}
+
+	if balancer.ShouldKeepSample([]bool{true, false, false}, stats) {
+		t.Fatal("class 0 must follow negative sampling")
+	}
+	if !balancer.ShouldKeepSample([]bool{false, true, false}, stats) {
+		t.Fatal("a reached class must always be kept")
+	}
+	if balancer.ShouldKeepSample([]bool{false, false, false}, stats) {
+		t.Fatal("an all-zero label must be rejected")
+	}
+	if balancer.ShouldKeepSample([]bool{true, true, false}, stats) {
+		t.Fatal("a multi-hot label must be rejected")
+	}
+}
diff --git a/pkg/syzpilotlib/collector/collector.go b/pkg/syzpilotlib/collector/collector.go
new file mode 100644
index 0000000..e5763e4
--- /dev/null
+++ b/pkg/syzpilotlib/collector/collector.go
@@ -0,0 +1,1359 @@
+package collector
+
+import (
+	"container/list"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/google/syzkaller/pkg/debuglogger"
+	"github.com/google/syzkaller/pkg/hash"
+	"github.com/google/syzkaller/pkg/log"
+	"github.com/google/syzkaller/pkg/syzpilotlib"
+	pb "github.com/google/syzkaller/pkg/syzpilotlib/collectorlib"
+	"github.com/google/syzkaller/prog"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/credentials/insecure"
+	"google.golang.org/protobuf/proto"
+)
+
+type Config struct {
+	ServerAddr            string
+	BufferSize            int
+	BufferWALCheckpoint   int
+	FlushInterval         time.Duration
+	AckTimeout            time.Duration
+	CloseTimeout          time.Duration
+	RetryInterval         time.Duration
+	TargetAddrs           []uint64
+	MaxBatchSize          int
+	SpoolDir              string
+	SchemaID              string
+	SignatureCacheEntries int
+}
+
+type trainingStream interface {
+	Send(*pb.TrainingBatch) error
+	Recv() (*pb.BatchResponse, error)
+	CloseSend() error
+}
+
+// MLDataCollector persists batches before a single sender goroutine transfers
+// them. The Receiver acknowledgement is the commit point for deleting the WAL.
+type MLDataCollector struct {
+	serverAddr    string
+	maxBatchSize  int
+	ackTimeout    time.Duration
+	closeTimeout  time.Duration
+	retryInterval time.Duration
+	spoolDir      string
+	schemaID      string
+	targetAddrs   []uint64
+
+	connMu sync.RWMutex
+	conn   *grpc.ClientConn
+	client pb.MLTrainingDataServiceClient
+	// streamFactory is used by tests. Production opens a fresh bounded stream
+	// per attempt so Send, Recv, and CloseSend always have one owner.
+	streamFactory func(context.Context) (trainingStream, error)
+
+	buffer        []*pb.TrainingExample
+	bufferBatchID int64
+	bufferSize    int
+	// bufferWALCheckpoint controls how often the growing active buffer is
+	// rewritten and synced. A value of 1 preserves return-is-durable semantics.
+	// Larger values are an explicit experimental throughput/recovery tradeoff:
+	// abrupt process loss can discard at most value-1 accepted tail samples.
+	bufferWALCheckpoint int
+	bufferMu            sync.Mutex
+	flushInterval       time.Duration
+	lastFlush           time.Time
+	enqueueMu           sync.Mutex
+
+	pending   []*pb.TrainingBatch
+	pendingMu sync.Mutex
+
+	stats      CollectorStats
+	balancer   *SampleBalancer
+	signatures *signatureCache
+
+	ctx           context.Context
+	cancel        context.CancelFunc
+	closed        int32
+	wakeSender    chan struct{}
+	closeDone     chan struct{}
+	closeFinished chan struct{}
+	closeDeadline int64
+	closeErrMu    sync.Mutex
+	closeErr      error
+}
+
+type CollectorStats struct {
+	TotalSamples         int64
+	PositiveSamples      int64
+	NegativeSamples      int64
+	BatchID              int64
+	SentBatches          int64
+	RejectedBatches      int64
+	LastPositiveUnixNano int64
+	DuplicateSamples     int64
+	LabelUpgradeSamples  int64
+}
+
+type signatureObservation struct {
+	signature string
+	class     int
+}
+
+// signatureCache bounds cross-batch duplicate suppression. Receiver-side
+// canonicalization remains authoritative because this cache is intentionally
+// finite and only reconstructed from locally durable, unacknowledged data.
+type signatureCache struct {
+	capacity int
+	entries  map[string]*list.Element
+	recency  *list.List
+}
+
+func newSignatureCache(capacity int) *signatureCache {
+	return &signatureCache{
+		capacity: capacity,
+		entries:  make(map[string]*list.Element, capacity),
+		recency:  list.New(),
+	}
+}
+
+func (cache *signatureCache) lookup(signature string) (int, bool) {
+	element := cache.entries[signature]
+	if element == nil {
+		return 0, false
+	}
+	cache.recency.MoveToFront(element)
+	return element.Value.(signatureObservation).class, true
+}
+
+func (cache *signatureCache) record(signature string, class int) {
+	if element := cache.entries[signature]; element != nil {
+		element.Value = signatureObservation{signature: signature, class: class}
+		cache.recency.MoveToFront(element)
+		return
+	}
+	element := cache.recency.PushFront(signatureObservation{
+		signature: signature,
+		class:     class,
+	})
+	cache.entries[signature] = element
+	if cache.recency.Len() <= cache.capacity {
+		return
+	}
+	oldest := cache.recency.Back()
+	delete(cache.entries, oldest.Value.(signatureObservation).signature)
+	cache.recency.Remove(oldest)
+}
+
+func (cache *signatureCache) remove(signature string) {
+	element := cache.entries[signature]
+	if element == nil {
+		return
+	}
+	delete(cache.entries, signature)
+	cache.recency.Remove(element)
+}
+
+type rejectedBatchRecord struct {
+	SchemaVersion int    `json:"schema_version"`
+	BatchID       int64  `json:"batch_id"`
+	Status        string `json:"status"`
+	Message       string `json:"message"`
+	RejectedAt    string `json:"rejected_at"`
+	PayloadSHA256 string `json:"payload_sha256"`
+	BatchProto    []byte `json:"batch_proto"`
+}
+
+func NewDataCollector(parent context.Context, cfg *Config) (*MLDataCollector, error) {
+	if cfg.BufferSize <= 0 {
+		cfg.BufferSize = 200
+	}
+	if cfg.BufferWALCheckpoint <= 0 {
+		cfg.BufferWALCheckpoint = 1
+	}
+	if cfg.FlushInterval <= 0 {
+		cfg.FlushInterval = 30 * time.Minute
+	}
+	if cfg.AckTimeout <= 0 {
+		cfg.AckTimeout = 15 * time.Second
+	}
+	if cfg.CloseTimeout <= 0 {
+		cfg.CloseTimeout = 30 * time.Second
+	}
+	if cfg.CloseTimeout < cfg.AckTimeout {
+		return nil, fmt.Errorf("collector close timeout %s is shorter than ack timeout %s",
+			cfg.CloseTimeout, cfg.AckTimeout)
+	}
+	if cfg.RetryInterval <= 0 {
+		cfg.RetryInterval = 5 * time.Second
+	}
+	if cfg.MaxBatchSize <= 0 {
+		cfg.MaxBatchSize = 300 * 1024 * 1024
+	}
+	if cfg.SignatureCacheEntries <= 0 {
+		cfg.SignatureCacheEntries = 65536
+	}
+	if cfg.SpoolDir == "" {
+		return nil, fmt.Errorf("collector spool directory is required")
+	}
+	if cfg.SchemaID == "" {
+		return nil, fmt.Errorf("collector label schema ID is required")
+	}
+	if err := os.MkdirAll(cfg.SpoolDir, 0o750); err != nil {
+		return nil, fmt.Errorf("failed to create collector spool: %w", err)
+	}
+	if err := ensureSpoolSchema(cfg.SpoolDir, cfg.SchemaID); err != nil {
+		return nil, err
+	}
+
+	collectorCtx, cancel := context.WithCancel(context.Background())
+	collector := &MLDataCollector{
+		serverAddr:          cfg.ServerAddr,
+		maxBatchSize:        cfg.MaxBatchSize,
+		ackTimeout:          cfg.AckTimeout,
+		closeTimeout:        cfg.CloseTimeout,
+		retryInterval:       cfg.RetryInterval,
+		spoolDir:            cfg.SpoolDir,
+		schemaID:            cfg.SchemaID,
+		targetAddrs:         cfg.TargetAddrs,
+		buffer:              make([]*pb.TrainingExample, 0, cfg.BufferSize),
+		bufferSize:          cfg.BufferSize,
+		bufferWALCheckpoint: cfg.BufferWALCheckpoint,
+		flushInterval:       cfg.FlushInterval,
+		lastFlush:           time.Now(),
+		balancer:            NewSampleBalancer(),
+		signatures:          newSignatureCache(cfg.SignatureCacheEntries),
+		ctx:                 collectorCtx,
+		cancel:              cancel,
+		wakeSender:          make(chan struct{}, 1),
+		closeDone:           make(chan struct{}),
+		closeFinished:       make(chan struct{}),
+	}
+	atomic.StoreInt64(&collector.stats.LastPositiveUnixNano, time.Now().UnixNano())
+	if err := collector.loadSpool(); err != nil {
+		cancel()
+		return nil, err
+	}
+	if err := collector.connect(); err != nil {
+		cancel()
+		return nil, err
+	}
+
+	go collector.senderLoop()
+	go func() {
+		select {
+		case <-parent.Done():
+			if err := collector.Close(); err != nil {
+				debuglogger.Log(true, "Collector shutdown retained WAL batches: %v", err)
+			}
+		case <-collector.closeFinished:
+		}
+	}()
+	collector.signalSender()
+	debuglogger.Log(true,
+		"MLDataCollector initialized with buffer size %d, max batch size %s, spool %s",
+		cfg.BufferSize, formatSize(cfg.MaxBatchSize), cfg.SpoolDir)
+	return collector, nil
+}
+
+func (c *MLDataCollector) IsClosed() bool {
+	return atomic.LoadInt32(&c.closed) == 1
+}
+
+func (c *MLDataCollector) connect() error {
+	if c.streamFactory != nil {
+		return nil
+	}
+	opts := []grpc.DialOption{
+		grpc.WithTransportCredentials(insecure.NewCredentials()),
+		grpc.WithDefaultCallOptions(grpc.MaxCallSendMsgSize(c.maxBatchSize)),
+	}
+	conn, err := grpc.NewClient(c.serverAddr, opts...)
+	if err != nil {
+		return fmt.Errorf("failed to create gRPC connection: %w", err)
+	}
+	c.connMu.Lock()
+	oldConn := c.conn
+	c.conn = conn
+	c.client = pb.NewMLTrainingDataServiceClient(conn)
+	c.connMu.Unlock()
+	if oldConn != nil {
+		oldConn.Close()
+	}
+	return nil
+}
+
+func (c *MLDataCollector) reconnect() error {
+	if c.streamFactory != nil {
+		return nil
+	}
+	debuglogger.Log(true, "Attempting to reconnect to training server...")
+	if err := c.connect(); err != nil {
+		return fmt.Errorf("reconnection failed: %w", err)
+	}
+	return nil
+}
+
+func (c *MLDataCollector) openStream(ctx context.Context) (trainingStream, error) {
+	if c.streamFactory != nil {
+		return c.streamFactory(ctx)
+	}
+	c.connMu.RLock()
+	client := c.client
+	c.connMu.RUnlock()
+	if client == nil {
+		return nil, fmt.Errorf("no active gRPC client")
+	}
+	return client.StreamTrainingData(ctx)
+}
+
+func (c *MLDataCollector) AddProgAndLabel(program *prog.Prog, reachability []bool) {
+	addStarted := time.Now()
+	collectorTelemetry.addCalls.Add(1)
+	defer func() {
+		collectorTelemetry.addLatency.observe(time.Since(addStarted))
+	}()
+	if c.IsClosed() {
+		return
+	}
+	labels, valid := syzpilotlib.NormalizeReachabilityLabel(reachability)
+	if !valid {
+		debuglogger.Log(false,
+			"Skipping training sample with invalid reachability label: %v", reachability)
+		return
+	}
+	progData := program.Serialize()
+	progSig := hash.String(progData)
+	labelClass, _ := syzpilotlib.OneHotLabelClass(labels)
+	example := &pb.TrainingExample{
+		ProgData:     progData,
+		ProgSig:      progSig,
+		TargetLabels: labels,
+	}
+	lockStarted := time.Now()
+	c.bufferMu.Lock()
+	collectorTelemetry.bufferLockWait.observe(time.Since(lockStarted))
+	if c.IsClosed() {
+		c.bufferMu.Unlock()
+		return
+	}
+	c.ensureSignatureCacheLocked()
+	previousClass, observed := c.signatures.lookup(progSig)
+	if observed && labelClass <= previousClass {
+		atomic.AddInt64(&c.stats.DuplicateSamples, 1)
+		collectorTelemetry.duplicateDrops.Add(1)
+		c.bufferMu.Unlock()
+		return
+	}
+	if !c.balancer.ShouldKeepSample(labels, &c.stats) {
+		collectorTelemetry.balanceDrops.Add(1)
+		c.bufferMu.Unlock()
+		return
+	}
+	nextBuffer := append(
+		append(make([]*pb.TrainingExample, 0, len(c.buffer)+1), c.buffer...),
+		example,
+	)
+	bufferBatchID := c.bufferBatchID
+	if bufferBatchID == 0 {
+		bufferBatchID = atomic.LoadInt64(&c.stats.BatchID) + 1
+	}
+	if shouldCheckpointBuffer(
+		len(nextBuffer), c.bufferSize, c.bufferWALCheckpoint,
+	) {
+		if err := c.persistBuffer(bufferBatchID, nextBuffer); err != nil {
+			collectorTelemetry.persistDrops.Add(1)
+			c.bufferMu.Unlock()
+			debuglogger.Log(true, "Skipping training sample that could not be persisted: %v", err)
+			return
+		}
+	}
+	c.buffer = nextBuffer
+	c.bufferBatchID = bufferBatchID
+	c.signatures.record(progSig, labelClass)
+	if observed {
+		atomic.AddInt64(&c.stats.LabelUpgradeSamples, 1)
+	}
+	c.updateStats(labels)
+	collectorTelemetry.acceptedSamples.Add(1)
+	needFlush := len(c.buffer) >= c.bufferSize
+	c.bufferMu.Unlock()
+	if needFlush {
+		if err := c.flushBuffer(); err != nil {
+			debuglogger.Log(true, "Collector enqueue failed: %v", err)
+		}
+	}
+}
+
+func shouldCheckpointBuffer(size, bufferSize, checkpointSamples int) bool {
+	if size <= 0 {
+		return false
+	}
+	if checkpointSamples <= 1 {
+		return true
+	}
+	return size == 1 || size%checkpointSamples == 0 || size >= bufferSize
+}
+
+func (c *MLDataCollector) ensureSignatureCacheLocked() {
+	if c.signatures == nil {
+		c.signatures = newSignatureCache(65536)
+	}
+}
+
+func (c *MLDataCollector) restoreSignatureObservation(example *pb.TrainingExample) error {
+	return restoreSignatureObservation(c.signatures, example)
+}
+
+func restoreSignatureObservation(
+	cache *signatureCache, example *pb.TrainingExample,
+) error {
+	class, valid := syzpilotlib.OneHotLabelClass(example.TargetLabels)
+	if !valid {
+		return fmt.Errorf("invalid durable training label")
+	}
+	signature := example.ProgSig
+	if signature == "" {
+		signature = hash.String(example.ProgData)
+	}
+	previousClass, observed := cache.lookup(signature)
+	if !observed || class > previousClass {
+		cache.record(signature, class)
+	}
+	return nil
+}
+
+func (c *MLDataCollector) updateStats(labels []bool) {
+	if syzpilotlib.IsPositiveLabel(labels) {
+		atomic.AddInt64(&c.stats.PositiveSamples, 1)
+		atomic.StoreInt64(&c.stats.LastPositiveUnixNano, time.Now().UnixNano())
+	} else {
+		atomic.AddInt64(&c.stats.NegativeSamples, 1)
+	}
+	atomic.AddInt64(&c.stats.TotalSamples, 1)
+}
+
+func (c *MLDataCollector) flushBuffer() error {
+	return c.queueBufferedBatch(false)
+}
+
+func (c *MLDataCollector) queueBufferedBatch(allowDuringClose bool) error {
+	c.enqueueMu.Lock()
+	defer c.enqueueMu.Unlock()
+	if c.IsClosed() && !allowDuringClose {
+		return fmt.Errorf("collector is closing")
+	}
+
+	c.bufferMu.Lock()
+	if len(c.buffer) == 0 {
+		c.bufferMu.Unlock()
+		return nil
+	}
+	examples := c.buffer
+	batchID := c.bufferBatchID
+	if batchID == 0 {
+		// Tests and legacy in-memory callers may populate the buffer directly.
+		batchID = atomic.LoadInt64(&c.stats.BatchID) + 1
+	}
+	batch := &pb.TrainingBatch{BatchId: batchID, Examples: examples}
+	if err := c.persistBatch(batch); err != nil {
+		c.bufferMu.Unlock()
+		return fmt.Errorf("failed to persist batch %d: %w", batchID, err)
+	}
+	// The durable batch supersedes buffer.pb. If deletion fails, restart
+	// recovery recognizes the identical payload and removes the stale copy.
+	if err := c.removeBufferWAL(); err != nil {
+		debuglogger.Log(true, "Failed to remove superseded buffer WAL: %v", err)
+	}
+	c.buffer = make([]*pb.TrainingExample, 0, c.bufferSize)
+	c.bufferBatchID = 0
+	c.lastFlush = time.Now()
+	atomic.StoreInt64(&c.stats.BatchID, batchID)
+	c.bufferMu.Unlock()
+	c.pendingMu.Lock()
+	c.pending = append(c.pending, batch)
+	pendingCount := len(c.pending)
+	c.pendingMu.Unlock()
+	debuglogger.Log(true, "Queued durable batch %d with %d examples (pending: %d)",
+		batchID, len(examples), pendingCount)
+	c.signalSender()
+	return nil
+}
+
+func (c *MLDataCollector) signalSender() {
+	select {
+	case c.wakeSender <- struct{}{}:
+	default:
+	}
+}
+
+func (c *MLDataCollector) senderLoop() {
+	defer func() {
+		c.cancel()
+		c.connMu.Lock()
+		if c.conn != nil {
+			c.conn.Close()
+			c.conn = nil
+		}
+		c.client = nil
+		c.connMu.Unlock()
+		close(c.closeFinished)
+	}()
+
+	ticker := time.NewTicker(c.flushInterval)
+	defer ticker.Stop()
+	closing := false
+	for {
+		select {
+		case <-c.closeDone:
+			closing = true
+		default:
+		}
+
+		batch := c.peekPending()
+		if batch == nil {
+			if closing {
+				return
+			}
+			select {
+			case <-c.closeDone:
+				closing = true
+			case <-c.wakeSender:
+			case <-ticker.C:
+				if err := c.queueBufferedBatch(false); err != nil && !c.IsClosed() {
+					debuglogger.Log(true, "Periodic collector enqueue failed: %v", err)
+				}
+			}
+			continue
+		}
+		if closing && c.closeDeadlineExceeded() {
+			c.recordCloseError(fmt.Errorf(
+				"collector close deadline expired with %d durable batches retained",
+				c.pendingCount(),
+			))
+			return
+		}
+
+		if err := c.sendWithSimpleRetry(batch); err != nil {
+			var rejected *batchRejectedError
+			if errors.As(err, &rejected) {
+				if quarantineErr := c.quarantineRejectedBatch(batch, rejected); quarantineErr == nil {
+					atomic.AddInt64(&c.stats.RejectedBatches, 1)
+					log.Logf(0,
+						"[SyzPilot] receiver permanently rejected training batch %d; "+
+							"preserved in %s: %s",
+						batch.BatchId, c.rejectedDir(), rejected.message)
+					debuglogger.Log(true,
+						"Receiver permanently rejected batch %d; preserved in %s: %s",
+						batch.BatchId, c.rejectedDir(), rejected.message)
+					continue
+				} else {
+					var repairError *batchRepairError
+					if errors.As(quarantineErr, &repairError) {
+						log.Logf(0,
+							"[SyzPilot] collector halted after durable rejection repair failed: %v",
+							repairError)
+						return
+					}
+					err = fmt.Errorf("persist rejected batch %d: %w",
+						batch.BatchId, quarantineErr)
+				}
+			}
+			if c.IsClosed() {
+				closing = true
+			}
+			pendingCount := c.pendingCount()
+			debuglogger.Log(true,
+				"Failed to commit batch %d; %d durable batches retained: %v",
+				batch.BatchId, pendingCount, err)
+			if closing {
+				c.recordCloseError(fmt.Errorf(
+					"%d batches retained in collector spool after send failure: %w",
+					pendingCount, err,
+				))
+				return
+			}
+			retryTimer := time.NewTimer(c.retryInterval)
+			select {
+			case <-c.closeDone:
+				closing = true
+			case <-c.wakeSender:
+			case <-retryTimer.C:
+			}
+			if !retryTimer.Stop() {
+				select {
+				case <-retryTimer.C:
+				default:
+				}
+			}
+			continue
+		}
+		if err := c.commitPending(batch); err != nil {
+			debuglogger.Log(true, "Failed to delete committed batch %d from spool: %v",
+				batch.BatchId, err)
+			if closing {
+				c.recordCloseError(err)
+				return
+			}
+			retryTimer := time.NewTimer(c.retryInterval)
+			select {
+			case <-c.closeDone:
+				closing = true
+			case <-retryTimer.C:
+			}
+			if !retryTimer.Stop() {
+				select {
+				case <-retryTimer.C:
+				default:
+				}
+			}
+			continue
+		}
+		atomic.AddInt64(&c.stats.SentBatches, 1)
+		debuglogger.Log(true, "Receiver acknowledged durable batch %d with %d examples",
+			batch.BatchId, len(batch.Examples))
+	}
+}
+
+func (c *MLDataCollector) sendWithSimpleRetry(batch *pb.TrainingBatch) error {
+	if err := c.trySendAndReceiveAck(batch); err == nil {
+		return nil
+	} else if _, rejected := err.(*batchRejectedError); rejected {
+		return err
+	} else if _, retryable := err.(*batchRetryableError); retryable {
+		return err
+	}
+	if c.IsClosed() {
+		return fmt.Errorf("collector is closing after failed batch attempt")
+	}
+	if err := c.reconnect(); err != nil {
+		return err
+	}
+	return c.trySendAndReceiveAck(batch)
+}
+
+type batchRejectedError struct {
+	status  string
+	message string
+}
+
+func (err *batchRejectedError) Error() string {
+	return err.message
+}
+
+type batchRetryableError struct {
+	message string
+}
+
+func (err *batchRetryableError) Error() string {
+	return err.message
+}
+
+type batchRepairError struct {
+	err error
+}
+
+func (err *batchRepairError) Error() string {
+	return err.err.Error()
+}
+
+func (err *batchRepairError) Unwrap() error {
+	return err.err
+}
+
+func (c *MLDataCollector) trySendAndReceiveAck(batch *pb.TrainingBatch) error {
+	deadline := time.Now().Add(c.ackTimeout)
+	if closeDeadline := atomic.LoadInt64(&c.closeDeadline); closeDeadline > 0 {
+		candidate := time.Unix(0, closeDeadline)
+		if candidate.Before(deadline) {
+			deadline = candidate
+		}
+	}
+	streamCtx, cancel := context.WithDeadline(c.ctx, deadline)
+	defer cancel()
+	stream, err := c.openStream(streamCtx)
+	if err != nil {
+		return err
+	}
+	if err := stream.Send(batch); err != nil {
+		stream.CloseSend()
+		return err
+	}
+	response, err := stream.Recv()
+	closeErr := stream.CloseSend()
+	if err != nil {
+		return err
+	}
+	if closeErr != nil {
+		return closeErr
+	}
+	if response == nil {
+		return fmt.Errorf("received an empty acknowledgement for batch %d", batch.BatchId)
+	}
+	if response.BatchId != batch.BatchId {
+		return fmt.Errorf("received ack for batch %d while waiting for batch %d",
+			response.BatchId, batch.BatchId)
+	}
+	responseDetails := fmt.Sprintf(
+		"receiver response for batch %d: status=%q processed=%d/%d message=%q",
+		batch.BatchId, response.Status, response.ProcessedSamples,
+		len(batch.Examples), response.Message,
+	)
+	if response.Status == "rejected" && response.ProcessedSamples == 0 {
+		return &batchRejectedError{status: response.Status, message: responseDetails}
+	}
+	if response.Status != "success" {
+		// "error" is the legacy ambiguous status. Treat it, "retry", and all
+		// unknown statuses conservatively so an incompatible peer cannot cause
+		// durable training data to be discarded.
+		return &batchRetryableError{message: responseDetails}
+	}
+	if response.ProcessedSamples != uint32(len(batch.Examples)) {
+		return &batchRetryableError{message: responseDetails}
+	}
+	return nil
+}
+
+func (c *MLDataCollector) peekPending() *pb.TrainingBatch {
+	c.pendingMu.Lock()
+	defer c.pendingMu.Unlock()
+	if len(c.pending) == 0 {
+		return nil
+	}
+	return c.pending[0]
+}
+
+func (c *MLDataCollector) pendingCount() int {
+	c.pendingMu.Lock()
+	defer c.pendingMu.Unlock()
+	return len(c.pending)
+}
+
+func (c *MLDataCollector) commitPending(batch *pb.TrainingBatch) error {
+	if c.spoolDir != "" {
+		if err := c.persistHighWatermark(batch.BatchId); err != nil {
+			return fmt.Errorf("persist committed batch watermark: %w", err)
+		}
+		path := c.batchSpoolPath(batch.BatchId)
+		if err := os.Remove(path); err != nil && !os.IsNotExist(err) {
+			return fmt.Errorf("remove %s: %w", path, err)
+		}
+		if err := syncDirectory(c.spoolDir); err != nil {
+			return err
+		}
+	}
+	return c.popPending(batch)
+}
+
+// popRejectedPendingAndRepairSignatures removes a dead-lettered batch from the
+// active queue, rolls back its sampler statistics, and revokes its duplicate-
+// suppression observations. Any deeper observation that is still durable in a
+// later pending batch or the current buffer is restored before AddProgAndLabel
+// can inspect the cache.
+func (c *MLDataCollector) popRejectedPendingAndRepairSignatures(
+	batch *pb.TrainingBatch,
+) error {
+	c.enqueueMu.Lock()
+	defer c.enqueueMu.Unlock()
+	c.bufferMu.Lock()
+	defer c.bufferMu.Unlock()
+	c.pendingMu.Lock()
+	defer c.pendingMu.Unlock()
+
+	if len(c.pending) == 0 || c.pending[0].BatchId != batch.BatchId {
+		return c.failRejectedRepair(fmt.Errorf(
+			"pending queue changed while rejecting batch %d", batch.BatchId))
+	}
+
+	var rejectedPositive, rejectedNegative int64
+	affected := make(map[string]struct{}, len(batch.Examples))
+	for _, example := range batch.Examples {
+		class, valid := syzpilotlib.OneHotLabelClass(example.TargetLabels)
+		if !valid {
+			return c.failRejectedRepair(fmt.Errorf(
+				"invalid label in rejected batch %d", batch.BatchId))
+		}
+		if class == 0 {
+			rejectedNegative++
+		} else {
+			rejectedPositive++
+		}
+		signature := example.ProgSig
+		if signature == "" {
+			signature = hash.String(example.ProgData)
+		}
+		affected[signature] = struct{}{}
+	}
+	rejectedTotal := rejectedPositive + rejectedNegative
+	if atomic.LoadInt64(&c.stats.TotalSamples) < rejectedTotal ||
+		atomic.LoadInt64(&c.stats.PositiveSamples) < rejectedPositive ||
+		atomic.LoadInt64(&c.stats.NegativeSamples) < rejectedNegative {
+		return c.failRejectedRepair(fmt.Errorf(
+			"collector statistics do not contain rejected batch %d", batch.BatchId))
+	}
+
+	restoredClasses := make(map[string]int, len(affected))
+	findRestored := func(examples []*pb.TrainingExample) error {
+		for _, example := range examples {
+			signature := example.ProgSig
+			if signature == "" {
+				signature = hash.String(example.ProgData)
+			}
+			if _, needsRestore := affected[signature]; !needsRestore {
+				continue
+			}
+			class, valid := syzpilotlib.OneHotLabelClass(example.TargetLabels)
+			if !valid {
+				return fmt.Errorf("invalid durable training label")
+			}
+			if previous, found := restoredClasses[signature]; !found || class > previous {
+				restoredClasses[signature] = class
+			}
+		}
+		return nil
+	}
+	for _, pending := range c.pending[1:] {
+		if err := findRestored(pending.Examples); err != nil {
+			return c.failRejectedRepair(fmt.Errorf(
+				"repair pending signature cache: %w", err))
+		}
+	}
+	if err := findRestored(c.buffer); err != nil {
+		return c.failRejectedRepair(fmt.Errorf(
+			"repair buffered signature cache: %w", err))
+	}
+
+	// All failure-prone validation is complete. Apply queue, signature, and
+	// sampler changes together while AddProgAndLabel is excluded by bufferMu.
+	c.pending[0] = nil
+	c.pending = c.pending[1:]
+	c.ensureSignatureCacheLocked()
+	for signature := range affected {
+		c.signatures.remove(signature)
+		if class, found := restoredClasses[signature]; found {
+			c.signatures.record(signature, class)
+		}
+	}
+	atomic.AddInt64(&c.stats.TotalSamples, -rejectedTotal)
+	atomic.AddInt64(&c.stats.PositiveSamples, -rejectedPositive)
+	atomic.AddInt64(&c.stats.NegativeSamples, -rejectedNegative)
+	return nil
+}
+
+// failRejectedRepair makes a post-dead-letter invariant failure sticky before
+// bufferMu is released. This prevents later samples from making aggregate
+// counters appear sufficient and being misattributed to the rejected batch.
+func (c *MLDataCollector) failRejectedRepair(err error) error {
+	repairError := &batchRepairError{err: err}
+	c.recordCloseError(repairError)
+	atomic.StoreInt32(&c.closed, 1)
+	return repairError
+}
+
+func (c *MLDataCollector) popPending(batch *pb.TrainingBatch) error {
+	c.pendingMu.Lock()
+	defer c.pendingMu.Unlock()
+	if len(c.pending) == 0 || c.pending[0].BatchId != batch.BatchId {
+		return fmt.Errorf("pending queue changed while committing batch %d", batch.BatchId)
+	}
+	c.pending[0] = nil
+	c.pending = c.pending[1:]
+	return nil
+}
+
+func (c *MLDataCollector) batchSpoolPath(batchID int64) string {
+	return filepath.Join(c.spoolDir, fmt.Sprintf("batch-%020d.pb", batchID))
+}
+
+func (c *MLDataCollector) rejectedDir() string {
+	return filepath.Join(c.spoolDir, "rejected")
+}
+
+func (c *MLDataCollector) rejectedRecordPath(batchID int64) string {
+	return filepath.Join(c.rejectedDir(), fmt.Sprintf("batch-%020d.json", batchID))
+}
+
+func (c *MLDataCollector) bufferSpoolPath() string {
+	return filepath.Join(c.spoolDir, "buffer.pb")
+}
+
+func (c *MLDataCollector) highWatermarkPath() string {
+	return filepath.Join(c.spoolDir, "batch-high-watermark")
+}
+
+func (c *MLDataCollector) persistBatch(batch *pb.TrainingBatch) error {
+	return atomicPersistProto(c.spoolDir, c.batchSpoolPath(batch.BatchId), batch)
+}
+
+func (c *MLDataCollector) persistBuffer(
+	batchID int64, examples []*pb.TrainingExample,
+) error {
+	started := time.Now()
+	defer func() {
+		collectorTelemetry.bufferPersist.observe(time.Since(started))
+	}()
+	buffer := &pb.TrainingBatch{BatchId: batchID, Examples: examples}
+	data, err := proto.Marshal(buffer)
+	if err != nil {
+		collectorTelemetry.bufferWALFailures.Add(1)
+		return err
+	}
+	collectorTelemetry.bufferWALWrites.Add(1)
+	collectorTelemetry.bufferWALBytes.Add(uint64(len(data)))
+	if err := atomicPersistBytesObserved(
+		c.spoolDir, c.bufferSpoolPath(), data, &collectorTelemetry,
+	); err != nil {
+		collectorTelemetry.bufferWALFailures.Add(1)
+		return err
+	}
+	return nil
+}
+
+func (c *MLDataCollector) removeBufferWAL() error {
+	if err := os.Remove(c.bufferSpoolPath()); err != nil && !os.IsNotExist(err) {
+		return err
+	}
+	return syncDirectory(c.spoolDir)
+}
+
+func (c *MLDataCollector) persistHighWatermark(batchID int64) error {
+	if batchID <= 0 {
+		return fmt.Errorf("invalid terminal batch ID %d", batchID)
+	}
+	return atomicPersistBytes(
+		c.spoolDir, c.highWatermarkPath(), []byte(fmt.Sprintf("%d\n", batchID)),
+	)
+}
+
+func (c *MLDataCollector) quarantineRejectedBatch(
+	batch *pb.TrainingBatch, rejection *batchRejectedError,
+) error {
+	if c.spoolDir == "" {
+		return fmt.Errorf("collector spool directory is empty")
+	}
+	rejectedDir := c.rejectedDir()
+	if err := os.MkdirAll(rejectedDir, 0o750); err != nil {
+		return err
+	}
+	if err := syncDirectory(c.spoolDir); err != nil {
+		return err
+	}
+
+	activePath := c.batchSpoolPath(batch.BatchId)
+	payload, err := os.ReadFile(activePath)
+	if os.IsNotExist(err) {
+		_, recordedBatch, loadErr := loadRejectedRecord(c.rejectedRecordPath(batch.BatchId))
+		if loadErr != nil {
+			return fmt.Errorf("load existing rejected record: %w", loadErr)
+		}
+		if !proto.Equal(recordedBatch, batch) {
+			return fmt.Errorf("rejected record for batch %d has different contents",
+				batch.BatchId)
+		}
+	} else if err != nil {
+		return err
+	} else {
+		persistedBatch := new(pb.TrainingBatch)
+		if err := proto.Unmarshal(payload, persistedBatch); err != nil {
+			return fmt.Errorf("decode active batch WAL: %w", err)
+		}
+		if !proto.Equal(persistedBatch, batch) {
+			return fmt.Errorf("active WAL for batch %d has different contents",
+				batch.BatchId)
+		}
+		digest := sha256.Sum256(payload)
+		record := rejectedBatchRecord{
+			SchemaVersion: 1,
+			BatchID:       batch.BatchId,
+			Status:        rejection.status,
+			Message:       rejection.message,
+			RejectedAt:    time.Now().UTC().Format(time.RFC3339Nano),
+			PayloadSHA256: hex.EncodeToString(digest[:]),
+			BatchProto:    payload,
+		}
+		recordData, err := json.MarshalIndent(record, "", "  ")
+		if err != nil {
+			return err
+		}
+		recordData = append(recordData, '\n')
+		if err := atomicPersistBytes(
+			rejectedDir, c.rejectedRecordPath(batch.BatchId), recordData,
+		); err != nil {
+			return err
+		}
+		if err := os.Remove(activePath); err != nil && !os.IsNotExist(err) {
+			return err
+		}
+		if err := syncDirectory(c.spoolDir); err != nil {
+			return err
+		}
+	}
+
+	// The watermark is a terminal sequence watermark: acknowledged and
+	// durably rejected IDs must both remain unavailable for reuse.
+	if err := c.persistHighWatermark(batch.BatchId); err != nil {
+		return err
+	}
+	return c.popRejectedPendingAndRepairSignatures(batch)
+}
+
+func loadRejectedRecord(path string) (*rejectedBatchRecord, *pb.TrainingBatch, error) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil, nil, err
+	}
+	record := new(rejectedBatchRecord)
+	if err := json.Unmarshal(data, record); err != nil {
+		return nil, nil, err
+	}
+	if record.SchemaVersion != 1 || record.BatchID <= 0 ||
+		record.Status != "rejected" || record.RejectedAt == "" {
+		return nil, nil, fmt.Errorf("invalid rejected batch metadata")
+	}
+	digest := sha256.Sum256(record.BatchProto)
+	if record.PayloadSHA256 != hex.EncodeToString(digest[:]) {
+		return nil, nil, fmt.Errorf("rejected batch payload digest mismatch")
+	}
+	batch := new(pb.TrainingBatch)
+	if err := proto.Unmarshal(record.BatchProto, batch); err != nil {
+		return nil, nil, fmt.Errorf("decode rejected batch payload: %w", err)
+	}
+	if batch.BatchId != record.BatchID || len(batch.Examples) == 0 {
+		return nil, nil, fmt.Errorf("rejected batch payload identity mismatch")
+	}
+	return record, batch, nil
+}
+
+func (c *MLDataCollector) loadRejectedRecords() (map[int64]*pb.TrainingBatch, int64, error) {
+	rejected := make(map[int64]*pb.TrainingBatch)
+	entries, err := os.ReadDir(c.rejectedDir())
+	if os.IsNotExist(err) {
+		return rejected, 0, nil
+	}
+	if err != nil {
+		return nil, 0, err
+	}
+	var maxBatchID int64
+	for _, entry := range entries {
+		if entry.IsDir() || !strings.HasPrefix(entry.Name(), "batch-") ||
+			!strings.HasSuffix(entry.Name(), ".json") {
+			continue
+		}
+		encodedID := strings.TrimSuffix(strings.TrimPrefix(entry.Name(), "batch-"), ".json")
+		batchID, err := strconv.ParseInt(encodedID, 10, 64)
+		if err != nil || batchID <= 0 {
+			return nil, 0, fmt.Errorf("invalid rejected batch filename: %s", entry.Name())
+		}
+		record, batch, err := loadRejectedRecord(filepath.Join(c.rejectedDir(), entry.Name()))
+		if err != nil {
+			return nil, 0, fmt.Errorf("load rejected batch %s: %w", entry.Name(), err)
+		}
+		if record.BatchID != batchID || rejected[batchID] != nil {
+			return nil, 0, fmt.Errorf("invalid rejected batch identity: %s", entry.Name())
+		}
+		rejected[batchID] = batch
+		if batchID > maxBatchID {
+			maxBatchID = batchID
+		}
+	}
+	return rejected, maxBatchID, nil
+}
+
+func (c *MLDataCollector) loadHighWatermark() (int64, error) {
+	data, err := os.ReadFile(c.highWatermarkPath())
+	if os.IsNotExist(err) {
+		return 0, nil
+	}
+	if err != nil {
+		return 0, err
+	}
+	batchID, err := strconv.ParseInt(strings.TrimSpace(string(data)), 10, 64)
+	if err != nil || batchID <= 0 {
+		return 0, fmt.Errorf("invalid collector batch high-watermark")
+	}
+	return batchID, nil
+}
+
+func (c *MLDataCollector) loadSpool() error {
+	c.ensureSignatureCacheLocked()
+	highWatermark, err := c.loadHighWatermark()
+	if err != nil {
+		return fmt.Errorf("load collector batch high-watermark: %w", err)
+	}
+	rejected, maxRejectedBatchID, err := c.loadRejectedRecords()
+	if err != nil {
+		return fmt.Errorf("load rejected collector batches: %w", err)
+	}
+	entries, err := os.ReadDir(c.spoolDir)
+	if err != nil {
+		return fmt.Errorf("read collector spool: %w", err)
+	}
+	var batches []*pb.TrainingBatch
+	seen := make(map[int64]bool)
+	removedRecoveredWAL := false
+	for _, entry := range entries {
+		if entry.IsDir() || !strings.HasPrefix(entry.Name(), "batch-") ||
+			!strings.HasSuffix(entry.Name(), ".pb") {
+			continue
+		}
+		encodedID := strings.TrimSuffix(strings.TrimPrefix(entry.Name(), "batch-"), ".pb")
+		batchID, err := strconv.ParseInt(encodedID, 10, 64)
+		if err != nil || batchID <= 0 {
+			return fmt.Errorf("invalid collector spool filename: %s", entry.Name())
+		}
+		data, err := os.ReadFile(filepath.Join(c.spoolDir, entry.Name()))
+		if err != nil {
+			return err
+		}
+		batch := new(pb.TrainingBatch)
+		if err := proto.Unmarshal(data, batch); err != nil {
+			return fmt.Errorf("decode collector spool %s: %w", entry.Name(), err)
+		}
+		if batch.BatchId != batchID || len(batch.Examples) == 0 || seen[batchID] {
+			return fmt.Errorf("invalid collector spool batch %s", entry.Name())
+		}
+		if rejectedBatch := rejected[batchID]; rejectedBatch != nil {
+			if !proto.Equal(batch, rejectedBatch) {
+				return fmt.Errorf(
+					"active and rejected WAL for batch %d have different contents", batchID,
+				)
+			}
+			if err := os.Remove(filepath.Join(c.spoolDir, entry.Name())); err != nil {
+				return fmt.Errorf("remove recovered rejected WAL %s: %w", entry.Name(), err)
+			}
+			removedRecoveredWAL = true
+			continue
+		}
+		seen[batchID] = true
+		batches = append(batches, batch)
+	}
+	if removedRecoveredWAL {
+		if err := syncDirectory(c.spoolDir); err != nil {
+			return fmt.Errorf("sync recovered rejected WAL removal: %w", err)
+		}
+	}
+	sort.Slice(batches, func(left, right int) bool {
+		return batches[left].BatchId < batches[right].BatchId
+	})
+	c.pending = batches
+	maxBatchID := highWatermark
+	if maxRejectedBatchID > maxBatchID {
+		maxBatchID = maxRejectedBatchID
+	}
+	if len(batches) > 0 && batches[len(batches)-1].BatchId > maxBatchID {
+		maxBatchID = batches[len(batches)-1].BatchId
+	}
+	bufferPath := c.bufferSpoolPath()
+	if data, err := os.ReadFile(bufferPath); err == nil {
+		bufferBatch := new(pb.TrainingBatch)
+		if err := proto.Unmarshal(data, bufferBatch); err != nil {
+			return fmt.Errorf("decode collector buffer WAL: %w", err)
+		}
+		if bufferBatch.BatchId <= 0 || len(bufferBatch.Examples) == 0 {
+			return fmt.Errorf("invalid collector buffer WAL")
+		}
+		stale := false
+		if rejectedBatch := rejected[bufferBatch.BatchId]; rejectedBatch != nil {
+			if !proto.Equal(bufferBatch, rejectedBatch) {
+				return fmt.Errorf(
+					"collector buffer WAL conflicts with rejected batch %d",
+					bufferBatch.BatchId,
+				)
+			}
+			stale = true
+		}
+		for _, batch := range batches {
+			if batch.BatchId != bufferBatch.BatchId {
+				continue
+			}
+			if !trainingExamplesEqual(batch.Examples, bufferBatch.Examples) {
+				return fmt.Errorf(
+					"collector buffer WAL conflicts with batch %d", batch.BatchId,
+				)
+			}
+			stale = true
+			break
+		}
+		if stale {
+			if err := c.removeBufferWAL(); err != nil {
+				return fmt.Errorf("remove stale collector buffer WAL: %w", err)
+			}
+		} else {
+			if bufferBatch.BatchId <= maxBatchID {
+				return fmt.Errorf("collector buffer WAL has a stale batch ID")
+			}
+			c.buffer = bufferBatch.Examples
+			c.bufferBatchID = bufferBatch.BatchId
+			if bufferBatch.BatchId > maxBatchID {
+				maxBatchID = bufferBatch.BatchId
+			}
+		}
+	} else if !os.IsNotExist(err) {
+		return fmt.Errorf("read collector buffer WAL: %w", err)
+	}
+	for _, batch := range batches {
+		for _, example := range batch.Examples {
+			if err := c.restoreSignatureObservation(example); err != nil {
+				return fmt.Errorf("restore batch signature cache: %w", err)
+			}
+			c.updateStats(example.TargetLabels)
+		}
+	}
+	for _, example := range c.buffer {
+		if err := c.restoreSignatureObservation(example); err != nil {
+			return fmt.Errorf("restore buffer signature cache: %w", err)
+		}
+		c.updateStats(example.TargetLabels)
+	}
+	atomic.StoreInt64(&c.stats.BatchID, maxBatchID)
+	atomic.StoreInt64(&c.stats.RejectedBatches, int64(len(rejected)))
+	return nil
+}
+
+func trainingExamplesEqual(left, right []*pb.TrainingExample) bool {
+	if len(left) != len(right) {
+		return false
+	}
+	for index := range left {
+		if !proto.Equal(left[index], right[index]) {
+			return false
+		}
+	}
+	return true
+}
+
+func atomicPersistProto(directory, destination string, message proto.Message) error {
+	data, err := proto.Marshal(message)
+	if err != nil {
+		return err
+	}
+	return atomicPersistBytes(directory, destination, data)
+}
+
+func atomicPersistBytes(directory, destination string, data []byte) error {
+	return atomicPersistBytesObserved(directory, destination, data, nil)
+}
+
+func atomicPersistBytesObserved(
+	directory, destination string, data []byte, telemetry *collectorTelemetryState,
+) error {
+	tempFile, err := os.CreateTemp(directory, ".collector-*.tmp")
+	if err != nil {
+		return err
+	}
+	tempPath := tempFile.Name()
+	defer os.Remove(tempPath)
+	if _, err := tempFile.Write(data); err != nil {
+		tempFile.Close()
+		return err
+	}
+	if telemetry != nil {
+		telemetry.bufferWALFileSyncs.Add(1)
+	}
+	if err := tempFile.Sync(); err != nil {
+		if telemetry != nil {
+			telemetry.bufferWALSyncErrors.Add(1)
+		}
+		tempFile.Close()
+		return err
+	}
+	if err := tempFile.Close(); err != nil {
+		return err
+	}
+	if err := os.Rename(tempPath, destination); err != nil {
+		return err
+	}
+	if telemetry != nil {
+		telemetry.bufferWALDirSyncs.Add(1)
+	}
+	if err := syncDirectory(directory); err != nil {
+		if telemetry != nil {
+			telemetry.bufferWALSyncErrors.Add(1)
+		}
+		return err
+	}
+	return nil
+}
+
+func ensureSpoolSchema(spoolDir, schemaID string) error {
+	schemaPath := filepath.Join(spoolDir, "schema-v1")
+	expected := []byte("schema-v1\n" + schemaID + "\n")
+	actual, err := os.ReadFile(schemaPath)
+	if err == nil {
+		if string(actual) != string(expected) {
+			return fmt.Errorf("collector spool label schema does not match current target ordering")
+		}
+		return nil
+	}
+	if !os.IsNotExist(err) {
+		return fmt.Errorf("read collector spool schema: %w", err)
+	}
+	if err := atomicPersistBytes(spoolDir, schemaPath, expected); err != nil {
+		return fmt.Errorf("persist collector spool schema: %w", err)
+	}
+	return nil
+}
+
+func syncDirectory(path string) error {
+	directory, err := os.Open(path)
+	if err != nil {
+		return err
+	}
+	defer directory.Close()
+	return directory.Sync()
+}
+
+func (c *MLDataCollector) Close() error {
+	if !atomic.CompareAndSwapInt32(&c.closed, 0, 1) {
+		<-c.closeFinished
+		return c.getCloseError()
+	}
+	debuglogger.Log(true, "Closing MLDataCollector...")
+	atomic.StoreInt64(&c.closeDeadline, time.Now().Add(c.closeTimeout).UnixNano())
+	if err := c.queueBufferedBatch(true); err != nil {
+		c.recordCloseError(err)
+	}
+	close(c.closeDone)
+	c.signalSender()
+	<-c.closeFinished
+	debuglogger.Log(true, "MLDataCollector closed")
+	return c.getCloseError()
+}
+
+func (c *MLDataCollector) closeDeadlineExceeded() bool {
+	deadline := atomic.LoadInt64(&c.closeDeadline)
+	return deadline > 0 && time.Now().UnixNano() >= deadline
+}
+
+func (c *MLDataCollector) recordCloseError(err error) {
+	if err == nil {
+		return
+	}
+	c.closeErrMu.Lock()
+	if c.closeErr == nil {
+		c.closeErr = err
+	}
+	c.closeErrMu.Unlock()
+}
+
+func (c *MLDataCollector) getCloseError() error {
+	c.closeErrMu.Lock()
+	defer c.closeErrMu.Unlock()
+	return c.closeErr
+}
