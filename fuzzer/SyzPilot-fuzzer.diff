@@ -0,0 +1,176 @@
+package manager
+
+import (
+	"net"
+	"os"
+	"strings"
+)
+
+// NetworkInfo contains the information of the network detection result
+type NetworkInfo struct {
+	NetworkMode        string
+	IPAddress          string
+	IsInDocker         bool
+	HasDockerInterface bool
+	InterfaceCount     int
+}
+
+// CheckNetworkInfo check the network related information
+func CheckNetworkInfo() NetworkInfo {
+	info := NetworkInfo{
+		IsInDocker:     isInDocker(),
+		NetworkMode:    "unknown",
+		InterfaceCount: countNetworkInterfaces(),
+	}
+
+	// get IP address
+	info.IPAddress = getDefaultIP()
+	if info.IPAddress == "" {
+		info.IPAddress = "cannot get"
+	}
+
+	// check if there is a docker related network interface
+	info.HasDockerInterface = hasDockerInterface()
+
+	// judge the network mode
+	if !info.IsInDocker {
+		info.NetworkMode = "direct"
+	} else {
+		// in docker, further judge the network mode
+		if isHostNetworkMode(info) {
+			info.NetworkMode = "direct"
+		} else {
+			info.NetworkMode = "isolated"
+		}
+	}
+	return info
+}
+
+// isInDocker check if in docker container
+func isInDocker() bool {
+	// check /.dockerenv
+	if _, err := os.Stat("/.dockerenv"); err == nil {
+		return true
+	}
+
+	// check /proc/1/cgroup
+	if cgroupData, err := os.ReadFile("/proc/1/cgroup"); err == nil {
+		content := string(cgroupData)
+		if strings.Contains(content, "docker") || strings.Contains(content, "lxc") {
+			return true
+		}
+	}
+	return false
+}
+
+// countNetworkInterfaces count network interfaces
+func countNetworkInterfaces() int {
+	interfaces, err := net.Interfaces()
+	if err != nil {
+		return 0
+	}
+
+	count := 0
+	for _, iface := range interfaces {
+		// skip loopback interface
+		if iface.Flags&net.FlagLoopback == 0 {
+			count++
+		}
+	}
+	return count
+}
+
+// hasDockerInterface check if there is a docker related network interface
+func hasDockerInterface() bool {
+	interfaces, err := net.Interfaces()
+	if err != nil {
+		return false
+	}
+
+	for _, iface := range interfaces {
+		// Docker created interfaces usually start with "docker", "veth", "br-"
+		if strings.HasPrefix(iface.Name, "docker") ||
+			strings.HasPrefix(iface.Name, "veth") ||
+			strings.HasPrefix(iface.Name, "br-") {
+			return true
+		}
+	}
+	return false
+}
+
+// getDefaultIP get the default network interface's IP address
+func getDefaultIP() string {
+	interfaces, err := net.Interfaces()
+	if err != nil {
+		return ""
+	}
+
+	for _, iface := range interfaces {
+		// skip loopback interface and non-up state interface
+		if iface.Flags&net.FlagLoopback != 0 || iface.Flags&net.FlagUp == 0 {
+			continue
+		}
+
+		addrs, err := iface.Addrs()
+		if err != nil {
+			continue
+		}
+
+		for _, addr := range addrs {
+			var ip net.IP
+			switch v := addr.(type) {
+			case *net.IPNet:
+				ip = v.IP
+			case *net.IPAddr:
+				ip = v.IP
+			}
+
+			// skip IPv6 and non-global unicast address
+			if ip == nil || ip.IsLoopback() || !ip.IsGlobalUnicast() {
+				continue
+			}
+
+			if ipv4 := ip.To4(); ipv4 != nil {
+				return ipv4.String()
+			}
+		}
+	}
+	return ""
+}
+
+// isHostNetworkMode check if it is host network mode
+func isHostNetworkMode(info NetworkInfo) bool {
+	// method 1: check the number of interfaces in /proc/net/dev
+	// Host mode container will see all network interfaces of the host
+	if info.InterfaceCount > 3 { // experience value, normal container usually has 1-2 interfaces
+		return true
+	}
+
+	// method 2: check if there is a docker related network interface
+	// Host mode container will see the Docker interface of the host
+	if info.HasDockerInterface {
+		return true
+	}
+
+	// method 3: check if the IP address is in the docker internal range
+	// if the IP address is not in the docker internal range, it is probably host mode
+	if info.IPAddress != "cannot get" && !isDockerInternalIP(info.IPAddress) {
+		return true
+	}
+	return false
+}
+
+// isDockerInternalIP check if the IP is in the docker internal range
+func isDockerInternalIP(ip string) bool {
+	parts := strings.Split(ip, ".")
+	if len(parts) < 4 {
+		return false
+	}
+
+	if parts[0] == "172" {
+		if second := parts[1]; second >= "16" && second <= "31" {
+			return true
+		}
+	}
+	return false
+}
diff --git a/pkg/syzpilotlib/predictor/predictor.go b/pkg/syzpilotlib/predictor/predictor.go
new file mode 100644
index 0000000..b361ff3
--- /dev/null
+++ b/pkg/syzpilotlib/predictor/predictor.go
@@ -0,0 +1,171 @@
+// Package predictor provides a client for communicating with a remote ML model server (e.g., TorchServe)
+// to get predictions for fuzzing inputs. It manages a pool of gRPC connections for high throughput.
+package predictor
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/google/syzkaller/pkg/debuglogger"
+	pb "github.com/google/syzkaller/pkg/syzpilotlib/predictorlib"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/credentials/insecure"
+	"google.golang.org/grpc/metadata"
+)
+
+const (
+	// DefaultPoolSize is the default number of gRPC connections to maintain in the pool.
+	DefaultPoolSize = 8
+	// DefaultRequestTimeout is the default timeout for a single prediction request.
+	DefaultRequestTimeout = 30 * time.Second
+	// envInferenceToken is the environment variable for the optional TorchServe inference token.
+	envInferenceToken = "TS_INFERENCE_TOKEN"
+)
+
+// Config holds the configuration for the predictor client.
+type Config struct {
+	// ServerAddr is the address (e.g., "host:port") of the gRPC inference server.
+	ServerAddr string
+	// ModelName is the name of the model to use for predictions.
+	ModelName string
+	// ModelVersion is the specific version of the model to use. If empty, the server's default is used.
+	ModelVersion string
+	// PoolSize is the number of persistent gRPC connections to create. Must be > 0. 8 by default.
+	PoolSize int
+	// RequestTimeout is the timeout for each individual prediction call.
+	RequestTimeout time.Duration
+}
+
+// Predictor is a gRPC client that manages a connection pool for high-throughput inference requests.
+type Predictor struct {
+	clients   []pb.InferenceAPIsServiceClient
+	conns     []*grpc.ClientConn
+	cfg       *Config
+	ctx       context.Context
+	authToken string
+	next      atomic.Uint64 // Used for round-robin client selection.
+}
+
+// New creates and initializes a new Predictor with the given configuration.
+// It establishes a pool of gRPC connections to the specified server address.
+// It returns an error if the configuration is invalid or if connections cannot be established.
+func NewPredictor(ctx context.Context, cfg *Config) (*Predictor, error) {
+	if cfg.ServerAddr == "" || cfg.ModelName == "" {
+		return nil, fmt.Errorf("ServerAddr and ModelName must be specified in the config")
+	}
+	if cfg.PoolSize <= 0 {
+		cfg.PoolSize = DefaultPoolSize
+	}
+	if cfg.RequestTimeout <= 0 {
+		cfg.RequestTimeout = DefaultRequestTimeout
+	}
+
+	dialOpts := []grpc.DialOption{
+		grpc.WithTransportCredentials(insecure.NewCredentials()),
+		// TorchServe enforces its own HTTP/2 ping policy. Prediction RPCs are
+		// frequent and gRPC reconnects on demand, so unsolicited client pings
+		// only risk the server closing pooled connections with too_many_pings.
+		grpc.WithDefaultCallOptions(grpc.WaitForReady(true)),
+	}
+
+	p := &Predictor{
+		cfg:       cfg,
+		ctx:       ctx,
+		clients:   make([]pb.InferenceAPIsServiceClient, 0, cfg.PoolSize),
+		conns:     make([]*grpc.ClientConn, 0, cfg.PoolSize),
+		authToken: os.Getenv(envInferenceToken),
+	}
+
+	for i := 0; i < cfg.PoolSize; i++ {
+		conn, err := grpc.NewClient(cfg.ServerAddr, dialOpts...)
+		if err != nil {
+			p.Close()
+			return nil, fmt.Errorf("failed to dial gRPC server (connection #%d): %w", i+1, err)
+		}
+		p.conns = append(p.conns, conn)
+		p.clients = append(p.clients, pb.NewInferenceAPIsServiceClient(conn))
+	}
+
+	debuglogger.Log(true, "predictor initialized: server=%s, model=%s, pool_size=%d",
+		cfg.ServerAddr, cfg.ModelName, cfg.PoolSize)
+
+	return p, nil
+}
+
+// PredictBatch sends a batch of programs to the inference server and returns their prediction results.
+// It processes the batch concurrently using the gRPC connection pool.
+// If any of the requests fail, it returns an error. The order of results corresponds to the order of input programs.
+func (p *Predictor) PredictBatch(progs [][]byte) ([]map[string]float64, []error) {
+	if len(progs) == 0 {
+		return nil, nil
+	}
+
+	var wg sync.WaitGroup
+	predMaps := make([]map[string]float64, len(progs))
+	errs := make([]error, len(progs))
+	wg.Add(len(progs))
+
+	for i, prog := range progs {
+		go func(i int, prog []byte) {
+			defer wg.Done()
+			predMaps[i], errs[i] = p.predictOne(prog)
+		}(i, prog)
+	}
+
+	wg.Wait()
+
+	return predMaps, errs
+}
+
+// predictOne handles the logic for a single gRPC prediction request.
+func (p *Predictor) predictOne(prog []byte) (map[string]float64, error) {
+	client := p.pickClient()
+
+	reqCtx, cancel := context.WithTimeout(p.ctx, p.cfg.RequestTimeout)
+	defer cancel()
+
+	if p.authToken != "" {
+		reqCtx = metadata.AppendToOutgoingContext(reqCtx, "authorization", "Bearer "+p.authToken)
+	}
+
+	req := &pb.PredictionsRequest{
+		ModelName:    p.cfg.ModelName,
+		ModelVersion: p.cfg.ModelVersion,
+		Input:        map[string][]byte{"data": prog},
+	}
+
+	resp, err := client.Predictions(reqCtx, req)
+	if err != nil {
+		debuglogger.Log(true, "[Predictor] Prediction failed for model=%s: %v", p.cfg.ModelName, err)
+		return nil, err
+	}
+	var predMap map[string]float64
+	if err := json.Unmarshal(resp.Prediction, &predMap); err != nil {
+		return nil, fmt.Errorf("failed to unmarshal prediction JSON: %w", err)
+	}
+	return predMap, nil
+}
+
+// Close gracefully terminates all gRPC connections in the pool.
+func (p *Predictor) Close() {
+	if p.conns == nil {
+		return
+	}
+	for _, conn := range p.conns {
+		conn.Close()
+	}
+	p.conns = nil
+	p.clients = nil
+	debuglogger.Log(true, "predictor connections closed")
+}
+
+// pickClient selects a gRPC client from the pool in a round-robin fashion.
+func (p *Predictor) pickClient() pb.InferenceAPIsServiceClient {
+	index := p.next.Add(1) - 1
+	return p.clients[int(index%uint64(len(p.clients)))]
+}
diff --git a/pkg/syzpilotlib/syzlangmanifest/manifest.go b/pkg/syzpilotlib/syzlangmanifest/manifest.go
new file mode 100644
index 0000000..dc0deab
--- /dev/null
+++ b/pkg/syzpilotlib/syzlangmanifest/manifest.go
@@ -0,0 +1,490 @@
+// Copyright 2026 syzkaller project authors. All rights reserved.
+// Use of this source code is governed by Apache 2 LICENSE that can be found in the LICENSE file.
+
+// Package syzlangmanifest exports deterministic metadata from a compiled prog.Target.
+package syzlangmanifest
+
+import (
+	"bytes"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"slices"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+	"unicode/utf8"
+
+	"github.com/google/syzkaller/prog"
+)
+
+const SchemaVersion = 2
+const SchemaName = "syzpilot.compiled-syzlang-manifest"
+
+const (
+	DeliveryGeneratable = "generatable"
+	DeliverySeedOnly    = "seed_only"
+	DeliveryDisabled    = "disabled"
+)
+
+type Manifest struct {
+	Schema               string               `json:"schema"`
+	SchemaVersion        int                  `json:"schema_version"`
+	Target               TargetIdentity       `json:"target"`
+	Producer             FuzzerIdentity       `json:"producer"`
+	Calls                []Syscall            `json:"calls"`
+	Resources            []Resource           `json:"resources"`
+	ResourceDependencies []ResourceDependency `json:"resource_dependencies"`
+	Constants            []NamedValue         `json:"constants"`
+	FlagSets             []FlagDefinition     `json:"flag_sets"`
+}
+
+type TargetIdentity struct {
+	OS        string `json:"os"`
+	Arch      string `json:"arch"`
+	Revision  string `json:"revision"`
+	PtrSize   string `json:"ptr_size"`
+	PageSize  string `json:"page_size"`
+	BigEndian bool   `json:"big_endian"`
+}
+
+type FuzzerIdentity struct {
+	GitRevision  string `json:"syzkaller_git_revision"`
+	RevisionDate string `json:"revision_date,omitempty"`
+}
+
+type Syscall struct {
+	ID                int                    `json:"id"`
+	NR                string                 `json:"nr"`
+	IsPseudoCall      bool                   `json:"is_pseudo_call"`
+	Name              string                 `json:"name"`
+	CallName          string                 `json:"call_name"`
+	DeliveryMode      string                 `json:"delivery_mode"`
+	Attrs             SyscallAttrs           `json:"attrs"`
+	RequiredResources []string               `json:"required_resources"`
+	DeclaredOutputs   []string               `json:"declared_output_resources"`
+	FixedArguments    []FixedArgument        `json:"fixed_arguments"`
+	Constants         []NumericTypeSignature `json:"constants"`
+	Flags             []NumericTypeSignature `json:"flags"`
+	FixedStrings      []StringTypeSignature  `json:"fixed_strings"`
+}
+
+type FixedArgument struct {
+	Index int    `json:"index"`
+	Value string `json:"value"`
+}
+
+type SyscallAttrs struct {
+	Disabled        bool   `json:"disabled"`
+	Timeout         string `json:"timeout"`
+	ProgTimeout     string `json:"prog_timeout"`
+	IgnoreReturn    bool   `json:"ignore_return"`
+	BreaksReturns   bool   `json:"breaks_returns"`
+	NoGenerate      bool   `json:"no_generate"`
+	NoMinimize      bool   `json:"no_minimize"`
+	RemoteCover     bool   `json:"remote_cover"`
+	Automatic       bool   `json:"automatic"`
+	AutomaticHelper bool   `json:"automatic_helper"`
+	Fsck            string `json:"fsck,omitempty"`
+}
+
+type NumericTypeSignature struct {
+	TypeName  string   `json:"type_name"`
+	Direction string   `json:"direction"`
+	Optional  bool     `json:"optional"`
+	Values    []string `json:"values"`
+}
+
+type StringTypeSignature struct {
+	TypeName  string        `json:"type_name"`
+	Direction string        `json:"direction"`
+	Optional  bool          `json:"optional"`
+	Values    []StringValue `json:"values"`
+}
+
+type StringValue struct {
+	Hex  string `json:"hex"`
+	Text string `json:"text,omitempty"`
+}
+
+type Resource struct {
+	Name   string   `json:"name"`
+	Kind   []string `json:"kind"`
+	Values []string `json:"values"`
+}
+
+type ResourceDependency struct {
+	Name                string   `json:"name"`
+	PreciseConstructors []string `json:"precise_constructors"`
+}
+
+type NamedValue struct {
+	Name  string `json:"name"`
+	Value string `json:"value"`
+}
+
+type FlagDefinition struct {
+	Name    string       `json:"name"`
+	Symbols []FlagSymbol `json:"symbols"`
+}
+
+type FlagSymbol struct {
+	Name     string   `json:"name"`
+	Resolved bool     `json:"resolved"`
+	Values   []string `json:"values"`
+}
+
+func Build(target *prog.Target) (*Manifest, error) {
+	if target == nil {
+		return nil, fmt.Errorf("target is nil")
+	}
+	manifest := &Manifest{
+		Schema:               SchemaName,
+		SchemaVersion:        SchemaVersion,
+		Calls:                make([]Syscall, 0, len(target.Syscalls)),
+		Resources:            make([]Resource, 0, len(target.Resources)),
+		ResourceDependencies: make([]ResourceDependency, 0),
+		Constants:            make([]NamedValue, 0, len(target.Consts)),
+		FlagSets:             make([]FlagDefinition, 0, len(target.Flags)),
+		Target: TargetIdentity{
+			OS: target.OS, Arch: target.Arch, Revision: target.Revision,
+			PtrSize: hexValue(target.PtrSize), PageSize: hexValue(target.PageSize),
+			BigEndian: target.BigEndian,
+		},
+		Producer: FuzzerIdentity{GitRevision: prog.GitRevision},
+	}
+	if !prog.GitRevisionDate.IsZero() {
+		manifest.Producer.RevisionDate = prog.GitRevisionDate.UTC().Format(time.RFC3339)
+	}
+
+	for _, resource := range target.Resources {
+		entry := Resource{
+			Name:   resource.Name,
+			Kind:   append([]string{}, resource.Kind...),
+			Values: make([]string, 0, len(resource.Values)),
+		}
+		for _, value := range resource.Values {
+			entry.Values = append(entry.Values, hexValue(value))
+		}
+		manifest.Resources = append(manifest.Resources, entry)
+	}
+	sort.Slice(manifest.Resources, func(i, j int) bool {
+		return manifest.Resources[i].Name < manifest.Resources[j].Name
+	})
+
+	dependencies := make(map[string]ResourceDependency)
+	for _, call := range target.Syscalls {
+		entry, err := buildSyscall(target, call, dependencies)
+		if err != nil {
+			return nil, err
+		}
+		manifest.Calls = append(manifest.Calls, entry)
+	}
+	sort.Slice(manifest.Calls, func(i, j int) bool {
+		if manifest.Calls[i].Name != manifest.Calls[j].Name {
+			return manifest.Calls[i].Name < manifest.Calls[j].Name
+		}
+		return manifest.Calls[i].ID < manifest.Calls[j].ID
+	})
+	for _, dependency := range dependencies {
+		manifest.ResourceDependencies = append(manifest.ResourceDependencies, dependency)
+	}
+	sort.Slice(manifest.ResourceDependencies, func(i, j int) bool {
+		return manifest.ResourceDependencies[i].Name < manifest.ResourceDependencies[j].Name
+	})
+
+	for _, constant := range target.Consts {
+		manifest.Constants = append(manifest.Constants, NamedValue{
+			Name: constant.Name, Value: hexValue(constant.Value),
+		})
+	}
+	sort.Slice(manifest.Constants, func(i, j int) bool {
+		return manifest.Constants[i].Name < manifest.Constants[j].Name
+	})
+
+	for _, flags := range target.Flags {
+		// Anonymous compiler-local flag sets lack a stable scoped identity.
+		// Their compiled numeric values remain available on each call.
+		if flags.Name == "_" {
+			continue
+		}
+		entry := FlagDefinition{
+			Name: flags.Name, Symbols: make([]FlagSymbol, 0, len(flags.Values)),
+		}
+		for _, name := range flags.Values {
+			values, err := resolveValues(target, name, nil)
+			symbol := FlagSymbol{
+				Name: name, Resolved: err == nil, Values: make([]string, 0),
+			}
+			if err == nil {
+				for _, value := range values {
+					symbol.Values = append(symbol.Values, hexValue(value))
+				}
+				symbol.Values = slices.Compact(symbol.Values)
+			}
+			entry.Symbols = append(entry.Symbols, symbol)
+		}
+		sort.Slice(entry.Symbols, func(i, j int) bool {
+			if entry.Symbols[i].Name != entry.Symbols[j].Name {
+				return entry.Symbols[i].Name < entry.Symbols[j].Name
+			}
+			return slices.Compare(entry.Symbols[i].Values, entry.Symbols[j].Values) < 0
+		})
+		manifest.FlagSets = append(manifest.FlagSets, entry)
+	}
+	sort.Slice(manifest.FlagSets, func(i, j int) bool {
+		return manifest.FlagSets[i].Name < manifest.FlagSets[j].Name
+	})
+	return manifest, nil
+}
+
+func Marshal(target *prog.Target) ([]byte, error) {
+	manifest, err := Build(target)
+	if err != nil {
+		return nil, err
+	}
+	var output bytes.Buffer
+	encoder := json.NewEncoder(&output)
+	encoder.SetEscapeHTML(false)
+	if err := encoder.Encode(manifest); err != nil {
+		return nil, fmt.Errorf("marshal manifest: %w", err)
+	}
+	return output.Bytes(), nil
+}
+
+func buildSyscall(target *prog.Target, call *prog.Syscall,
+	dependencies map[string]ResourceDependency) (Syscall, error) {
+	entry := Syscall{
+		ID: call.ID, NR: hexValue(call.NR),
+		IsPseudoCall: strings.HasPrefix(call.CallName, "syz_"), Name: call.Name,
+		CallName: call.CallName, DeliveryMode: deliveryMode(call),
+		RequiredResources: make([]string, 0),
+		FixedArguments:    make([]FixedArgument, 0),
+		Attrs: SyscallAttrs{
+			Disabled: call.Attrs.Disabled, Timeout: hexValue(call.Attrs.Timeout),
+			ProgTimeout: hexValue(call.Attrs.ProgTimeout), IgnoreReturn: call.Attrs.IgnoreReturn,
+			BreaksReturns: call.Attrs.BreaksReturns, NoGenerate: call.Attrs.NoGenerate,
+			NoMinimize: call.Attrs.NoMinimize, RemoteCover: call.Attrs.RemoteCover,
+			Automatic: call.Attrs.Automatic, AutomaticHelper: call.Attrs.AutomaticHelper,
+			Fsck: call.Attrs.Fsck,
+		},
+	}
+	for index, field := range call.Args {
+		constant, ok := field.Type.(*prog.ConstType)
+		if !ok || constant.IsPad {
+			continue
+		}
+		entry.FixedArguments = append(entry.FixedArguments, FixedArgument{
+			Index: index,
+			Value: hexValue(constant.Val),
+		})
+	}
+	numericConstants := make(map[string]NumericTypeSignature)
+	numericFlags := make(map[string]NumericTypeSignature)
+	stringValues := make(map[string]StringTypeSignature)
+	declaredOutputs := make(map[string]bool)
+	prog.ForeachCallType(call, func(typ prog.Type, ctx *prog.TypeCtx) {
+		direction := ctx.Dir.String()
+		optional := ctx.Optional || typ.Optional()
+		switch value := typ.(type) {
+		case *prog.ResourceType:
+			if ctx.Dir != prog.DirIn {
+				declaredOutputs[value.Desc.Name] = true
+			}
+		case *prog.ConstType:
+			if value.IsPad {
+				return
+			}
+			addNumericSignature(numericConstants, value.Name(), direction, optional,
+				[]uint64{value.Val})
+		case *prog.FlagsType:
+			addNumericSignature(numericFlags, value.Name(), direction, optional, value.Vals)
+		case *prog.BufferType:
+			if (value.Kind == prog.BufferString || value.Kind == prog.BufferGlob) &&
+				len(value.Values) == 1 {
+				addStringSignature(stringValues, value.Name(), direction, optional, value.Values)
+			}
+		}
+	})
+	for _, dependency := range target.SyzPilotMissingResourceDependencies(
+		map[*prog.Syscall]bool{}, call,
+	) {
+		requirement := ResourceDependency{
+			Name:                dependency.Name,
+			PreciseConstructors: make([]string, 0, len(dependency.Constructors)),
+		}
+		for _, constructor := range dependency.Constructors {
+			requirement.PreciseConstructors = append(
+				requirement.PreciseConstructors, constructor.Name,
+			)
+		}
+		if previous, ok := dependencies[requirement.Name]; ok &&
+			!slices.Equal(previous.PreciseConstructors, requirement.PreciseConstructors) {
+			return Syscall{}, fmt.Errorf("resource %q has inconsistent constructor sets", requirement.Name)
+		}
+		dependencies[requirement.Name] = requirement
+		entry.RequiredResources = append(entry.RequiredResources, requirement.Name)
+	}
+	entry.DeclaredOutputs = sortedKeys(declaredOutputs)
+	entry.Constants = sortedNumericSignatures(numericConstants)
+	entry.Flags = sortedNumericSignatures(numericFlags)
+	entry.FixedStrings = sortedStringSignatures(stringValues)
+	return entry, nil
+}
+
+func deliveryMode(call *prog.Syscall) string {
+	switch {
+	case call.Attrs.Disabled:
+		return DeliveryDisabled
+	case call.Attrs.NoGenerate:
+		return DeliverySeedOnly
+	default:
+		return DeliveryGeneratable
+	}
+}
+
+func addNumericSignature(destination map[string]NumericTypeSignature, typeName, direction string,
+	optional bool, values []uint64) {
+	key := fmt.Sprintf("%s\x00%s\x00%t", typeName, direction, optional)
+	entry := destination[key]
+	entry.TypeName = typeName
+	entry.Direction = direction
+	entry.Optional = optional
+	seen := make(map[string]bool, len(entry.Values)+len(values))
+	for _, value := range entry.Values {
+		seen[value] = true
+	}
+	for _, value := range values {
+		encoded := hexValue(value)
+		if !seen[encoded] {
+			seen[encoded] = true
+			entry.Values = append(entry.Values, encoded)
+		}
+	}
+	sort.Slice(entry.Values, func(i, j int) bool {
+		left, _ := strconv.ParseUint(entry.Values[i][2:], 16, 64)
+		right, _ := strconv.ParseUint(entry.Values[j][2:], 16, 64)
+		return left < right
+	})
+	destination[key] = entry
+}
+
+func addStringSignature(destination map[string]StringTypeSignature, typeName, direction string,
+	optional bool, values []string) {
+	key := fmt.Sprintf("%s\x00%s\x00%t", typeName, direction, optional)
+	entry := destination[key]
+	entry.TypeName = typeName
+	entry.Direction = direction
+	entry.Optional = optional
+	byHex := make(map[string]StringValue, len(entry.Values)+len(values))
+	for _, value := range entry.Values {
+		byHex[value.Hex] = value
+	}
+	for _, value := range values {
+		encoded := StringValue{Hex: hex.EncodeToString([]byte(value))}
+		if utf8.ValidString(value) {
+			encoded.Text = value
+		}
+		byHex[encoded.Hex] = encoded
+	}
+	entry.Values = entry.Values[:0]
+	for _, value := range byHex {
+		entry.Values = append(entry.Values, value)
+	}
+	sort.Slice(entry.Values, func(i, j int) bool {
+		return entry.Values[i].Hex < entry.Values[j].Hex
+	})
+	destination[key] = entry
+}
+
+func sortedNumericSignatures(source map[string]NumericTypeSignature) []NumericTypeSignature {
+	result := make([]NumericTypeSignature, 0, len(source))
+	for _, value := range source {
+		result = append(result, value)
+	}
+	sort.Slice(result, func(i, j int) bool {
+		return signatureOrder(result[i].TypeName, result[i].Direction, result[i].Optional,
+			result[j].TypeName, result[j].Direction, result[j].Optional)
+	})
+	return result
+}
+
+func sortedStringSignatures(source map[string]StringTypeSignature) []StringTypeSignature {
+	result := make([]StringTypeSignature, 0, len(source))
+	for _, value := range source {
+		result = append(result, value)
+	}
+	sort.Slice(result, func(i, j int) bool {
+		return signatureOrder(result[i].TypeName, result[i].Direction, result[i].Optional,
+			result[j].TypeName, result[j].Direction, result[j].Optional)
+	})
+	return result
+}
+
+func signatureOrder(leftName, leftDirection string, leftOptional bool,
+	rightName, rightDirection string, rightOptional bool) bool {
+	if leftName != rightName {
+		return leftName < rightName
+	}
+	if leftDirection != rightDirection {
+		return leftDirection < rightDirection
+	}
+	return !leftOptional && rightOptional
+}
+
+func sortedKeys(values map[string]bool) []string {
+	result := make([]string, 0, len(values))
+	for value := range values {
+		result = append(result, value)
+	}
+	slices.Sort(result)
+	return result
+}
+
+func resolveValue(target *prog.Target, name string) (uint64, error) {
+	// Compiled flag descriptions use an empty token for an explicit zero value.
+	if name == "" {
+		return 0, nil
+	}
+	if value, ok := target.ConstMap[name]; ok {
+		return value, nil
+	}
+	value, err := strconv.ParseUint(name, 0, 64)
+	if err != nil {
+		return 0, fmt.Errorf("value %q is neither a target constant nor an integer", name)
+	}
+	return value, nil
+}
+
+func resolveValues(target *prog.Target, name string, visiting map[string]bool) ([]uint64, error) {
+	if value, err := resolveValue(target, name); err == nil {
+		return []uint64{value}, nil
+	}
+	children, ok := target.FlagsMap[name]
+	if !ok {
+		return nil, fmt.Errorf("value %q is neither a target constant, integer, nor flag set", name)
+	}
+	if visiting == nil {
+		visiting = make(map[string]bool)
+	}
+	if visiting[name] {
+		return nil, fmt.Errorf("flag-set cycle at %q", name)
+	}
+	visiting[name] = true
+	defer delete(visiting, name)
+	var result []uint64
+	for _, child := range children {
+		values, err := resolveValues(target, child, visiting)
+		if err != nil {
+			return nil, err
+		}
+		result = append(result, values...)
+	}
+	slices.Sort(result)
+	return slices.Compact(result), nil
+}
+
+func hexValue(value uint64) string {
+	return fmt.Sprintf("0x%x", value)
+}
