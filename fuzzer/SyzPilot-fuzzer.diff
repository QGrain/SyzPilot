@@ -0,0 +1,212 @@
+// Copyright 2026 syzkaller project authors. All rights reserved.
+// Use of this source code is governed by Apache 2 LICENSE that can be found in the LICENSE file.
+
+package main
+
+import (
+	"slices"
+	"testing"
+
+	"github.com/google/syzkaller/pkg/mgrconfig"
+	"github.com/google/syzkaller/prog"
+)
+
+func TestPlanColdStartDependenciesFindsMinimalF2FSClosure(t *testing.T) {
+	cfg, seeds := f2fsDependencyFixture(t, []string{"mount", "syz_mount_image$f2fs"})
+	additions, err := planColdStartDependencies(cfg, seeds)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(additions) != 1 {
+		t.Fatalf("additions = %v, want one shared UID/GID constructor", callNames(additions))
+	}
+	assertColdStartSeedsSupported(t, cfg, seeds, additions)
+
+	without := coldStartDependencyEnabledCalls(cfg.Target, idSet(cfg.Syscalls), nil)
+	supported, _ := cfg.Target.TransitivelyEnabledCalls(without)
+	if allColdStartSeedCallsSupported(seeds, supported) {
+		t.Fatal("F2FS seed unexpectedly remained supported without the planned constructor")
+	}
+}
+
+func TestPlanColdStartDependenciesRespectsDisabledSyscalls(t *testing.T) {
+	cfg, seeds := f2fsDependencyFixture(t, []string{"mount", "syz_mount_image$f2fs"})
+	first, err := planColdStartDependencies(cfg, seeds)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(first) != 1 {
+		t.Fatalf("first additions = %v, want one", callNames(first))
+	}
+	cfg.DisabledSyscalls = []string{first[0].Name}
+	second, err := planColdStartDependencies(cfg, seeds)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(second) != 1 || second[0].Name == first[0].Name {
+		t.Fatalf("disabled constructor was not replaced: first=%v second=%v",
+			callNames(first), callNames(second))
+	}
+	assertColdStartSeedsSupported(t, cfg, seeds, second)
+}
+
+func TestPlanColdStartDependenciesDoesNotSelectSeedCalls(t *testing.T) {
+	cfg, seeds := f2fsDependencyFixture(t, []string{"mount"})
+	if _, err := planColdStartDependencies(cfg, seeds); err == nil {
+		t.Fatal("planner silently added an unselected authenticated seed call")
+	}
+}
+
+func TestPlanColdStartDependenciesNoopForFullConfig(t *testing.T) {
+	cfg, seeds := f2fsDependencyFixture(t, nil)
+	additions, err := planColdStartDependencies(cfg, seeds)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(additions) != 0 {
+		t.Fatalf("full config additions = %v, want none", callNames(additions))
+	}
+}
+
+func TestPlanColdStartDependenciesTraversesMultiLevelResources(t *testing.T) {
+	target, err := prog.GetTarget("test", "64")
+	if err != nil {
+		t.Fatal(err)
+	}
+	seedCall := target.SyscallMap["test$r103_consumer"]
+	ids, err := mgrconfig.ParseEnabledSyscalls(
+		target, []string{seedCall.Name}, nil, mgrconfig.ManualDescriptions,
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cfg := &mgrconfig.Config{
+		EnabledSyscalls: []string{seedCall.Name},
+		Experimental: mgrconfig.Experimental{
+			DescriptionsMode: "manual",
+		},
+		Derived: mgrconfig.Derived{Target: target, Syscalls: ids},
+	}
+	seeds := []coldStartSeed{{
+		callNames: []string{seedCall.Name},
+		program: &prog.Prog{
+			Target: target,
+			Calls:  []*prog.Call{{Meta: seedCall}},
+		},
+	}}
+
+	additions, err := planColdStartDependencies(cfg, seeds)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := []string{
+		"test$r103_producer_r104_consumer",
+		"test$r104_producer",
+	}
+	if got := callNames(additions); !slices.Equal(got, want) {
+		t.Fatalf("additions = %v, want %v", got, want)
+	}
+	assertColdStartSeedsSupported(t, cfg, seeds, additions)
+}
+
+func TestColdStartMachineCheckStatus(t *testing.T) {
+	target, err := prog.GetTarget("test", "64")
+	if err != nil {
+		t.Fatal(err)
+	}
+	seedCall := target.SyscallMap["test$r103_consumer"]
+	constructor := target.SyscallMap["test$r103_producer_r104_consumer"]
+	seed := coldStartSeed{program: &prog.Prog{
+		Target: target,
+		Calls:  []*prog.Call{{Meta: seedCall}},
+	}}
+	unsupported, unavailable := coldStartMachineCheckStatus(
+		[]coldStartSeed{seed}, []*prog.Syscall{constructor},
+		map[*prog.Syscall]bool{},
+	)
+	if !slices.Equal(unsupported, []string{seedCall.Name}) ||
+		!slices.Equal(unavailable, []string{constructor.Name}) {
+		t.Fatalf("unsupported=%v unavailable=%v", unsupported, unavailable)
+	}
+	unsupported, unavailable = coldStartMachineCheckStatus(
+		[]coldStartSeed{seed}, []*prog.Syscall{constructor},
+		map[*prog.Syscall]bool{seedCall: true, constructor: true},
+	)
+	if len(unsupported) != 0 || len(unavailable) != 0 {
+		t.Fatalf("supported closure reported unavailable: %v %v", unsupported, unavailable)
+	}
+}
+
+func f2fsDependencyFixture(t *testing.T, enabled []string) (*mgrconfig.Config, []coldStartSeed) {
+	t.Helper()
+	target, err := prog.GetTarget("linux", "amd64")
+	if err != nil {
+		t.Fatal(err)
+	}
+	seedDir, catalogPath := coldStartFixturePaths(t)
+	f2fsCatalog := writeFilteredColdStartCatalog(
+		t, catalogPath, "syz_mount_image$f2fs")
+	seeds, err := loadTrustedColdStartSeeds(seedDir, f2fsCatalog, target)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ids, err := mgrconfig.ParseEnabledSyscalls(
+		target, enabled, nil, mgrconfig.ManualDescriptions,
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &mgrconfig.Config{
+		EnabledSyscalls: enabled,
+		Experimental: mgrconfig.Experimental{
+			DescriptionsMode: "manual",
+		},
+		Derived: mgrconfig.Derived{
+			Target: target, Syscalls: ids,
+		},
+	}, seeds
+}
+
+func assertColdStartSeedsSupported(
+	t *testing.T, cfg *mgrconfig.Config, seeds []coldStartSeed, additions []*prog.Syscall,
+) {
+	t.Helper()
+	added := make(map[int]bool, len(additions))
+	for _, call := range additions {
+		added[call.ID] = true
+	}
+	enabled := coldStartDependencyEnabledCalls(cfg.Target, idSet(cfg.Syscalls), added)
+	supported, _ := cfg.Target.TransitivelyEnabledCalls(enabled)
+	if !allColdStartSeedCallsSupported(seeds, supported) {
+		t.Fatalf("planned calls %v do not support every authenticated seed", callNames(additions))
+	}
+}
+
+func allColdStartSeedCallsSupported(
+	seeds []coldStartSeed, supported map[*prog.Syscall]bool,
+) bool {
+	for _, seed := range seeds {
+		for _, call := range seed.program.Calls {
+			if !supported[call.Meta] {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func idSet(ids []int) map[int]bool {
+	set := make(map[int]bool, len(ids))
+	for _, id := range ids {
+		set[id] = true
+	}
+	return set
+}
+
+func callNames(calls []*prog.Syscall) []string {
+	names := make([]string, 0, len(calls))
+	for _, call := range calls {
+		names = append(names, call.Name)
+	}
+	return names
+}
diff --git a/syz-manager/syzpilot_seed_catalog.go b/syz-manager/syzpilot_seed_catalog.go
new file mode 100644
index 0000000..1e17a9b
--- /dev/null
+++ b/syz-manager/syzpilot_seed_catalog.go
@@ -0,0 +1,258 @@
+// Copyright 2026 syzkaller project authors. All rights reserved.
+// Use of this source code is governed by Apache 2 LICENSE that can be found in the LICENSE file.
+
+package main
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"slices"
+	"sort"
+	"strings"
+
+	"github.com/google/syzkaller/pkg/manager"
+	"github.com/google/syzkaller/prog"
+	"golang.org/x/sys/unix"
+)
+
+const (
+	coldStartCatalogSchema        = "syzpilot.generic-seed-catalog"
+	coldStartCatalogSchemaVersion = 1
+	coldStartCatalogMaxBytes      = 4 << 20
+	coldStartCatalogMaxEntries    = 4096
+	maxColdStartSeedBytes         = 20 << 20
+	coldStartImagegenProvenance   = "syz-imagegen"
+	coldStartImagegenHeader       = "# Code generated by tools/syz-imagegen. DO NOT EDIT.\n"
+)
+
+type coldStartSeedCatalog struct {
+	Schema        string                      `json:"schema"`
+	SchemaVersion int                         `json:"schema_version"`
+	Target        coldStartSeedCatalogTarget  `json:"target"`
+	Entries       []coldStartSeedCatalogEntry `json:"entries"`
+}
+
+type coldStartSeedCatalogTarget struct {
+	OS       string `json:"os"`
+	Arch     string `json:"arch"`
+	Revision string `json:"revision"`
+}
+
+type coldStartSeedCatalogEntry struct {
+	Path            string   `json:"path"`
+	SHA256          string   `json:"sha256"`
+	Provenance      string   `json:"provenance"`
+	Requirements    []string `json:"requirements"`
+	NoGenerateCalls []string `json:"no_generate_calls"`
+}
+
+func loadTrustedColdStartSeeds(
+	seedDir, catalogPath string, target *prog.Target,
+) ([]coldStartSeed, error) {
+	catalogData, err := readTrustedRegularFile(
+		catalogPath, coldStartCatalogMaxBytes, "cold-start seed catalog",
+	)
+	if err != nil {
+		return nil, err
+	}
+	decoder := json.NewDecoder(bytes.NewReader(catalogData))
+	decoder.DisallowUnknownFields()
+	var catalog coldStartSeedCatalog
+	if err := decoder.Decode(&catalog); err != nil {
+		return nil, fmt.Errorf("parse cold-start seed catalog %q: %w", catalogPath, err)
+	}
+	if err := requireJSONEOF(decoder); err != nil {
+		return nil, fmt.Errorf("parse cold-start seed catalog %q: %w", catalogPath, err)
+	}
+	if catalog.Schema != coldStartCatalogSchema ||
+		catalog.SchemaVersion != coldStartCatalogSchemaVersion {
+		return nil, fmt.Errorf("cold-start seed catalog %q has unsupported schema", catalogPath)
+	}
+	if catalog.Target.OS != target.OS || catalog.Target.Arch != target.Arch ||
+		catalog.Target.Revision != target.Revision {
+		return nil, fmt.Errorf(
+			"cold-start seed catalog target mismatch: got %s/%s@%s, want %s/%s@%s",
+			catalog.Target.OS, catalog.Target.Arch, catalog.Target.Revision,
+			target.OS, target.Arch, target.Revision,
+		)
+	}
+	if len(catalog.Entries) == 0 || len(catalog.Entries) > coldStartCatalogMaxEntries {
+		return nil, fmt.Errorf("cold-start seed catalog has invalid entry count %d",
+			len(catalog.Entries))
+	}
+
+	seeds := make([]coldStartSeed, 0, len(catalog.Entries))
+	canonicalPrograms := make(map[[sha256.Size]byte]string, len(catalog.Entries))
+	previousPath := ""
+	for _, entry := range catalog.Entries {
+		if err := validateColdStartCatalogEntry(entry, previousPath, target); err != nil {
+			return nil, err
+		}
+		previousPath = entry.Path
+		path := filepath.Join(seedDir, entry.Path)
+		data, err := readTrustedRegularFile(path, maxColdStartSeedBytes, "cold-start seed")
+		if err != nil {
+			return nil, err
+		}
+		digest := sha256.Sum256(data)
+		if fmt.Sprintf("%x", digest) != entry.SHA256 {
+			return nil, fmt.Errorf("cold-start seed %q failed SHA-256 authentication", path)
+		}
+		if !bytes.HasPrefix(data, []byte(coldStartImagegenHeader)) {
+			return nil, fmt.Errorf("cold-start seed %q lacks syz-imagegen provenance", path)
+		}
+		program, requirements, err := manager.ParseSeedWithRequirements(
+			target, data, map[string]bool{"manual": true},
+		)
+		if err != nil {
+			return nil, fmt.Errorf("parse cold-start seed %q: %w", path, err)
+		}
+		if len(requirements) != 1 || !requirements["manual"] {
+			return nil, fmt.Errorf("cold-start seed %q has invalid requirements", path)
+		}
+		actualCalls := noGenerateCallsInProgram(program)
+		if !slices.Equal(actualCalls, entry.NoGenerateCalls) {
+			return nil, fmt.Errorf(
+				"cold-start seed %q no_generate calls mismatch: got %v, want %v",
+				path, actualCalls, entry.NoGenerateCalls,
+			)
+		}
+		canonicalDigest := sha256.Sum256(program.Serialize())
+		if duplicatePath, exists := canonicalPrograms[canonicalDigest]; exists {
+			return nil, fmt.Errorf(
+				"cold-start seeds %q and %q encode the same canonical program",
+				duplicatePath, path,
+			)
+		}
+		canonicalPrograms[canonicalDigest] = path
+		seeds = append(seeds, coldStartSeed{
+			identity:  entry.Path + ":" + entry.SHA256,
+			callNames: append([]string(nil), entry.NoGenerateCalls...),
+			program:   program,
+		})
+	}
+	return seeds, nil
+}
+
+func requireJSONEOF(decoder *json.Decoder) error {
+	var extra any
+	if err := decoder.Decode(&extra); err != io.EOF {
+		if err == nil {
+			return fmt.Errorf("multiple JSON values")
+		}
+		return err
+	}
+	return nil
+}
+
+func validateColdStartCatalogEntry(
+	entry coldStartSeedCatalogEntry, previousPath string, target *prog.Target,
+) error {
+	if entry.Path == "" || filepath.IsAbs(entry.Path) ||
+		filepath.Base(entry.Path) != entry.Path || filepath.Clean(entry.Path) != entry.Path {
+		return fmt.Errorf("cold-start seed catalog has unsafe path %q", entry.Path)
+	}
+	if previousPath != "" && entry.Path <= previousPath {
+		return fmt.Errorf("cold-start seed catalog paths are duplicated or unsorted at %q",
+			entry.Path)
+	}
+	digest, err := hex.DecodeString(entry.SHA256)
+	if err != nil || len(digest) != sha256.Size || entry.SHA256 != strings.ToLower(entry.SHA256) {
+		return fmt.Errorf("cold-start seed catalog entry %q has invalid SHA-256", entry.Path)
+	}
+	if entry.Provenance != coldStartImagegenProvenance ||
+		!slices.Equal(entry.Requirements, []string{"manual"}) {
+		return fmt.Errorf("cold-start seed catalog entry %q has invalid provenance", entry.Path)
+	}
+	if len(entry.NoGenerateCalls) == 0 || !sort.StringsAreSorted(entry.NoGenerateCalls) {
+		return fmt.Errorf("cold-start seed catalog entry %q has invalid no_generate calls", entry.Path)
+	}
+	previousCall := ""
+	for _, callName := range entry.NoGenerateCalls {
+		if callName == "" || callName == previousCall {
+			return fmt.Errorf("cold-start seed catalog entry %q has duplicate call %q",
+				entry.Path, callName)
+		}
+		meta, exists := target.SyscallMap[callName]
+		if !exists || !meta.Attrs.NoGenerate || meta.Attrs.Disabled {
+			return fmt.Errorf("cold-start seed catalog call %q is not an enabled no_generate call",
+				callName)
+		}
+		previousCall = callName
+	}
+	return nil
+}
+
+func readTrustedRegularFile(path string, maxBytes int64, description string) ([]byte, error) {
+	info, err := os.Lstat(path)
+	if err != nil {
+		return nil, fmt.Errorf("inspect %s %q: %w", description, path, err)
+	}
+	if info.Mode()&os.ModeSymlink != 0 || !info.Mode().IsRegular() ||
+		info.Size() <= 0 || info.Size() > maxBytes {
+		return nil, fmt.Errorf("%s %q is not a valid regular file", description, path)
+	}
+	fd, err := unix.Open(path,
+		unix.O_RDONLY|unix.O_CLOEXEC|unix.O_NOFOLLOW|unix.O_NONBLOCK, 0)
+	if err != nil {
+		return nil, fmt.Errorf("open %s %q: %w", description, path, err)
+	}
+	file := os.NewFile(uintptr(fd), path)
+	if file == nil {
+		unix.Close(fd)
+		return nil, fmt.Errorf("open %s %q: invalid file descriptor", description, path)
+	}
+	openedInfo, statErr := file.Stat()
+	if statErr != nil || !openedInfo.Mode().IsRegular() || !os.SameFile(info, openedInfo) {
+		file.Close()
+		if statErr != nil {
+			return nil, fmt.Errorf("stat opened %s %q: %w", description, path, statErr)
+		}
+		return nil, fmt.Errorf("%s %q changed type or identity while opening", description, path)
+	}
+	data, readErr := io.ReadAll(io.LimitReader(file, maxBytes+1))
+	closeErr := file.Close()
+	if readErr != nil {
+		return nil, fmt.Errorf("read %s %q: %w", description, path, readErr)
+	}
+	if closeErr != nil {
+		return nil, fmt.Errorf("close %s %q: %w", description, path, closeErr)
+	}
+	if len(data) == 0 || int64(len(data)) > maxBytes {
+		return nil, fmt.Errorf("%s %q changed to an invalid size", description, path)
+	}
+	return data, nil
+}
+
+func noGenerateCallsInProgram(program *prog.Prog) []string {
+	names := make(map[string]bool)
+	for _, call := range program.Calls {
+		if call.Meta.Attrs.NoGenerate {
+			names[call.Meta.Name] = true
+		}
+	}
+	return sortedNames(names)
+}
+
+func selectColdStartSeeds(seeds []coldStartSeed, selectedCallIDs []int) []coldStartSeed {
+	selected := make(map[int]bool, len(selectedCallIDs))
+	for _, id := range selectedCallIDs {
+		selected[id] = true
+	}
+	result := make([]coldStartSeed, 0)
+	for _, seed := range seeds {
+		for _, callName := range seed.callNames {
+			if selected[seed.program.Target.SyscallMap[callName].ID] {
+				result = append(result, seed)
+				break
+			}
+		}
+	}
+	return result
+}
