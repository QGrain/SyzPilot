+func (mgr *Manager) acceptGuidance(
+	guidance *syzpilotlib.GuidancePayload,
+) (syzpilotlib.GuidanceApplyResult, error) {
+	if mgr.cfg != nil && mgr.cfg.SyzPilot.ObserveTargetCoverage &&
+		!mgr.cfg.SyzPilot.ReachFilter.Enable {
+		return syzpilotlib.GuidanceApplyResult{},
+			fmt.Errorf("guidance is disabled in observation-only control mode")
+	}
+	if mgr.cfg == nil || (!mgr.cfg.SyzPilot.ReachFilter.Enable &&
+		!mgr.cfg.SyzPilot.AllowStandaloneGuidance) {
+		return syzpilotlib.GuidanceApplyResult{},
+			fmt.Errorf("guidance requires reach filtering or explicit standalone opt-in")
+	}
+	if guidance == nil || guidance.Version <= 0 {
+		return syzpilotlib.GuidanceApplyResult{},
+			fmt.Errorf("guidance version must be positive")
+	}
+	retained := syzpilotlib.CloneGuidancePayload(guidance)
+	mgr.guidanceMu.Lock()
+	defer mgr.guidanceMu.Unlock()
+	if mgr.guidance != nil && guidance.Version < mgr.guidance.Version {
+		return syzpilotlib.GuidanceApplyResult{}, fmt.Errorf(
+			"stale guidance version %d; current version is %d",
+			guidance.Version, mgr.guidance.Version,
+		)
+	}
+	if mgr.guidance != nil && guidance.Version == mgr.guidance.Version {
+		if !reflect.DeepEqual(mgr.guidance, retained) {
+			return syzpilotlib.GuidanceApplyResult{}, fmt.Errorf(
+				"guidance version %d was reused with different contents",
+				guidance.Version,
+			)
+		}
+		result := mgr.guidanceResult
+		result.Status = "already_applied"
+		return result, nil
+	}
+	if mgr.pendingGuidance != nil && guidance.Version < mgr.pendingGuidance.Version {
+		return syzpilotlib.GuidanceApplyResult{}, fmt.Errorf(
+			"stale guidance version %d; pending version is %d",
+			guidance.Version, mgr.pendingGuidance.Version,
+		)
+	}
+	if mgr.pendingGuidance != nil && guidance.Version == mgr.pendingGuidance.Version {
+		if !reflect.DeepEqual(mgr.pendingGuidance, retained) {
+			return syzpilotlib.GuidanceApplyResult{}, fmt.Errorf(
+				"pending guidance version %d was reused with different contents",
+				guidance.Version,
+			)
+		}
+		return syzpilotlib.GuidanceApplyResult{
+			Status: "pending", Version: guidance.Version,
+		}, nil
+	}
+
+	fuzzerObj := mgr.fuzzer.Load()
+	if fuzzerObj == nil {
+		mgr.pendingGuidance = retained
+		return syzpilotlib.GuidanceApplyResult{
+			Status: "pending", Version: guidance.Version,
+		}, nil
+	}
+	result, err := fuzzerObj.ApplyGuidance(retained)
+	if err != nil {
+		return syzpilotlib.GuidanceApplyResult{}, err
+	}
+	seedResult := mgr.injectColdStartSeeds(retained, fuzzerObj)
+	applyColdStartSeedResult(&result, seedResult)
+	mgr.guidance = retained
+	mgr.pendingGuidance = nil
+	mgr.guidanceResult = result
+	debuglogger.Log(true,
+		"[SyzPilot] Guidance v%d retained with status %s: %d weights, %d templates",
+		guidance.Version, result.Status,
+		len(guidance.SyscallWeights), len(guidance.MutationTemplates),
+	)
+	return result, nil
+}
+
+type coldStartSeed struct {
+	identity  string
+	callNames []string
+	program   *prog.Prog
+}
+
+type coldStartSeedResult struct {
+	native   int
+	injected int
+	reused   int
+	rejected int
+}
+
+func applyColdStartSeedResult(
+	result *syzpilotlib.GuidanceApplyResult, seeds coldStartSeedResult,
+) {
+	result.AcceptedSeeds = seeds.injected
+	result.NativeSeeds = seeds.native
+	result.InjectedSeeds = seeds.injected
+	result.ReusedSeeds = seeds.reused
+	result.RejectedSeeds = seeds.rejected
+}
+
+func (mgr *Manager) injectColdStartSeeds(
+	guidance *syzpilotlib.GuidancePayload, fuzzerObj *fuzzer.Fuzzer,
+) coldStartSeedResult {
+	if len(mgr.coldStartSeeds) == 0 || guidance == nil || fuzzerObj == nil {
+		return coldStartSeedResult{}
+	}
+	if mgr.coldSeedFuzzer != fuzzerObj {
+		mgr.coldSeedFuzzer = fuzzerObj
+		mgr.coldSeededSeeds = make(map[string]bool)
+	}
+	candidates, injectedSeeds, result := coldStartSeedCandidates(
+		mgr.coldStartSeeds, fuzzerObj.Config.EnabledCalls,
+		guidance.GenerationHints.PreferredSyscalls,
+		mgr.coldNativeSeeds, mgr.coldSeededSeeds,
+	)
+	if len(candidates) != 0 {
+		// Retention is additive: candidates still enter the unmodified native
+		// queue below, while the optional directed corpus only provides future
+		// mutation sources.
+		fuzzerObj.AddDirectedCandidates(
+			candidates, guidance.GenerationHints.PreferredSyscalls,
+		)
+		fuzzerObj.AddCandidates(candidates)
+		for _, identity := range injectedSeeds {
+			mgr.coldSeededSeeds[identity] = true
+		}
+	}
+	log.Logf(0,
+		"[SyzPilot] cold-start seeds: %d injected (%d also native, %d reused), "+
+			"%d rejected",
+		result.injected, result.native, result.reused,
+		result.rejected)
+	return result
+}
+
+func coldStartSeedCandidates(
+	seeds []coldStartSeed, enabledCalls map[*prog.Syscall]bool,
+	preferredCalls []string, nativeSeeds, alreadyInjected map[string]bool,
+) ([]fuzzer.Candidate, []string, coldStartSeedResult) {
+	var candidates []fuzzer.Candidate
+	var injectedSeeds []string
+	var result coldStartSeedResult
+	preferred := make(map[string]bool, len(preferredCalls))
+	for _, callName := range preferredCalls {
+		preferred[callName] = true
+	}
+	for _, seed := range seeds {
+		matched := false
+		for _, callName := range seed.callNames {
+			if preferred[callName] {
+				matched = true
+				break
+			}
+		}
+		if !matched {
+			continue
+		}
+		if !seed.program.OnlyContains(enabledCalls) {
+			result.rejected++
+			continue
+		}
+		if nativeSeeds[seed.identity] {
+			result.native++
+		}
+		if alreadyInjected[seed.identity] {
+			result.reused++
+			continue
+		}
+		candidates = append(candidates, fuzzer.Candidate{
+			Prog: seed.program.Clone(), Flags: fuzzer.ProgMinimized,
+		})
+		injectedSeeds = append(injectedSeeds, seed.identity)
+		result.injected++
+	}
+	return candidates, injectedSeeds, result
+}
+
+func findNativeColdStartSeeds(
+	candidates []fuzzer.Candidate, seeds []coldStartSeed,
+) map[string]bool {
+	trustedPrograms := make(map[[sha256.Size]byte][]string, len(seeds))
+	for _, seed := range seeds {
+		digest := sha256.Sum256(seed.program.Serialize())
+		trustedPrograms[digest] = append(trustedPrograms[digest], seed.identity)
+	}
+	nativeSeeds := make(map[string]bool)
+	for _, candidate := range candidates {
+		digest := sha256.Sum256(candidate.Prog.Serialize())
+		for _, identity := range trustedPrograms[digest] {
+			nativeSeeds[identity] = true
+		}
+	}
+	return nativeSeeds
+}
+
+func programContainsCall(program *prog.Prog, callName string) bool {
+	for _, call := range program.Calls {
+		if call.Meta.Name == callName {
+			return true
+		}
+	}
+	return false
+}
