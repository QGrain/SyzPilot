+// EnableRFSource creates a Predictor and wraps the base execution source with
+// a ReachFilterSource. Called when a model becomes available via /model_ready callback.
+// Thread-safe: can be called while Next() is running.
+func (fuzzer *Fuzzer) EnableRFSource(modelName, modelVersion string) error {
+	if !fuzzer.Config.SyzPilotCfg.ReachFilter.Enable {
+		return fmt.Errorf("reachability filter is not enabled")
+	}
+
+	fuzzer.Logf(0, "[SyzPilot] Creating predictor for model=%s version=%s", modelName, modelVersion)
+
+	// Create new predictor
+	predictorCfg := &predictor.Config{
+		ServerAddr:   fuzzer.Config.SyzPilotRTCfg.TSServerAddr,
+		ModelName:    modelName,
+		ModelVersion: modelVersion,
+		PoolSize:     4,
+	}
+	newPredictor, err := predictor.NewPredictor(fuzzer.ctx, predictorCfg)
+	if err != nil {
+		return fmt.Errorf("create predictor: %w", err)
+	}
+	probeResults, probeErrors := newPredictor.PredictBatch([][]byte{[]byte("getpid()")})
+	if len(probeErrors) != 1 || probeErrors[0] != nil ||
+		len(probeResults) != 1 || len(probeResults[0]) == 0 {
+		newPredictor.Close()
+		if len(probeErrors) == 1 && probeErrors[0] != nil {
+			return fmt.Errorf("probe candidate model: %w", probeErrors[0])
+		}
+		return fmt.Errorf("probe candidate model returned no probabilities")
+	}
+	if err := rfilter.ValidatePrediction(probeResults[0], len(fuzzer.TargetAddrVals)); err != nil {
+		newPredictor.Close()
+		return fmt.Errorf("probe candidate model protocol: %w", err)
+	}
+
+	// Create ReachFilterSource wrapping the preserved baseSource
+	newRFSource := rfilter.NewRFSource(
+		fuzzer.baseSource,
+		fuzzer.Config.SyzPilotCfg,
+		newPredictor,
+		rfilter.SourceOptions{
+			SchedulingStart: fuzzer.rfSchedulingStart,
+			OnSmash:         fuzzer.schedulePredictedSmash,
+			OnFiltered: func() {
+				fuzzer.statFilteredTotal.Add(1)
+			},
+		},
+	)
+
+	// Swap source atomically (protected by fuzzer.mu)
+	fuzzer.mu.Lock()
+	oldPredictor := fuzzer.Predictor
+	oldSource := fuzzer.source
+	fuzzer.Predictor = newPredictor
+	fuzzer.source = newRFSource
+	fuzzer.mu.Unlock()
+
+	// Stop and drain the old source before closing its Predictor. This prevents
+	// PredictBatch from racing a connection-pool teardown during model updates.
+	if oldRF, ok := oldSource.(*rfilter.ReachFilterSource); ok {
+		oldRF.Close()
+	}
+	if oldPredictor != nil {
+		oldPredictor.Close()
+		fuzzer.Logf(0, "[SyzPilot] Closed old predictor (model update)")
+	}
+
+	fuzzer.Logf(0, "[SyzPilot] Predictor enabled: model=%s version=%s, ReachFilterSource active",
+		modelName, modelVersion)
+	return nil
+}
