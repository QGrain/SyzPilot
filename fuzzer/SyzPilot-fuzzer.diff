+// UpdateGuidance updates the external guidance weights for syscall selection.
+// This is called when the brain controller sends new guidance via /guidance endpoint.
+func (ct *ChoiceTable) UpdateGuidance(weights map[string]float64) (map[string]float64, int) {
+	accepted := make(map[string]float64)
+	generatable := make(map[string]*Syscall, len(ct.calls))
+	for _, call := range ct.calls {
+		generatable[call.Name] = call
+	}
+	rejected := 0
+	for name, weight := range weights {
+		if weight <= 0 || math.IsNaN(weight) || math.IsInf(weight, 0) {
+			rejected++
+			continue
+		}
+		if _, exists := generatable[name]; !exists {
+			rejected++
+			continue
+		}
+		accepted[name] = weight
+	}
+	ct.guidanceWeights = accepted
+	ct.guidedCalls = nil
+	ct.guidedTotalW = 0
+	for _, call := range ct.calls {
+		if weight, exists := accepted[call.Name]; exists {
+			ct.guidedCalls = append(ct.guidedCalls, call)
+			ct.guidedTotalW += weight
+		}
+	}
+	return accepted, rejected
+}
+
+// GuidanceStats reports the immutable guided subset installed on this table.
+func (ct *ChoiceTable) GuidanceStats() (int, float64) {
+	return len(ct.guidedCalls), ct.guidedTotalW
+}
+
+// guidedChoose selects a syscall using the guidance weights.
+// Uses weighted random selection over the guided syscall set.
+func (ct *ChoiceTable) guidedChoose(r *rand.Rand) int {
+	x := r.Float64() * ct.guidedTotalW
+	cumulative := 0.0
+	for _, call := range ct.guidedCalls {
+		cumulative += ct.guidanceWeights[call.Name]
+		if x <= cumulative {
+			return call.ID
+		}
+	}
+	return ct.guidedCalls[len(ct.guidedCalls)-1].ID
+}
