+func (fuzzer *Fuzzer) checkReachability(progInfo *flatrpc.ProgInfo) (reachability []bool, cov cover.Cover) {
+	// +1 for Unreachable label at index 0; target PCs start at index 1
+	reachability = make([]bool, len(fuzzer.TargetAddrVals)+1)
+	if len(fuzzer.TargetAddrVals) == 0 || progInfo == nil {
+		return reachability, nil
+	}
+	start := time.Now()
+
+	hasCoverage := false
+	truncated := false
+	targetIndexes := make(map[uint64]int, len(fuzzer.TargetAddrVals))
+	for i, target := range fuzzer.TargetAddrVals {
+		targetIndexes[target] = i + 1
+	}
+	scan := func(callInfo *flatrpc.CallInfo) {
+		if callInfo != nil {
+			hasCoverage = hasCoverage || len(callInfo.Cover) != 0
+			truncated = truncated ||
+				callInfo.Flags&flatrpc.CallFlagCoverageOverflow != 0
+			for _, pc := range callInfo.Cover {
+				if targetIndex, ok := targetIndexes[pc]; ok {
+					reachability[targetIndex] = true
+				}
+			}
+		}
+	}
+	for _, callInfo := range progInfo.Calls {
+		scan(callInfo)
+	}
+	// ProgInfo.Extra contains background coverage (including ExtraRaw merged by
+	// rpcserver). It is part of the same program execution and can contain the
+	// only hit for a target PC, so it must participate in label construction.
+	scan(progInfo.Extra)
+	if !hasCoverage {
+		// No raw PC coverage means the reachability class is unknown. Do not
+		// encode it as an all-zero label, because argmax would silently train it
+		// as class 0 (Unreachable).
+		return nil, cov
+	}
+
+	reached := false
+	deepestObserved := 0
+	for i := 1; i < len(reachability); i++ {
+		if reachability[i] {
+			reached = true
+			deepestObserved = i
+		}
+	}
+	// A saturated KCOV buffer is only a prefix of the actual execution trace.
+	// Missing target PCs therefore mean "unknown", not Unreachable or a
+	// shallower class. The sole safe exception is observing the deepest
+	// configured target, because there is no deeper class left to conceal.
+	if truncated && !reachability[len(reachability)-1] {
+		if fuzzer.statReachabilityTruncated != nil {
+			fuzzer.statReachabilityTruncated.Add(1)
+		}
+		if deepestObserved < len(fuzzer.statReachabilityTruncatedDeepest) &&
+			fuzzer.statReachabilityTruncatedDeepest[deepestObserved] != nil {
+			fuzzer.statReachabilityTruncatedDeepest[deepestObserved].Add(1)
+		}
+		debuglogger.Log(false,
+			"reachability label excluded because KCOV coverage was truncated; deepest observed target index=%d",
+			deepestObserved)
+		return nil, cov
+	}
+	// Constructing a map for every raw trace is expensive and unnecessary for
+	// label-only collection. Preserve full coverage only when dumping is enabled
+	// or the deepest target requires an unconditional retained artifact.
+	if reachability[len(reachability)-1] ||
+		(fuzzer.Config != nil && fuzzer.Config.SyzPilotCfg.EnableDump) {
+		for _, callInfo := range progInfo.Calls {
+			if callInfo != nil {
+				cov.Merge(callInfo.Cover)
+			}
+		}
+		if progInfo.Extra != nil {
+			cov.Merge(progInfo.Extra.Cover)
+		}
+	}
+	if !reached {
+		reachability[0] = true // coverage non-empty but no target hit → Unreachable
+		fuzzer.statReachability[0].Add(1)
+	} else {
+		for i := 1; i < len(reachability); i++ {
+			if reachability[i] {
+				fuzzer.statReachability[i].Add(1)
+			}
+		}
+	}
+	duration := time.Since(start)
+	debuglogger.Log(false, "checkReachability() took %vms", duration.Milliseconds())
+	return reachability, cov
+}
+
+func deepestReachedClass(reachability []bool) int {
+	for index := len(reachability) - 1; index > 0; index-- {
+		if reachability[index] {
+			return index
+		}
+	}
+	return 0
+}
+
+func (fuzzer *Fuzzer) deepestObservedTarget(progInfo *flatrpc.ProgInfo) int {
+	if progInfo == nil || len(fuzzer.TargetAddrVals) == 0 {
+		return 0
+	}
+	targetIndexes := make(map[uint64]int, len(fuzzer.TargetAddrVals))
+	for index, target := range fuzzer.TargetAddrVals {
+		targetIndexes[target] = index + 1
+	}
+	deepest := 0
+	scan := func(callInfo *flatrpc.CallInfo) {
+		if callInfo == nil {
+			return
+		}
+		for _, pc := range callInfo.Cover {
+			if index := targetIndexes[pc]; index > deepest {
+				deepest = index
+			}
+		}
+	}
+	for _, callInfo := range progInfo.Calls {
+		scan(callInfo)
+	}
+	scan(progInfo.Extra)
+	return deepest
+}
+
+func (fuzzer *Fuzzer) observeFinalTarget(
+	progInfo *flatrpc.ProgInfo,
+) (reachability []bool, cov cover.Cover) {
+	if len(fuzzer.TargetAddrVals) == 0 || progInfo == nil {
+		return nil, nil
+	}
+	finalTarget := fuzzer.TargetAddrVals[len(fuzzer.TargetAddrVals)-1]
+	finalReached := false
+	check := func(callInfo *flatrpc.CallInfo) {
+		if callInfo == nil {
+			return
+		}
+		for _, pc := range callInfo.Cover {
+			if pc == finalTarget {
+				finalReached = true
+				return
+			}
+		}
+	}
+	for _, callInfo := range progInfo.Calls {
+		check(callInfo)
+	}
+	check(progInfo.Extra)
+	if !finalReached {
+		return nil, nil
+	}
+
+	reachability = make([]bool, len(fuzzer.TargetAddrVals)+1)
+	reachability[len(reachability)-1] = true
+	if len(fuzzer.statReachability) == len(reachability) &&
+		fuzzer.statReachability[len(reachability)-1] != nil {
+		fuzzer.statReachability[len(reachability)-1].Add(1)
+	}
+	for _, callInfo := range progInfo.Calls {
+		if callInfo != nil {
+			cov.Merge(callInfo.Cover)
+		}
+	}
+	if progInfo.Extra != nil {
+		cov.Merge(progInfo.Extra.Cover)
+	}
+	return reachability, cov
+}
