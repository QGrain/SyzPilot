+func validateSyzPilotConfig(cfg mgrconfig.SyzPilotCfg) error {
+	if (cfg.ColdStartSeedDir == "") != (cfg.ColdStartSeedCatalog == "") {
+		return fmt.Errorf("cold_start_seed_dir and cold_start_seed_catalog must be configured together")
+	}
+	if cfg.ColdStartAutoDependencies && cfg.ColdStartSeedDir == "" {
+		return fmt.Errorf("cold_start_auto_dependencies requires cold_start_seed_dir")
+	}
+	if len(cfg.TargetPCs) > 0 {
+		if _, _, err := syzpilotlib.ValidateTargetAddrs(cfg.TargetPCs); err != nil {
+			return fmt.Errorf("target_pcs: %w", err)
+		}
+	}
+	if cfg.ObserveTargetCoverage && len(cfg.TargetPCs) == 0 {
+		return fmt.Errorf("observe_target_coverage requires target_pcs")
+	}
+	if cfg.ObserveTargetCoverage && !filepath.IsAbs(cfg.DumpDir) {
+		return fmt.Errorf("observe_target_coverage requires an explicit absolute dump_dir")
+	}
+	if cfg.DirectedCorpus.Enable && len(cfg.TargetPCs) == 0 {
+		return fmt.Errorf("directed_corpus requires target_pcs")
+	}
+	if cfg.DirectedCorpus.Enable && cfg.ObserveTargetCoverage {
+		return fmt.Errorf("directed_corpus cannot be enabled in an observation-only control")
+	}
+	if cfg.DirectedCorpus.Enable &&
+		!cfg.ReachFilter.Enable && !cfg.AllowStandaloneGuidance {
+		return fmt.Errorf("directed_corpus requires reach_filter or allow_standalone_guidance")
+	}
+	if !cfg.ReachFilter.Enable {
+		return nil
+	}
+	if cfg.ReachFilter.Controller == "" {
+		return fmt.Errorf("controller address is empty")
+	}
+	if cfg.TaskName == "" {
+		return fmt.Errorf("task_name is empty")
+	}
+	if len(cfg.TargetPCs) == 0 {
+		return fmt.Errorf("target_pcs is empty")
+	}
+	return nil
+}
