+func (fuzzer *Fuzzer) writeProgAndCoverToDir(dir, sig string, progBytes []byte, cov cover.Cover) (err error) {
+	// Preserve the first copy of a content-addressed program. Repeated hits and
+	// manager restarts must not overwrite its original evidence timestamp.
+	progPath := filepath.Join(dir, "programs", sig)
+	progFile, err := os.OpenFile(progPath, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o644)
+	if err != nil && !os.IsExist(err) {
+		return fmt.Errorf("write program %s: %w", progPath, err)
+	}
+	if err == nil {
+		written, writeErr := progFile.Write(progBytes)
+		closeErr := progFile.Close()
+		if writeErr != nil {
+			return fmt.Errorf("write program %s: %w", progPath, writeErr)
+		}
+		if written != len(progBytes) {
+			return fmt.Errorf("write program %s: short write %d/%d",
+				progPath, written, len(progBytes))
+		}
+		if closeErr != nil {
+			return fmt.Errorf("close program %s: %w", progPath, closeErr)
+		}
+	}
+
+	// Coverage artifacts use exclusive creation and advance past files retained
+	// by an earlier process, so restarts never overwrite historical target hits.
+	dumpMapKey := fmt.Sprintf("%s-%s", dir, sig)
+	coverageIndex := fuzzer.DumpMapCnt[dumpMapKey]
+	var coverPath string
+	var fDump *os.File
+	for {
+		coverPath = fmt.Sprintf("%s-%d", filepath.Join(dir, "coverage", sig), coverageIndex)
+		fDump, err = os.OpenFile(coverPath, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o644)
+		if os.IsExist(err) {
+			coverageIndex++
+			continue
+		}
+		if err != nil {
+			return fmt.Errorf("create coverage file %s: %w", coverPath, err)
+		}
+		break
+	}
+	// use buffer writer to decrease write system call for better performance
+	writer := bufio.NewWriter(fDump)
+	// use a loop to write each uint64 to the file
+	for _, pc := range cov.Serialize() {
+		_, err := fmt.Fprintf(writer, "0x%x\n", pc) // write to buffer
+		if err != nil {
+			fDump.Close()
+			fuzzer.Logf(0, "[SyzPilot] failed to write coverage to %s: %v", coverPath, err)
+			debuglogger.Log(false, "failed to write coverage to %s: %v", coverPath, err)
+			return err
+		}
+	}
+	if err := writer.Flush(); err != nil {
+		fDump.Close()
+		return fmt.Errorf("flush coverage file %s: %w", coverPath, err)
+	}
+	if err := fDump.Close(); err != nil {
+		return fmt.Errorf("close coverage file %s: %w", coverPath, err)
+	}
+	fuzzer.DumpMapCnt[dumpMapKey] = coverageIndex + 1
+	fuzzer.Stats.statDumpTotal.Add(1)
+	dumpTotal := fuzzer.Stats.statDumpTotal.Val()
+
+	if dumpTotal%10000 == 0 {
+		fuzzer.Logf(0, "[SyzPilot] dumped %d pairs of <program, coverage> (%d programs)", dumpTotal, len(fuzzer.DumpMapCnt))
+		debuglogger.Log(false, "dumped %d pairs of <program, coverage> (%d programs)", dumpTotal, len(fuzzer.DumpMapCnt))
+	}
+	return nil
+}
