+	first, second := entry, entry
+	first.Path = "duplicate_a"
+	second.Path = "duplicate_b"
+	catalog := coldStartSeedCatalog{
+		Schema:        coldStartCatalogSchema,
+		SchemaVersion: coldStartCatalogSchemaVersion,
+		Target: coldStartSeedCatalogTarget{
+			OS: target.OS, Arch: target.Arch, Revision: target.Revision,
+		},
+		Entries: []coldStartSeedCatalogEntry{first, second},
+	}
+	data, err := json.Marshal(catalog)
+	if err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(t.TempDir(), "catalog.json")
+	if err := os.WriteFile(path, data, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
+
+func writeFilteredColdStartCatalog(
+	t *testing.T, sourcePath string, callName string,
+) string {
+	t.Helper()
+	data, err := os.ReadFile(sourcePath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var catalog coldStartSeedCatalog
+	if err := json.Unmarshal(data, &catalog); err != nil {
+		t.Fatal(err)
+	}
+	var entries []coldStartSeedCatalogEntry
+	for _, entry := range catalog.Entries {
+		if slices.Contains(entry.NoGenerateCalls, callName) {
+			entries = append(entries, entry)
+		}
+	}
+	if len(entries) == 0 {
+		t.Fatalf("catalog has no entries for %q", callName)
+	}
+	catalog.Entries = entries
+	data, err = json.Marshal(catalog)
+	if err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(t.TempDir(), "catalog.json")
+	if err := os.WriteFile(path, data, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
+
+func TestAcceptGuidanceKeepsColdStartVersionPending(t *testing.T) {
+	mgr := &Manager{cfg: &mgrconfig.Config{SyzPilot: mgrconfig.SyzPilotCfg{
+		AllowStandaloneGuidance: true,
+	}}}
+	payload := &syzpilotlib.GuidancePayload{
+		Version:        1,
+		SyscallWeights: map[string]float64{"openat": 1},
+	}
+	result, err := mgr.acceptGuidance(payload)
+	if err != nil || result.Status != "pending" || result.Version != 1 {
+		t.Fatalf("cold guidance result = %+v, err=%v", result, err)
+	}
+	payload.SyscallWeights["openat"] = 99
+	if got := mgr.pendingGuidance.SyscallWeights["openat"]; got != 1 {
+		t.Fatalf("retained payload aliased request map: weight=%f", got)
+	}
+	if mgr.guidance != nil {
+		t.Fatal("pending guidance was committed before fuzzer activation")
+	}
+
+	retry := syzpilotlib.CloneGuidancePayload(mgr.pendingGuidance)
+	result, err = mgr.acceptGuidance(retry)
+	if err != nil || result.Status != "pending" {
+		t.Fatalf("idempotent retry result = %+v, err=%v", result, err)
+	}
+	conflict := syzpilotlib.CloneGuidancePayload(retry)
+	conflict.SyscallWeights["openat"] = 2
+	result, err = mgr.acceptGuidance(conflict)
+	if err == nil || mgr.pendingGuidance.SyscallWeights["openat"] != 1 {
+		t.Fatalf("pending conflict result = %+v, err=%v", result, err)
+	}
+	if _, err := mgr.acceptGuidance(&syzpilotlib.GuidancePayload{
+		Version:        -1,
+		SyscallWeights: map[string]float64{"openat": 1},
+	}); err == nil {
+		t.Fatal("invalid guidance version was accepted")
+	}
+
+	clear := &syzpilotlib.GuidancePayload{Version: 2}
+	result, err = mgr.acceptGuidance(clear)
+	if err != nil || result.Status != "pending" || result.Version != 2 {
+		t.Fatalf("clear guidance result = %+v, err=%v", result, err)
+	}
+	if mgr.pendingGuidance == nil || mgr.pendingGuidance.Version != 2 ||
+		len(mgr.pendingGuidance.SyscallWeights) != 0 ||
+		len(mgr.pendingGuidance.MutationTemplates) != 0 {
+		t.Fatalf("clear guidance was not retained exactly: %+v", mgr.pendingGuidance)
+	}
+	result, err = mgr.acceptGuidance(
+		syzpilotlib.CloneGuidancePayload(mgr.pendingGuidance),
+	)
+	if err != nil || result.Status != "pending" {
+		t.Fatalf("idempotent clear retry result = %+v, err=%v", result, err)
+	}
+}
+
+func TestAcceptGuidanceNormalizesEmptyCollectionsForIdempotence(t *testing.T) {
+	mgr := &Manager{cfg: &mgrconfig.Config{SyzPilot: mgrconfig.SyzPilotCfg{
+		AllowStandaloneGuidance: true,
+	}}}
+	newPayload := func() *syzpilotlib.GuidancePayload {
+		return &syzpilotlib.GuidancePayload{
+			Version:        1,
+			SyscallWeights: map[string]float64{},
+			GenerationHints: syzpilotlib.GenerationHints{
+				PreferredSyscalls: []string{"syz_mount_image$f2fs"},
+			},
+		}
+	}
+	result, err := mgr.acceptGuidance(newPayload())
+	if err != nil || result.Status != "pending" {
+		t.Fatalf("initial seed-only guidance = %+v, err=%v", result, err)
+	}
+	result, err = mgr.acceptGuidance(newPayload())
+	if err != nil || result.Status != "pending" {
+		t.Fatalf("idempotent seed-only retry = %+v, err=%v", result, err)
+	}
+}
