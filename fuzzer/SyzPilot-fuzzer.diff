+func TestCheckReachabilityBuildsFullCoverOnlyForArtifacts(t *testing.T) {
+	targets := []uint64{0x1000, 0x2000}
+	newFuzzer := func(enableDump bool) *Fuzzer {
+		return &Fuzzer{
+			Config:         &Config{SyzPilotCfg: mgrconfig.SyzPilotCfg{EnableDump: enableDump}},
+			TargetAddrVals: targets,
+			Stats: Stats{statReachability: []*stat.Val{
