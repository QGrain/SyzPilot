+func TestReachabilityObservationComplete(t *testing.T) {
+	completeFlags := flatrpc.CallFlagExecuted | flatrpc.CallFlagFinished
+	request := func(calls int) *queue.Request {
+		return &queue.Request{Prog: &prog.Prog{Calls: make([]*prog.Call, calls)}}
+	}
+	result := func(status queue.Status, flags ...flatrpc.CallFlag) *queue.Result {
+		calls := make([]*flatrpc.CallInfo, len(flags))
+		for i, flag := range flags {
+			calls[i] = &flatrpc.CallInfo{Flags: flag}
+		}
+		return &queue.Result{
+			Status: status,
+			Info:   &flatrpc.ProgInfo{Calls: calls},
+		}
+	}
+
+	tests := []struct {
+		name string
+		req  *queue.Request
+		res  *queue.Result
+		want bool
+	}{
+		{
+			name: "successful complete program",
+			req:  request(2),
+			res:  result(queue.Success, completeFlags, completeFlags),
+			want: true,
+		},
+		{
+			name: "hanged result with partial coverage",
+			req:  request(1),
+			res:  result(queue.Hanged, completeFlags),
+		},
+		{
+			name: "executor failure",
+			req:  request(1),
+			res:  result(queue.ExecFailure, completeFlags),
+		},
+		{
+			name: "started but unfinished call",
+			req:  request(1),
+			res:  result(queue.Success, flatrpc.CallFlagExecuted),
+		},
+		{
+			name: "call never started",
+			req:  request(1),
+			res:  result(queue.Success, 0),
+		},
+		{
+			name: "missing call record",
+			req:  request(2),
+			res:  result(queue.Success, completeFlags),
+		},
+		{
+			name: "missing program info",
+			req:  request(1),
+			res:  &queue.Result{Status: queue.Success},
+		},
+		{
+			name: "nil result",
+			req:  request(1),
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			if got := reachabilityObservationComplete(test.req, test.res); got != test.want {
+				t.Fatalf("reachabilityObservationComplete() = %v, want %v", got, test.want)
+			}
+		})
+	}
+}
