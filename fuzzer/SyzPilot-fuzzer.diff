+func TestCheckReachabilityRejectsTruncatedIncompleteLabels(t *testing.T) {
+	targets := []uint64{0x1000, 0x2000, 0x3000}
+	newFuzzer := func() *Fuzzer {
+		return &Fuzzer{
+			TargetAddrVals: targets,
+			Stats: Stats{
+				statReachability: []*stat.Val{
+					stat.New("test truncated unreachable", "", stat.Simple, stat.NoGraph),
+					stat.New("test truncated target 1", "", stat.Simple, stat.NoGraph),
+					stat.New("test truncated target 2", "", stat.Simple, stat.NoGraph),
+					stat.New("test truncated target 3", "", stat.Simple, stat.NoGraph),
+				},
+				statReachabilityTruncated: stat.New(
+					"test reachability truncated", "", stat.Simple, stat.NoGraph),
+				statReachabilityTruncatedDeepest: []*stat.Val{
+					stat.New("test truncated deepest none", "", stat.Simple, stat.NoGraph),
+					stat.New("test truncated deepest target 1", "", stat.Simple, stat.NoGraph),
+					stat.New("test truncated deepest target 2", "", stat.Simple, stat.NoGraph),
+					stat.New("test truncated deepest target 3", "", stat.Simple, stat.NoGraph),
+				},
+			},
+		}
+	}
+
+	tests := []struct {
+		name          string
+		info          *flatrpc.ProgInfo
+		wantLabel     []bool
+		wantTruncated int
+		wantDeepest   int
+	}{
+		{
+			name: "call overflow with no target",
+			info: &flatrpc.ProgInfo{Calls: []*flatrpc.CallInfo{{
+				Flags: flatrpc.CallFlagCoverageOverflow,
+				Cover: []uint64{0x9999},
+			}}},
+			wantTruncated: 1,
+			wantDeepest:   0,
+		},
+		{
+			name: "call overflow with only shallow target",
+			info: &flatrpc.ProgInfo{Calls: []*flatrpc.CallInfo{{
+				Flags: flatrpc.CallFlagCoverageOverflow,
+				Cover: []uint64{targets[0], targets[1]},
+			}}},
+			wantTruncated: 1,
+			wantDeepest:   2,
+		},
+		{
+			name: "extra overflow with only shallow target",
+			info: &flatrpc.ProgInfo{
+				Calls: []*flatrpc.CallInfo{{Cover: []uint64{targets[0]}}},
+				Extra: &flatrpc.CallInfo{
+					Flags: flatrpc.CallFlagCoverageOverflow,
+					Cover: []uint64{0x9999},
+				},
+			},
+			wantTruncated: 1,
+			wantDeepest:   1,
+		},
+		{
+			name: "deepest target makes overflow label complete",
+			info: &flatrpc.ProgInfo{Calls: []*flatrpc.CallInfo{{
+				Flags: flatrpc.CallFlagCoverageOverflow,
+				Cover: []uint64{targets[0], targets[2]},
+			}}},
+			wantLabel: []bool{false, true, false, true},
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			fuzzer := newFuzzer()
+			got, _ := fuzzer.checkReachability(test.info)
+			if !slices.Equal(got, test.wantLabel) {
+				t.Fatalf("reachability = %v, want %v", got, test.wantLabel)
+			}
+			if got := fuzzer.statReachabilityTruncated.Val(); got != test.wantTruncated {
+				t.Fatalf("truncated count = %d, want %d", got, test.wantTruncated)
+			}
+			for i, counter := range fuzzer.statReachabilityTruncatedDeepest {
+				want := 0
+				if test.wantTruncated != 0 && i == test.wantDeepest {
+					want = 1
+				}
+				if got := counter.Val(); got != want {
+					t.Fatalf("truncated deepest[%d] count = %d, want %d", i, got, want)
+				}
+			}
+		})
+	}
+}
