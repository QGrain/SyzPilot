+	}
+	if cfg.Capacity != 256 || cfg.MutationProbability != 0.20 ||
+		cfg.AnchorPreserveProbability != 0.95 {
+		t.Fatalf("unexpected directed corpus defaults: %+v", cfg)
+	}
+}
