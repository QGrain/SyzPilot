+import os
+import argparse
+import matplotlib.pyplot as plt
+
+def read_debug_log(log_path):
+    if not os.path.exists(log_path):
+        print(f"[ERROR] Log file does not exist: {log_path}")
+        return []
+
+    with open(log_path, 'r') as file:
+        lines = file.readlines()
+
+    return [line.strip() for line in lines if line.strip()]
+
+def parse_overhead(lines):
+    process_interval = []
+    dump_times = []
+    process_times = []
+
+    for line in lines:
+        try:
+            if "processResult() call interval" in line:
+                time_str = line.split("processResult() call interval")[1].strip()
+                process_interval.append(int(time_str[:-2]))
+            elif "dumpProgAndCover() took" in line:
+                time_str = line.split("dumpProgAndCover() took")[1].strip()
+                dump_times.append(int(time_str[:-2]))
+            elif "processResult() took" in line:
+                time_str = line.split("processResult() took")[1].strip()
+                process_times.append(int(time_str[:-2]))
+        except Exception as e:
+            print(f"[ERROR] Failed to parse log line: {e}\n  Line: {line}")
+            exit(1)
+
+    return process_interval, dump_times, process_times
+
+def compute_averages(process_interval, dump_times, process_times):
+    # Ignore the first process interval because it has no preceding sample.
+    if len(process_interval) > 1:
+        avg_interval = (sum(process_interval) - process_interval[0]) / (len(process_interval) - 1)
+    else:
+        avg_interval = 0
+    avg_dump_time = sum(dump_times) / len(dump_times) if dump_times else 0
+    avg_process_time = sum(process_times) / len(process_times) if process_times else 0
+    ratio = (sum(dump_times) / sum(process_times) * 100) if sum(process_times) > 0 else 0
+    return avg_interval, avg_dump_time, avg_process_time, ratio
+
+def print_summary(process_interval, dump_times, process_times, avg_interval, avg_dump_time, avg_process_time, ratio):
+    print("="*50)
+    print("LOG ANALYSIS SUMMARY".center(50))
+    print("="*50)
+    print(f"  Observed process intervals  : {len(process_interval)}")
+    print(f"  Observed dumpProgAndCover() : {len(dump_times)}")
+    print(f"  Observed processResult()    : {len(process_times)}")
+    print("-"*50)
+    print(f"  Average process interval                : {avg_interval:.2f} ms")
+    print(f"  Average dumpProgAndCover() time         : {avg_dump_time:.2f} ms")
+    print(f"  Average processResult() time            : {avg_process_time:.2f} ms")
+    print(f"  dumpProgAndCover()/processResult() ratio : {ratio:.2f}%")
+    print("="*50)
+
+def plot_overhead(process_interval, dump_times, process_times, output_path):
+    import numpy as np
+
+    N = min(len(process_interval), len(dump_times), len(process_times))
+    if N < 8:
+        print("[WARNING] Too few log entries to plot a trend.")
+        return
+
+    # Sample at one-eighth intervals.
+    step = max(1, N // 8)
+    indices = list(range(0, N, step))
+    if indices[-1] != N-1:
+        indices.append(N-1)
+
+    avg_intervals = []
+    avg_dumps = []
+    avg_processes = []
+    for idx in indices:
+        # Compute a prefix average through this sample.
+        if idx == 0:
+            avg_intervals.append(0)
+        else:
+            avg_intervals.append((sum(process_interval[:idx+1]) - process_interval[0]) / idx)
+        avg_dumps.append(sum(dump_times[:idx+1]) / (idx+1))
+        avg_processes.append(sum(process_times[:idx+1]) / (idx+1))
+
+    x = [i+1 for i in indices]
+
+    plt.figure(figsize=(10,6))
+    plt.plot(x, avg_intervals, marker='o', label='Avg process interval (ms)')
+    plt.plot(x, avg_dumps, marker='s', label='Avg dumpProgAndCover() (ms)')
+    plt.plot(x, avg_processes, marker='^', label='Avg processResult() (ms)')
+    plt.xlabel("number of execution")
+    plt.ylabel("average time overhead (ms)")
+    plt.title("time overhead over execution")
+    plt.legend()
+    plt.grid(True)
+    plt.tight_layout()
+
+    # Derive an output file name when the argument is a directory.
+    if os.path.isdir(output_path):
+        output_file = os.path.join(output_path, "time_overhead.png")
+    else:
+        output_file = output_path
+        if not (output_file.endswith(".png") or output_file.endswith(".jpg") or output_file.endswith(".jpeg")):
+            output_file += ".png"
+    plt.savefig(output_file)
+    print(f"[INFO] Saved plot to: {output_file}")
+
+def main():
+    parser = argparse.ArgumentParser(description="Parse and visualize time overhead from debug log.")
+    parser.add_argument("log_path", type=str, help="Path to the debug log file.")
+    parser.add_argument("-n", "--max-entries", type=int, default=None,
+                        help="Maximum number of complete log samples to analyze")
+    parser.add_argument("-o", "--output", type=str, default=".",
+                        help="Output image path or directory")
+    args = parser.parse_args()
+
+    lines = read_debug_log(args.log_path)
+    if not lines:
+        print("[ERROR] The log contains no valid entries.")
+        return
+
+    process_interval, dump_times, process_times = parse_overhead(lines)
+    N = min(len(process_interval), len(dump_times), len(process_times))
+    if N == 0:
+        print("[ERROR] The log contains no complete dump/process timing sample.")
+        return
+
+    if args.max_entries is not None:
+        N = min(N, args.max_entries)
+        process_interval = process_interval[:N]
+        dump_times = dump_times[:N]
+        process_times = process_times[:N]
+
+    avg_interval, avg_dump_time, avg_process_time, ratio = compute_averages(process_interval, dump_times, process_times)
+    print_summary(process_interval, dump_times, process_times, avg_interval, avg_dump_time, avg_process_time, ratio)
+    plot_overhead(process_interval, dump_times, process_times, args.output)
+
+if __name__ == "__main__":
+    main()
