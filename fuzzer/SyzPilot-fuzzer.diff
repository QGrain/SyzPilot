+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(allSeeds) != 731 {
+		t.Fatalf("loaded %d cataloged seeds, want 731", len(allSeeds))
+	}
+	seeds := coldStartSeedsForCall(allSeeds, "syz_mount_image$f2fs")
+	if len(seeds) != 16 {
+		t.Fatalf("loaded %d F2FS seeds, want 16", len(seeds))
+	}
+	selected := selectColdStartSeeds(allSeeds,
+		[]int{target.SyscallMap["syz_mount_image$f2fs"].ID})
+	if len(selected) != 16 {
+		t.Fatalf("selected %d F2FS seeds, want 16", len(selected))
+	}
+	enabled := make(map[*prog.Syscall]bool)
+	for _, call := range target.Syscalls {
+		if !call.Attrs.Disabled {
+			enabled[call] = true
+		}
+	}
+	already := make(map[string]bool)
+	candidates, identities, rejected := coldStartSeedCandidates(
+		seeds, enabled,
+		[]string{"openat", "syz_mount_image$f2fs", "syz_mount_image$f2fs"},
+		nil, already,
+	)
+	if len(candidates) != 16 || len(identities) != 16 ||
+		rejected.injected != 16 || rejected.rejected != 0 {
+		t.Fatalf("selected seeds=%d identities=%d result=%+v, want 16/16 accepted",
+			len(candidates), len(identities), rejected)
+	}
+	for _, candidate := range candidates {
+		if candidate.Flags != fuzzer.ProgMinimized ||
+			!programContainsCall(candidate.Prog, "syz_mount_image$f2fs") {
+			t.Fatalf("invalid candidate: flags=%v program=%s",
+				candidate.Flags, candidate.Prog.Serialize())
+		}
+	}
+	already[identities[0]] = true
+	candidates, identities, rejected = coldStartSeedCandidates(
+		seeds, enabled, []string{"syz_mount_image$f2fs"}, nil, already,
+	)
+	if len(candidates) != 15 || len(identities) != 15 ||
+		rejected.injected != 15 || rejected.reused != 1 || rejected.rejected != 0 {
+		t.Fatalf("per-seed retry = %d/%d/%+v, want 15/15 with one reused",
+			len(candidates), len(identities), rejected)
+	}
+
+	unrelated, err := target.Deserialize([]byte("getpid()"), prog.Strict)
+	if err != nil {
+		t.Fatal(err)
+	}
+	initial := make([]fuzzer.Candidate, 0, len(seeds)+1)
+	for _, seed := range seeds {
+		initial = append(initial, fuzzer.Candidate{Prog: seed.program.Clone()})
+	}
+	initial = append(initial, fuzzer.Candidate{Prog: unrelated})
+	native := findNativeColdStartSeeds(initial, seeds)
+	if len(native) != 16 || len(initial) != 17 ||
+		initial[len(initial)-1].Prog.String() != unrelated.String() {
+		t.Fatalf("native=%d candidates=%d, want 16/17 without removal",
+			len(native), len(initial))
+	}
+	candidates, identities, rejected = coldStartSeedCandidates(
+		seeds, enabled, []string{"syz_mount_image$f2fs"}, native, nil,
+	)
+	if len(candidates) != 16 || len(identities) != 16 ||
+		rejected.native != 16 || rejected.injected != 16 || rejected.reused != 0 {
+		t.Fatalf("native selection = %d/%d/%+v, want 16 additive candidates",
+			len(candidates), len(identities), rejected)
+	}
+
+	candidates, identities, rejected = coldStartSeedCandidates(
+		seeds, map[*prog.Syscall]bool{}, []string{"syz_mount_image$f2fs"}, nil, nil,
+	)
+	if len(candidates) != 0 || len(identities) != 0 || rejected.rejected != 16 ||
+		rejected.injected != 0 {
+		t.Fatalf("disabled selection = %d/%d/%+v, want 0/0/16 rejected",
+			len(candidates), len(identities), rejected)
+	}
+
+	seedName := "syz_mount_image_f2fs_0"
+	seedData, err := os.ReadFile(filepath.Join(seedDir, seedName))
+	if err != nil {
+		t.Fatal(err)
+	}
+	tamperedDir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(tamperedDir, seedName),
+		append(seedData, '\n'), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	tamperedCatalog := writeSingleSeedCatalog(t, target, seedName, seedData)
