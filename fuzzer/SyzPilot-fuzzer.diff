+// ObserveTemplateMutation publishes a complete partition of template mutation
+// attempts to the standard benchmark statistics stream.
+func (stats *Stats) ObserveTemplateMutation(outcome prog.TemplateMutationOutcome) {
+	if stats.statTemplateAttempts != nil {
+		stats.statTemplateAttempts.Add(1)
+	}
+	var counter *stat.Val
+	switch outcome {
+	case prog.TemplateMutationSucceeded:
+		counter = stats.statTemplateSucceeded
+	case prog.TemplateMutationUnavailable:
+		counter = stats.statTemplateUnavailable
+	case prog.TemplateMutationNoCapacity:
+		counter = stats.statTemplateNoCapacity
+	case prog.TemplateMutationGenerationFailed:
+		counter = stats.statTemplateGeneration
+	case prog.TemplateMutationConstraintFailed:
+		counter = stats.statTemplateConstraint
+	case prog.TemplateMutationTooLarge:
+		counter = stats.statTemplateTooLarge
+	}
+	if counter != nil {
+		counter.Add(1)
+	}
 }
 
