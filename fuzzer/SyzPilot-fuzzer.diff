@@ -0,0 +1,133 @@
+package debuglogger
+
+import (
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/google/syzkaller/pkg/osutil"
+)
+
+type DebugLogger struct {
+	LogWriter io.Writer
+	mu        sync.Mutex
+}
+
+const (
+	DebugTagStr    = "[SyzPilot]"
+	DefaultLogName = "debuglogger.log"
+)
+
+var (
+	instance *DebugLogger
+	// once     sync.Once
+	// workdir  string
+	initOnce sync.Once
+)
+
+// Initialize sets up the DebugLogger instance with the specified workdir.
+func Initialize(workdir string) error {
+	var err error
+	initOnce.Do(func() {
+		logFilePath := filepath.Join(workdir, DefaultLogName)
+		var logFile *os.File
+		logFile, err = os.OpenFile(logFilePath, os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0644)
+		if err != nil {
+			fmt.Fprintf(os.Stderr, "failed to open log file: %v\n", err)
+			return
+		} else {
+			fmt.Fprintf(os.Stdout, "[*] DebugLogger initialized, writing to %s\n", logFilePath)
+		}
+		instance = &DebugLogger{
+			LogWriter: logFile,
+		}
+	})
+	return err
+}
+
+// Do nothing when DebugLogger is not initialized.
+func Log(toConsole bool, msg string, args ...interface{}) {
+	if instance == nil {
+		return
+	}
+	instance.log(toConsole, msg, args...)
+}
+
+// Log with caller information and pid.
+// Do nothing when DebugLogger is not initialized.
+func LogV(toConsole bool, hop int, msg string, args ...interface{}) {
+	if instance == nil {
+		return
+	}
+	pid := os.Getpid()
+	pc, file, line, ok := runtime.Caller(hop + 1)
+	if ok {
+		funcName := runtime.FuncForPC(pc).Name()
+		instance.log(toConsole, fmt.Sprintf("[Caller:%s:%d %s][pid:%d] %s", file, line, funcName, pid, msg), args...)
+		return
+	}
+	instance.log(toConsole, msg, args...)
+}
+
+func (dl *DebugLogger) log(toConsole bool, msg string, args ...interface{}) {
+	dl.mu.Lock()
+	defer dl.mu.Unlock()
+
+	timeStr := time.Now().Format("2006/01/02 15:04:05")
+	var newArgs []interface{}
+	if strings.Contains(msg, DebugTagStr) {
+		newArgs = append([]interface{}{timeStr}, args...)
+		msg = fmt.Sprintf("%s "+msg, newArgs...)
+	} else {
+		newArgs = append([]interface{}{timeStr}, DebugTagStr)
+		newArgs = append(newArgs, args...)
+		msg = fmt.Sprintf("%s %s "+msg, newArgs...)
+	}
+
+	if strings.Contains(msg, DebugTagStr) {
+		if toConsole {
+			fmt.Fprintln(io.MultiWriter(dl.LogWriter, os.Stdout), msg)
+		} else {
+			fmt.Fprintln(dl.LogWriter, msg)
+		}
+	}
+	// // force flush
+	// if logFile, ok := dl.LogWriter.(*os.File); ok {
+	// 	logFile.Sync()
+	// }
+}
+
+func (dl *DebugLogger) DumpFile(filePath string, data []byte) {
+	dl.mu.Lock()
+	defer dl.mu.Unlock()
+
+	outDir, _ := filepath.Split(filePath)
+	if outDir == "" {
+		return
+	}
+	osutil.MkdirAll(outDir)
+	osutil.WriteFile(filePath, data)
+}
+
+func Close() {
+	if instance != nil {
+		instance.close()
+	}
+}
+
+func (dl *DebugLogger) close() {
+	dl.mu.Lock()
+	defer dl.mu.Unlock()
+
+	if dl.LogWriter != nil {
+		if logFile, ok := dl.LogWriter.(*os.File); ok {
+			logFile.Close()
+		}
+		dl.LogWriter = nil
+	}
+}
