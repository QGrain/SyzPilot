+// httpModelReady handles the model deployment notification from SyzPilot-Brain controller.
+// POST /model_ready with JSON body: {"model_name": "...", "model_version": "..."}
+func (serv *HTTPServer) httpModelReady(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodPost {
+		http.Error(w, "Method not allowed", http.StatusMethodNotAllowed)
+		return
+	}
+
+	var req struct {
+		ModelName    string `json:"model_name"`
+		ModelVersion string `json:"model_version"`
+	}
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+		http.Error(w, fmt.Sprintf("Invalid JSON: %v", err), http.StatusBadRequest)
+		return
+	}
+
+	if req.ModelName == "" {
+		http.Error(w, "model_name is required", http.StatusBadRequest)
+		return
+	}
+
+	log.Logf(0, "[SyzPilot] Received model deployment notification: name=%s, version=%s",
+		req.ModelName, req.ModelVersion)
+
+	if serv.OnModelReady != nil {
+		if err := serv.OnModelReady(req.ModelName, req.ModelVersion); err != nil {
+			http.Error(w, err.Error(), http.StatusServiceUnavailable)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		w.WriteHeader(http.StatusOK)
+		json.NewEncoder(w).Encode(map[string]string{
+			"status": "active", "model_name": req.ModelName,
+			"model_version": req.ModelVersion,
+		})
+	} else {
+		http.Error(w, "Model ready callback not configured", http.StatusInternalServerError)
+	}
+}
+
+func (serv *HTTPServer) httpModelStatus(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodGet {
+		http.Error(w, "Method not allowed", http.StatusMethodNotAllowed)
+		return
+	}
+	if serv.OnModelStatus == nil {
+		http.Error(w, "Model status callback not configured", http.StatusInternalServerError)
+		return
+	}
+	modelName, modelVersion := serv.OnModelStatus()
+	w.Header().Set("Content-Type", "application/json")
+	json.NewEncoder(w).Encode(map[string]string{
+		"status": "ok", "model_name": modelName,
+		"model_version": modelVersion,
+	})
+}
+
+// httpGuidance handles syscall guidance from SyzPilot-Brain controller.
+// POST /guidance with JSON body: GuidancePayload
+func (serv *HTTPServer) httpGuidance(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodPost {
+		http.Error(w, "Method not allowed", http.StatusMethodNotAllowed)
+		return
+	}
+
+	var req syzpilotlib.GuidancePayload
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+		http.Error(w, fmt.Sprintf("Invalid JSON: %v", err), http.StatusBadRequest)
+		return
+	}
+
+	log.Logf(0, "[SyzPilot] Received guidance: version=%d, %d syscall weights, %d templates",
+		req.Version, len(req.SyscallWeights), len(req.MutationTemplates))
+
+	if serv.OnGuidance != nil {
+		result, err := serv.OnGuidance(&req)
+		if err != nil {
+			http.Error(w, err.Error(), http.StatusConflict)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		if result.Status == "pending" {
+			w.WriteHeader(http.StatusAccepted)
+		} else {
+			w.WriteHeader(http.StatusOK)
+		}
+		if err := json.NewEncoder(w).Encode(result); err != nil {
+			log.Logf(0, "[SyzPilot] Failed to encode guidance response: %v", err)
+		}
+	} else {
+		http.Error(w, "Guidance callback not configured", http.StatusInternalServerError)
+	}
+}
