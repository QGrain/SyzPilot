@@ -0,0 +1,98 @@
+#!/usr/bin/env python3
+"""
+Test script for analyze_dump.py to verify functionality.
+"""
+
+import os
+import tempfile
+from pathlib import Path
+import subprocess
+import sys
+
+def create_test_dump_dir(temp_dir):
+    """Create a test dump directory structure."""
+    dump_dir = Path(temp_dir) / "test_dump"
+    programs_dir = dump_dir / "programs"
+    coverage_dir = dump_dir / "coverage"
+
+    # Create directories
+    programs_dir.mkdir(parents=True)
+    coverage_dir.mkdir(parents=True)
+
+    # Create test program files
+    test_programs = [
+        "abc123def456",
+        "xyz789uvw012",
+        "empty_program",
+        "normal_program1",
+        "normal_program2"
+    ]
+
+    for prog in test_programs:
+        prog_file = programs_dir / prog
+        if prog == "empty_program":
+            prog_file.touch()  # Empty file
+        else:
+            prog_file.write_text(f"test content for {prog}")
+
+    # Create test coverage files
+    test_coverage = [
+        "abc123def456-1",
+        "abc123def456-2",
+        "normal_program1-1",
+        "normal_program1-2",
+        "normal_program2-1",
+        "empty_coverage-1",  # Empty coverage file
+        "empty_coverage-2"   # Empty coverage file
+    ]
+
+    for cov in test_coverage:
+        cov_file = coverage_dir / cov
+        if "empty_coverage" in cov:
+            cov_file.touch()  # Empty file
+        else:
+            cov_file.write_text(f"coverage data for {cov}")
+
+    # Note: xyz789uvw012 has no coverage files
+    # Note: empty_program has no coverage files
+    # Note: normal_program2 has coverage but normal_program1 is missing
+
+    return str(dump_dir)
+
+def test_analyze_dump():
+    """Test the analyze_dump.py script."""
+    print("Creating test dump directory...")
+    with tempfile.TemporaryDirectory() as temp_dir:
+        test_dump_dir = create_test_dump_dir(temp_dir)
+
+        print(f"Test dump directory: {test_dump_dir}")
+        print("Running analyze_dump.py...")
+        print("-" * 50)
+
+        try:
+            # Run the analyze script while the temporary fixture still exists.
+            result = subprocess.run([
+                sys.executable, "tools/analyze_dump.py", test_dump_dir
+            ], capture_output=True, text=True, cwd=Path.cwd())
+
+            print("STDOUT:")
+            print(result.stdout)
+
+            if result.stderr:
+                print("STDERR:")
+                print(result.stderr)
+
+            print(f"Return code: {result.returncode}")
+
+            if result.returncode == 0:
+                print("Test completed successfully.")
+            else:
+                print("Test failed.")
+            return result.returncode
+
+        except Exception as e:
+            print(f"Error running test: {e}")
+            return 1
+
+if __name__ == "__main__":
+    raise SystemExit(test_analyze_dump())
