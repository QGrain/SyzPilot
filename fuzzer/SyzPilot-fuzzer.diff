diff --git a/pkg/fuzzer/rfilter/rfilter.go b/pkg/fuzzer/rfilter/rfilter.go
new file mode 100644
index 0000000..6c99411
--- /dev/null
+++ b/pkg/fuzzer/rfilter/rfilter.go
@@ -0,0 +1,464 @@
+package rfilter
+
+import (
+	"errors"
+	"fmt"
+	"log"
+	"math"
+	"math/rand/v2"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/google/syzkaller/pkg/fuzzer/queue"
+	"github.com/google/syzkaller/pkg/mgrconfig"
+)
+
+type ReachFilterSource struct {
+	base            queue.Source
+	createT         time.Time
+	startAfter      time.Duration
+	batchSize       int
+	maxFilterRounds int
+	schedCfg        *SchedulingConfig
+	targetCount     int
+	totalCnt        int64
+	filteredCnt     int64
+	predictor       batchPredictor
+	onSmash         func(*queue.Request)
+	onFiltered      func()
+
+	inferCh   chan inferenceRequest
+	inferDone chan struct{}
+	inferWG   sync.WaitGroup
+	closeOnce sync.Once
+}
+
+type batchPredictor interface {
+	PredictBatch(progs [][]byte) ([]map[string]float64, []error)
+}
+
+type inferenceRequest struct {
+	req        *queue.Request
+	allowSmash bool
+	result     chan inferenceDecision
+}
+
+type inferenceDecision struct {
+	keep  bool
+	smash bool
+}
+
+var ErrReachabilityFiltered = errors.New("request filtered by reachability prediction")
+
+type SourceOptions struct {
+	SchedulingStart time.Time
+	OnSmash         func(*queue.Request)
+	OnFiltered      func()
+}
+
+type SchedulingConfig struct {
+	Type   int
+	Alpha  float64
+	Beta   float64
+	Lambda float64
+}
+
+var statName2QueueType = map[string]string{
+	"candidate triage jobs": "triageCandidateQueue",
+	"exec candidate":        "candidateQueue",
+	"exec triage":           "triageQueue",
+	"exec minimize":         "triageQueue",
+	"exec smash":            "smashQueue",
+	"exec seeds":            "smashQueue",
+	"exec hints":            "smashQueue",
+	"exec inject":           "smashQueue",
+	"exec fuzz":             "genFuzzQueue",
+	"exec gen":              "genFuzzQueue",
+	"exec collide":          "genFuzzQueue",
+}
+
+var whiteListQueue = map[string]struct{}{
+	"triageCandidateQueue": {},
+	"candidateQueue":       {},
+	"triageQueue":          {},
+	"otherQueue":           {},
+}
+
+func NewRFSource(
+	base queue.Source,
+	syzpilotcfg mgrconfig.SyzPilotCfg,
+	predictor batchPredictor,
+	options ...SourceOptions,
+) *ReachFilterSource {
+	schedCfg := &SchedulingConfig{
+		Type:   syzpilotcfg.SchedulingStrategy.Type,
+		Alpha:  syzpilotcfg.SchedulingStrategy.Alpha,
+		Beta:   syzpilotcfg.SchedulingStrategy.Beta,
+		Lambda: syzpilotcfg.SchedulingStrategy.Lambda,
+	}
+	if schedCfg.Type <= 0 || schedCfg.Type > 3 {
+		schedCfg.Type = 3
+	}
+	if schedCfg.Alpha <= 0 || schedCfg.Alpha > 1 {
+		schedCfg.Alpha = 0.6
+	}
+	if schedCfg.Beta <= 0 {
+		schedCfg.Beta = 0.6
+	}
+	if schedCfg.Lambda <= 0 {
+		schedCfg.Lambda = 0.03
+	}
+
+	batchSize := syzpilotcfg.ReachFilter.BatchSize
+	if batchSize <= 0 {
+		batchSize = 16
+	}
+	startAfter, err := parseStartAfter(syzpilotcfg.ReachFilter.StartAfter)
+	if err != nil {
+		log.Printf("[rfilter] invalid start_after %q, starting immediately: %v",
+			syzpilotcfg.ReachFilter.StartAfter, err)
+	}
+
+	schedulingStart := time.Now()
+	var sourceOptions SourceOptions
+	if len(options) > 0 {
+		sourceOptions = options[0]
+		if !sourceOptions.SchedulingStart.IsZero() {
+			schedulingStart = sourceOptions.SchedulingStart
+		}
+	}
+	rfs := &ReachFilterSource{
+		base:            base,
+		createT:         schedulingStart,
+		startAfter:      startAfter,
+		batchSize:       batchSize,
+		maxFilterRounds: 3,
+		schedCfg:        schedCfg,
+		targetCount:     len(syzpilotcfg.TargetPCs),
+		predictor:       predictor,
+		onSmash:         sourceOptions.OnSmash,
+		onFiltered:      sourceOptions.OnFiltered,
+		inferCh:         make(chan inferenceRequest, batchSize*4),
+		inferDone:       make(chan struct{}),
+	}
+	rfs.inferWG.Add(1)
+	go rfs.inferLoop()
+	return rfs
+}
+
+// ValidatePrediction rejects malformed or cross-stage model responses before
+// they can influence scheduling decisions.
+func ValidatePrediction(prediction map[string]float64, targetCount int) error {
+	if targetCount < 1 {
+		return fmt.Errorf("target count must be positive")
+	}
+	if _, exists := prediction["Unreachable"]; !exists {
+		return fmt.Errorf("missing Unreachable probability")
+	}
+	for label, probability := range prediction {
+		if math.IsNaN(probability) || math.IsInf(probability, 0) ||
+			probability < 0 || probability > 1 {
+			return fmt.Errorf("invalid probability for %s", label)
+		}
+	}
+
+	expected := map[string]struct{}{"Unreachable": {}}
+	_, hasReachable := prediction["Reachable"]
+	_, hasShallow := prediction["Reach_Shallow"]
+	_, hasDeep := prediction["Reach_Deep"]
+	switch {
+	case hasReachable:
+		expected["Reachable"] = struct{}{}
+	case hasShallow || hasDeep:
+		if targetCount < 2 {
+			return fmt.Errorf("Stage 2 requires at least two targets")
+		}
+		expected["Reach_Shallow"] = struct{}{}
+		expected["Reach_Deep"] = struct{}{}
+	default:
+		for index := 1; index <= targetCount; index++ {
+			expected[fmt.Sprintf("Reach_Func%d", index)] = struct{}{}
+		}
+	}
+	if len(prediction) != len(expected) {
+		return fmt.Errorf("prediction label count does not match a valid stage")
+	}
+	probabilitySum := 0.0
+	for label := range expected {
+		probability, exists := prediction[label]
+		if !exists {
+			return fmt.Errorf("missing probability for %s", label)
+		}
+		probabilitySum += probability
+	}
+	if math.Abs(probabilitySum-1) > 1e-3 {
+		return fmt.Errorf("probabilities sum to %g, want 1", probabilitySum)
+	}
+	return nil
+}
+
+func parseStartAfter(value string) (time.Duration, error) {
+	if value == "" {
+		return 0, nil
+	}
+	if len(value) > 1 && value[len(value)-1] == 'd' {
+		days, err := time.ParseDuration(value[:len(value)-1] + "h")
+		if err != nil {
+			return 0, err
+		}
+		return days * 24, nil
+	}
+	return time.ParseDuration(value)
+}
+
+// inferLoop is the sole inference worker. Each submitted request receives one
+// decision through its private result channel, so ownership never moves to a
+// second execution queue.
+func (rfs *ReachFilterSource) inferLoop() {
+	defer rfs.inferWG.Done()
+	for {
+		var first inferenceRequest
+		select {
+		case <-rfs.inferDone:
+			return
+		case first = <-rfs.inferCh:
+		}
+
+		batch := []inferenceRequest{first}
+	drainLoop:
+		for len(batch) < rfs.batchSize {
+			select {
+			case item := <-rfs.inferCh:
+				batch = append(batch, item)
+			default:
+				break drainLoop
+			}
+		}
+
+		requests := make([]*queue.Request, len(batch))
+		allowSmash := make([]bool, len(batch))
+		for i, item := range batch {
+			requests[i] = item.req
+			allowSmash[i] = item.allowSmash
+		}
+		decisions := rfs.Filter(requests, allowSmash)
+		for i, item := range batch {
+			item.result <- decisions[i]
+		}
+	}
+}
+
+func (rfs *ReachFilterSource) SkipOrNot(predMap map[string]float64) bool {
+	unreachableProb, exists := predMap["Unreachable"]
+	if !exists {
+		return false
+	}
+	maxProb := 0.0
+	for label, prob := range predMap {
+		if label != "Unreachable" && prob > maxProb {
+			maxProb = prob
+		}
+	}
+	if unreachableProb > maxProb {
+		skipProb := rfs.schedCfg.Alpha * (1 - math.Pow((1-unreachableProb), rfs.schedCfg.Beta))
+		finalProb := rfs.timeDecayProb(skipProb)
+		return rand.Float64() < finalProb
+	}
+	return false
+}
+
+func (rfs *ReachFilterSource) SmashOrNot(predMap map[string]float64) bool {
+	if rfs.schedCfg.Type <= 1 {
+		return false
+	}
+	unreachableProb, exists := predMap["Unreachable"]
+	if !exists {
+		return false
+	}
+	maxProb := 0.0
+	for label, prob := range predMap {
+		if label != "Unreachable" && prob > maxProb {
+			maxProb = prob
+		}
+	}
+	if unreachableProb >= maxProb {
+		return false
+	}
+	N := len(predMap)
+	smashProb := 0.0
+	if reachableProb, binaryStage := predMap["Reachable"]; binaryStage {
+		// Stage 1 only predicts generic reachability, so treat its single
+		// positive class as depth 1.
+		smashProb = 1 - math.Pow(1-reachableProb, rfs.schedCfg.Beta)
+	} else if shallowProb, ternaryStage := predMap["Reach_Shallow"]; ternaryStage {
+		// Stage 2 exposes two ordered positive groups. Weight Deep twice as
+		// strongly as Shallow while retaining the same normalized policy.
+		deepProb, hasDeep := predMap["Reach_Deep"]
+		if !hasDeep {
+			return false
+		}
+		shallowScore := 1 - math.Pow(1-shallowProb, rfs.schedCfg.Beta)
+		deepScore := 1 - math.Pow(1-deepProb, rfs.schedCfg.Beta)
+		smashProb = (shallowScore + 2*deepScore) / 2
+	} else {
+		for i := 1; i < N; i++ {
+			if vi, exists := predMap[fmt.Sprintf("Reach_Func%d", i)]; exists {
+				ki := float64(i)
+				smashProb += ki * (1 - math.Pow(1-vi, rfs.schedCfg.Beta))
+			}
+		}
+		smashProb /= float64(N - 1)
+	}
+	smashProb *= rfs.schedCfg.Alpha
+	finalProb := rfs.timeDecayProb(smashProb)
+	return rand.Float64() < finalProb
+}
+
+func (rfs *ReachFilterSource) timeDecayProb(baseProb float64) float64 {
+	if rfs.schedCfg.Type <= 2 {
+		return clampProbability(baseProb)
+	}
+	elapsedHours := time.Since(rfs.createT).Hours()
+	return clampProbability(baseProb * math.Exp(-rfs.schedCfg.Lambda*elapsedHours))
+}
+
+func clampProbability(probability float64) float64 {
+	if math.IsNaN(probability) || probability < 0 {
+		return 0
+	}
+	if probability > 1 {
+		return 1
+	}
+	return probability
+}
+
+func (rfs *ReachFilterSource) Filter(
+	unfilteredQueue []*queue.Request, allowSmash []bool,
+) []inferenceDecision {
+	progs := make([][]byte, len(unfilteredQueue))
+	for i, req := range unfilteredQueue {
+		progs[i] = req.Prog.Serialize()
+	}
+	decisions := make([]inferenceDecision, len(unfilteredQueue))
+	for i := range decisions {
+		decisions[i].keep = true
+	}
+	predMaps, errs := rfs.predictor.PredictBatch(progs)
+	errCount := 0
+	var firstErr error
+	for i := range unfilteredQueue {
+		if i >= len(predMaps) || i >= len(errs) {
+			errCount++
+			if firstErr == nil {
+				firstErr = fmt.Errorf("predictor returned %d predictions and %d errors for %d requests",
+					len(predMaps), len(errs), len(unfilteredQueue))
+			}
+			continue
+		}
+		if errs[i] != nil {
+			errCount++
+			if firstErr == nil {
+				firstErr = errs[i]
+			}
+			continue
+		}
+		if err := ValidatePrediction(predMaps[i], rfs.targetCount); err != nil {
+			errCount++
+			if firstErr == nil {
+				firstErr = err
+			}
+			continue
+		}
+		decisions[i].keep = !rfs.SkipOrNot(predMaps[i])
+		decisions[i].smash = decisions[i].keep && allowSmash[i] &&
+			rfs.SmashOrNot(predMaps[i])
+	}
+	if errCount > 0 {
+		log.Printf("[rfilter] %d/%d predictions failed (first error: %v)",
+			errCount, len(progs), firstErr)
+	}
+	return decisions
+}
+
+func (rfs *ReachFilterSource) GetTotalCnt() int64 {
+	return atomic.LoadInt64(&rfs.totalCnt)
+}
+
+func (rfs *ReachFilterSource) GetFilteredCnt() int64 {
+	return atomic.LoadInt64(&rfs.filteredCnt)
+}
+
+// Next returns each request at most once. Filtered requests are aborted without
+// execution so waiting jobs receive a terminal result, then another base
+// request is considered. Prediction failures and source shutdown fail open.
+func (rfs *ReachFilterSource) Next() *queue.Request {
+	filteredRounds := 0
+	for {
+		req := rfs.base.Next()
+		if req == nil {
+			return nil
+		}
+		atomic.AddInt64(&rfs.totalCnt, 1)
+
+		queueType := "otherQueue"
+		if req.Stat != nil {
+			if mapped, ok := statName2QueueType[req.Stat.Name()]; ok {
+				queueType = mapped
+			}
+		}
+		if _, ok := whiteListQueue[queueType]; ok ||
+			time.Since(rfs.createT) < rfs.startAfter ||
+			filteredRounds >= rfs.maxFilterRounds {
+			return req
+		}
+
+		item := inferenceRequest{
+			req:        req,
+			allowSmash: queueType == "genFuzzQueue",
+			result:     make(chan inferenceDecision, 1),
+		}
+		select {
+		case <-rfs.inferDone:
+			return req
+		case rfs.inferCh <- item:
+		}
+
+		var decision inferenceDecision
+		select {
+		case <-rfs.inferDone:
+			return req
+		case decision = <-item.result:
+		}
+		if decision.keep {
+			if decision.smash && rfs.onSmash != nil {
+				rfs.onSmash(req)
+			}
+			return req
+		}
+
+		atomic.AddInt64(&rfs.filteredCnt, 1)
+		if rfs.onFiltered != nil {
+			rfs.onFiltered()
+		}
+		req.Abort(&queue.Result{
+			Status: queue.Filtered,
+			Err:    ErrReachabilityFiltered,
+		})
+		filteredRounds++
+	}
+}
+
+// Done is closed as soon as Close begins.
+func (rfs *ReachFilterSource) Done() <-chan struct{} {
+	return rfs.inferDone
+}
+
+// Close stops accepting inference work and waits for the current prediction to
+// finish. This lets the owner close the Predictor without racing PredictBatch.
+func (rfs *ReachFilterSource) Close() {
+	rfs.closeOnce.Do(func() {
+		close(rfs.inferDone)
+		rfs.inferWG.Wait()
+	})
+}
