+func (fuzzer *Fuzzer) setFlagsForDiverseCover(queueType string, baseFlags flatrpc.ExecFlag) flatrpc.ExecOpts {
+	flags := baseFlags
+
+	// Training and observation-only controls require raw KCOV reachability
+	// evidence on every eligible execution.
+	reachabilityCoverage := (fuzzer.Config.SyzPilotCfg.ReachFilter.Enable ||
+		fuzzer.Config.SyzPilotCfg.ObserveTargetCoverage ||
+		fuzzer.Config.SyzPilotCfg.DirectedCorpus.Enable) &&
+		len(fuzzer.TargetAddrVals) > 0
+	diverseCoverage := fuzzer.shouldCollectCoverage(queueType)
+	if flags&flatrpc.ExecFlagCollectComps == 0 &&
+		(reachabilityCoverage || diverseCoverage) {
+		flags |= flatrpc.ExecFlagCollectCover
+		debuglogger.Log(false, "SyzPilot collecting reachability evidence for queue: %s", queueType)
+	}
+
+	return flatrpc.ExecOpts{
+		ExecFlags: flags,
+	}
+}
