+func (mgr *Manager) initSyzPilotClient(ctx context.Context) error {
+	startTime := time.Now()
+	if !mgr.cfg.SyzPilot.ReachFilter.Enable || mgr.cfg.SyzPilot.ReachFilter.Controller == "" {
+		return nil
+	}
+
+	_, httpPortStr, err := net.SplitHostPort(mgr.http.Cfg.HTTP)
+	if err != nil {
+		return fmt.Errorf("failed to parse syz-manager http address: %w", err)
+	}
+	httpPort, _ := strconv.Atoi(httpPortStr)
+	controllerIP, _, err := net.SplitHostPort(mgr.cfg.SyzPilot.ReachFilter.Controller)
+	if err != nil {
+		return fmt.Errorf("failed to parse syzpilot controller address: %w", err)
+	}
+
+	// create client and assign to mgr field
+	client, err := syzpilot_manager.NewClient(syzpilot_manager.Config{
+		NetworkMode:  mgr.cfg.SyzPilot.NetworkMode,
+		ServerAddr:   mgr.cfg.SyzPilot.ReachFilter.Controller,
+		HostIP:       mgr.cfg.SyzPilot.CallbackIP,
+		HostHttpPort: httpPort,
+		TargetFunc:   mgr.cfg.SyzPilot.TargetFunc,
+		ReportPath:   mgr.cfg.SyzPilot.ReportPath,
+		KallgraphDir: mgr.cfg.SyzPilot.KallgraphDir,
+		TargetOS:     mgr.target.OS, TargetArch: mgr.target.Arch,
+		TargetRevision:   mgr.target.Revision,
+		ProducerRevision: prog.GitRevision,
+		DescriptionsMode: mgr.cfg.Experimental.DescriptionsMode,
+	})
+	if err != nil {
+		return fmt.Errorf("failed to create syzpilot client: %w", err)
+	}
+	mgr.SyzPilotClient = client
+
+	// register to SyzPilot-brain controller
+	response, err := mgr.SyzPilotClient.Register(ctx, mgr.cfg.SyzPilot.TaskName)
+	if err != nil {
+		return fmt.Errorf("syzpilot client failed to register to brain controller: %w", err)
+	}
+	mgr.SyzPilotRTCfg = &syzpilotlib.SyzPilotRuntimeConfig{
+		TaskID:       response.TaskID,
+		ReceiverAddr: fmt.Sprintf("%s:%d", controllerIP, response.ReceiverPort),
+		TSServerAddr: fmt.Sprintf("%s:%d", controllerIP, response.TorchservePort),
+		ModelName:    response.ModelName,
+		ModelVersion: response.ModelVersion,
+	}
+
+	debuglogger.Log(true, "syzpilot client (%s) registered to brain controller (%s) with task (%s), cost %s",
+		mgr.SyzPilotClient.FuzzerID, mgr.SyzPilotClient.Config.ServerAddr, mgr.cfg.SyzPilot.TaskName, time.Since(startTime))
+	debuglogger.Log(true, "task ID: %s, receiver addr: %s, torchserve addr: %s", mgr.SyzPilotRTCfg.TaskID, mgr.SyzPilotRTCfg.ReceiverAddr, mgr.SyzPilotRTCfg.TSServerAddr)
+
+	return nil
+}
