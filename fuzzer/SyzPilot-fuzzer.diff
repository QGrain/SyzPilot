+		func(cfg *SyzPilotCfg) { cfg.DirectedCorpus.MutationProbability = 1.1 },
+		func(cfg *SyzPilotCfg) { cfg.DirectedCorpus.AnchorPreserveProbability = -0.1 },
+		func(cfg *SyzPilotCfg) { cfg.DirectedCorpus.AnchorPreserveProbability = 1.1 },
+		func(cfg *SyzPilotCfg) { cfg.DirectedCorpus.MutationProbability = 0 },
