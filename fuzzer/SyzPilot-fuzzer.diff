+func TestSchedulingEpochSurvivesSourceReplacement(t *testing.T) {
+	config := testConfig()
+	config.ReachFilter.StartAfter = "1h"
+	schedulingStart := time.Now().Add(-2 * time.Hour)
+	var calls atomic.Int64
+	predict := predictorFunc(func([][]byte) ([]map[string]float64, []error) {
+		calls.Add(1)
+		return []map[string]float64{{"Unreachable": 0, "Reach_Func1": 1}}, []error{nil}
+	})
+	options := SourceOptions{SchedulingStart: schedulingStart}
+
+	for index := 0; index < 2; index++ {
+		request := testRequest(stat.New("exec gen", "rfilter epoch test executions"))
+		source := NewRFSource(
+			&testSource{requests: []*queue.Request{request}},
+			config,
+			predict,
+			options,
+		)
+		if got := source.Next(); got != request {
+			t.Fatalf("replacement %d returned %p, want %p", index, got, request)
+		}
+		if !source.createT.Equal(schedulingStart) {
+			t.Fatalf("replacement %d reset scheduling epoch to %v", index, source.createT)
+		}
+		source.Close()
+	}
+	if calls.Load() != 2 {
+		t.Fatalf("predictor called %d times, want once for each source", calls.Load())
+	}
+}
