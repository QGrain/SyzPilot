+func (fuzzer *Fuzzer) shouldCollectCoverage(queueType string) bool {
+	if !fuzzer.DiverseCoverEnabled.Load() {
+		return false
+	}
+
+	// We don't need the lock here as the DiverseCoverTargets is static sofar.
+	// fuzzer.DiverseCoverMu.RLock()
+	isTargetQueue := fuzzer.DiverseCoverTargets[queueType]
+	// fuzzer.DiverseCoverMu.RUnlock()
+
+	if !isTargetQueue {
+		return false
+	}
+
+	rate := *fuzzer.DiverseCoverRatio.Load()
+	fuzzer.mu.Lock()
+	selected := fuzzer.rnd.Float64() < rate
+	fuzzer.mu.Unlock()
+	return selected
+}
