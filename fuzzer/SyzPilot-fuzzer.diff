+func TestCloseFailsOpenAndWaitsForPrediction(t *testing.T) {
+	executionStat := stat.New("exec gen", "rfilter close test executions")
+	request := testRequest(executionStat)
+	started := make(chan struct{})
+	release := make(chan struct{})
+	predict := predictorFunc(func([][]byte) ([]map[string]float64, []error) {
+		close(started)
+		<-release
+		return []map[string]float64{{"Unreachable": 1}}, []error{nil}
+	})
+	source := NewRFSource(&testSource{requests: []*queue.Request{request}}, testConfig(), predict)
+
+	nextResult := make(chan *queue.Request, 1)
+	go func() { nextResult <- source.Next() }()
+	<-started
+	closed := make(chan struct{})
+	go func() {
+		source.Close()
+		close(closed)
+	}()
+
+	select {
+	case got := <-nextResult:
+		if got != request {
+			t.Fatalf("Next() returned %p, want fail-open request %p", got, request)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("Next() did not fail open when source closed")
+	}
+	select {
+	case <-closed:
+		t.Fatal("Close() returned before in-flight prediction finished")
+	default:
+	}
+	close(release)
+	select {
+	case <-closed:
+	case <-time.After(time.Second):
+		t.Fatal("Close() did not return after prediction finished")
+	}
+}
