+struct CallEdge {
+    std::string caller_name;
+    std::string callsite_file;
+    unsigned callsite_line;
+    std::string callee_name;
+    std::string callee_file;
+    unsigned callee_line;
+    std::string call_type;
+    bool is_declaration;
+};
+
+std::vector<std::string> split(const std::string& s, char delim) {
+    std::vector<std::string> parts;
+    std::istringstream iss(s);
+    std::string part;
+    while (std::getline(iss, part, delim)) {
+        parts.push_back(part);
+    }
+    return parts;
+}
+
+std::vector<CallEdge> parseCSV(const std::string& path) {
+    std::vector<CallEdge> edges;
+    std::ifstream fin(path);
+    if (!fin.is_open()) {
+        std::cerr << "Error: cannot open CSV file: " << path << "\n";
+        exit(1);
+    }
+
+    std::string line;
+    if (std::getline(fin, line)) {
+        if (line.find("caller_name,") != 0) {
+            std::cerr << "Error: unexpected CSV header: " << line << "\n";
+            exit(1);
+        }
+    }
+
+    while (std::getline(fin, line)) {
+        if (line.empty()) continue;
+        auto parts = split(line, ',');
+        if (parts.size() != 8) {
+            std::cerr << "Warning: skipping malformed line (" << parts.size() << " fields): " << line << "\n";
+            continue;
+        }
+        CallEdge edge;
+        edge.caller_name = parts[0];
+        edge.callsite_file = parts[1];
+        edge.callsite_line = std::stoul(parts[2]);
+        edge.callee_name = parts[3];
+        edge.callee_file = parts[4];
+        edge.callee_line = std::stoul(parts[5]);
+        edge.call_type = parts[6];
+        edge.is_declaration = (parts[7] == "true");
+        edges.push_back(std::move(edge));
+    }
+    return edges;
+}
+
+struct GraphData {
+    igraph_t g;
+    std::vector<std::string> vertex_names;
+    std::unordered_map<std::string, int> name_to_vertex;
+    std::vector<std::vector<int>> out_neighbors;
+    std::map<std::pair<int,int>, std::string> edge_callsite;
+    std::map<std::pair<int,int>, std::string> edge_callee_def;
+};
+
+GraphData buildGraph(const std::vector<CallEdge>& edges) {
+    GraphData data;
+
+    // First pass: collect all unique function names
+    std::unordered_set<std::string> all_names;
+    for (const auto& e : edges) {
+        all_names.insert(e.caller_name);
+        all_names.insert(e.callee_name);
+    }
+
+    // Assign vertex IDs
+    std::vector<std::string> sorted_names(all_names.begin(), all_names.end());
+    std::sort(sorted_names.begin(), sorted_names.end());
+    int next_id = 0;
+    for (const auto& name : sorted_names) {
+        data.name_to_vertex[name] = next_id++;
+        data.vertex_names.push_back(name);
+    }
+    data.out_neighbors.resize(next_id);
+
+    // Second pass: build edge list and callsite maps
+    igraph_vector_t edge_list;
+    igraph_vector_init(&edge_list, 0);
+
+    for (const auto& e : edges) {
+        int caller_id = data.name_to_vertex[e.caller_name];
+        int callee_id = data.name_to_vertex[e.callee_name];
+
+        igraph_vector_push_back(&edge_list, caller_id);
+        igraph_vector_push_back(&edge_list, callee_id);
+
+        std::string callsite = e.callsite_file + ":" + std::to_string(e.callsite_line);
+        std::string callee_def = e.callee_file + ":" + std::to_string(e.callee_line);
+        auto key = std::make_pair(caller_id, callee_id);
+        if (data.edge_callsite.find(key) == data.edge_callsite.end()) {
+            data.edge_callsite[key] = callsite;
+            data.edge_callee_def[key] = callee_def;
+            data.out_neighbors[caller_id].push_back(callee_id);
+        }
+    }
+
+    for (auto& neighbors : data.out_neighbors) {
+        std::sort(neighbors.begin(), neighbors.end(),
+            [&data](int left, int right) {
+                return data.vertex_names[left] < data.vertex_names[right];
+            });
+    }
+
+    igraph_empty(&data.g, next_id, IGRAPH_DIRECTED);
+    igraph_add_edges(&data.g, &edge_list, NULL);
+    igraph_vector_destroy(&edge_list);
+
+    return data;
+}
