+void printUsage(const char* prog) {
+    std::cerr << "Usage: " << prog << " [options]\n"
+              << "Options:\n"
+              << "  --csv PATH        Path to callgraph.csv (required)\n"
+              << "  --target FUNC     Target function name (required)\n"
+              << "  --entry FUNC      Entry function name (single-entry mode)\n"
+              << "  --all-entries     Auto-detect all source nodes as entries\n"
+              << "  --relevant-entries  Find relevant syscall entries via reverse BFS, frequency-ranked output\n"
+              << "  --output PATH     Output file path (default: stdout)\n"
+              << "  --stats           Print graph statistics to stderr\n"
+              << "\nExactly one of --entry, --all-entries, or --relevant-entries must be specified.\n";
+}
+
+Config parseArgs(int argc, char* argv[]) {
+    Config cfg;
+    for (int i = 1; i < argc; i++) {
+        std::string arg = argv[i];
+        if (arg == "--csv" && i + 1 < argc) cfg.csv_path = argv[++i];
+        else if (arg == "--target" && i + 1 < argc) cfg.target = argv[++i];
+        else if (arg == "--entry" && i + 1 < argc) cfg.entry = argv[++i];
+        else if (arg == "--all-entries") cfg.all_entries = true;
+        else if (arg == "--relevant-entries") cfg.relevant_entries = true;
+        else if (arg == "--output" && i + 1 < argc) cfg.output_path = argv[++i];
+        else if (arg == "--stats") cfg.show_stats = true;
+        else if (arg == "--help" || arg == "-h") { printUsage(argv[0]); exit(0); }
+        else { std::cerr << "Unknown option: " << arg << "\n"; printUsage(argv[0]); exit(1); }
+    }
+    if (cfg.csv_path.empty()) { std::cerr << "Error: --csv is required\n"; exit(1); }
+    if (cfg.target.empty()) { std::cerr << "Error: --target is required\n"; exit(1); }
+    int mode_count = (!cfg.entry.empty() ? 1 : 0) + (cfg.all_entries ? 1 : 0) + (cfg.relevant_entries ? 1 : 0);
+    if (mode_count != 1) {
+        std::cerr << "Error: exactly one of --entry, --all-entries, or --relevant-entries must be specified\n"; exit(1);
+    }
+    return cfg;
