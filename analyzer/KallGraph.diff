+
+std::string findCallsite(const GraphData& graph, int parent, int current) {
+    auto key = std::make_pair(parent, current);
+    auto it = graph.edge_callsite.find(key);
+    if (it != graph.edge_callsite.end()) return it->second;
+
+    // A dominator-tree parent is not necessarily a direct call-graph parent.
+    // Resolve a real connector path and use its first callsite.  The old
+    // fallback returned an arbitrary outgoing callsite from `parent`, which
+    // could point to a completely unrelated subsystem.
+    std::vector<int> predecessor(graph.vertex_names.size(), -1);
+    std::queue<int> worklist;
+    predecessor[parent] = parent;
+    worklist.push(parent);
+    while (!worklist.empty() && predecessor[current] == -1) {
+        int vertex = worklist.front();
+        worklist.pop();
+        for (int successor : graph.out_neighbors[vertex]) {
+            if (predecessor[successor] != -1) continue;
+            predecessor[successor] = vertex;
+            worklist.push(successor);
+        }
+    }
+
+    if (predecessor[current] == -1) return "unknown:0";
+    int first_hop = current;
+    while (predecessor[first_hop] != parent) {
+        first_hop = predecessor[first_hop];
+        if (first_hop == -1 || first_hop == parent) break;
+    }
+    auto connector = graph.edge_callsite.find(std::make_pair(parent, first_hop));
+    return connector == graph.edge_callsite.end() ? "unknown:0" : connector->second;
+}
+
+std::vector<Waypoint> computeDominatorChain(
+    const GraphData& graph,
+    int entry_vertex,
+    int target_vertex)
+{
+    igraph_integer_t vc = igraph_vcount(&graph.g);
+
+    // Check reachability first via BFS (igraph_reachable not available in 0.9.x)
+    igraph_vector_t reachable_vids;
+    igraph_vector_init(&reachable_vids, 0);
+    // igraph_bfs_simple takes non-const igraph_t*, but only reads
+    igraph_bfs_simple(const_cast<igraph_t*>(&graph.g), entry_vertex, IGRAPH_OUT,
+                      &reachable_vids, NULL, NULL);
+
+    bool target_reachable = false;
+    for (long i = 0; i < igraph_vector_size(&reachable_vids); i++) {
+        if ((int)VECTOR(reachable_vids)[i] == target_vertex) {
+            target_reachable = true;
+            break;
+        }
+    }
+    igraph_vector_destroy(&reachable_vids);
+
+    if (!target_reachable) {
+        return {};  // Empty = unreachable
+    }
+
+    // Compute dominator tree
+    igraph_vector_t dom;
+    igraph_vector_init(&dom, vc);
+    igraph_dominator_tree(&graph.g, entry_vertex, &dom, NULL, NULL, IGRAPH_OUT);
+
+    // Step 1: walk backwards from target to entry to collect node IDs
+    std::vector<int> node_ids;
+    int current = target_vertex;
+    while (current != entry_vertex && current != -1) {
+        node_ids.push_back(current);
+        int parent = (int)VECTOR(dom)[current];
+        if (parent == -1) break;
+        current = parent;
+    }
+    node_ids.push_back(entry_vertex);
+
+    // Reverse to get entry -> ... -> target order
+    std::reverse(node_ids.begin(), node_ids.end());
+
+    // Step 2: build waypoints with correct locations
+    // For each function (except target), use callsite of edge to NEXT function
+    // For target, use its callee definition location
+    std::vector<Waypoint> chain;
+    for (size_t i = 0; i < node_ids.size(); i++) {
+        if (i + 1 < node_ids.size()) {
+            // Not the last node: use callsite of edge to next node
+            std::string loc = findCallsite(graph, node_ids[i], node_ids[i + 1]);
+            chain.push_back({graph.vertex_names[node_ids[i]], loc});
+        } else {
+            // Last node (target): find lexicographically smallest callee def
+            int target_id = node_ids[i];
+            std::string loc;
+            for (const auto& [k, v] : graph.edge_callee_def) {
+                if (k.second == target_id && (loc.empty() || v < loc)) {
+                    loc = v;
+                }
+            }
+            if (loc.empty()) {
+                loc = graph.vertex_names[target_id] + ":0";
+            }
+            chain.push_back({graph.vertex_names[target_id], loc});
+        }
+    }
+
+    igraph_vector_destroy(&dom);
+    return chain;
+}
+
+std::vector<int> detectSourceNodes(const GraphData& graph, const std::vector<CallEdge>& edges) {
+    std::unordered_set<std::string> callers;
+    std::unordered_set<std::string> callees;
+    for (const auto& e : edges) {
+        callers.insert(e.caller_name);
+        callees.insert(e.callee_name);
+    }
+
+    std::vector<int> sources;
+    for (const auto& name : callers) {
+        if (callees.find(name) == callees.end()) {
+            auto it = graph.name_to_vertex.find(name);
+            if (it != graph.name_to_vertex.end()) {
+                sources.push_back(it->second);
+            }
+        }
+    }
+    return sources;
+}
+
+// Reverse BFS from target: find all vertices that can reach the target
+std::unordered_set<int> reverseBFS(const GraphData& graph, int target_vertex) {
+    std::unordered_set<int> reachable;
+    // Build reverse adjacency list
+    std::unordered_map<int, std::vector<int>> reverse_adj;
+    for (const auto& [k, v] : graph.edge_callsite) {
+        reverse_adj[k.second].push_back(k.first);
+    }
+
+    // BFS from target in reverse graph
+    std::queue<int> q;
+    q.push(target_vertex);
+    reachable.insert(target_vertex);
+    while (!q.empty()) {
+        int u = q.front(); q.pop();
+        auto it = reverse_adj.find(u);
+        if (it != reverse_adj.end()) {
+            for (int v : it->second) {
+                if (reachable.find(v) == reachable.end()) {
+                    reachable.insert(v);
+                    q.push(v);
+                }
+            }
+        }
+    }
+    return reachable;
+}
+
+// Detect source nodes: functions that appear as caller but never as callee
+std::vector<int> detectSourceNodesInGraph(const GraphData& graph, const std::vector<CallEdge>& edges) {
+    std::unordered_set<std::string> callers, callees;
+    for (const auto& e : edges) {
+        callers.insert(e.caller_name);
+        callees.insert(e.callee_name);
+    }
+    std::vector<int> sources;
+    for (const auto& name : callers) {
+        if (callees.find(name) == callees.end()) {
+            auto it = graph.name_to_vertex.find(name);
+            if (it != graph.name_to_vertex.end()) {
+                sources.push_back(it->second);
+            }
+        }
+    }
+    return sources;
+}
+
+// Relevant entries mode: reverse BFS + frequency-ranked dominator chains
+void runRelevantEntries(const GraphData& graph, const std::vector<CallEdge>& edges,
+                        const Config& cfg, std::ostream* out) {
+    auto t0 = Clock::now();
+
+    // Find target vertex
+    auto target_it = graph.name_to_vertex.find(cfg.target);
+    if (target_it == graph.name_to_vertex.end()) {
+        std::cerr << "Error: target function '" << cfg.target << "' not found in call graph\n";
+        exit(1);
+    }
+    int target_vertex = target_it->second;
+
+    // Step 1: Reverse BFS to find all vertices that can reach target
+    auto t_bfs = Clock::now();
+    auto reachable = reverseBFS(graph, target_vertex);
+    auto t_bfs_end = Clock::now();
+    std::cerr << "Reverse BFS: " << reachable.size() << " vertices can reach target ("
+              << std::chrono::duration<double>(t_bfs_end - t_bfs).count() << "s)\n";
+
+    // Step 2: Find source nodes that can reach target
+    auto all_source_nodes = detectSourceNodesInGraph(graph, edges);
+    std::vector<int> relevant_entries;
+    for (int vid : all_source_nodes) {
+        if (reachable.count(vid)) {
+            relevant_entries.push_back(vid);
+        }
+    }
+    std::cerr << "Source nodes: " << all_source_nodes.size() << " total, "
+              << relevant_entries.size() << " can reach target\n";
+
+    if (relevant_entries.empty()) {
+        std::cerr << "Error: no source node can reach target '" << cfg.target << "'\n";
+        exit(1);
+    }
+
+    // Step 3: Compute dominator chains for each relevant entry
+    auto t_dom = Clock::now();
+    struct ChainResult {
+        std::string entry_name;
+        std::vector<Waypoint> chain;
+    };
+    std::vector<ChainResult> results;
+    std::unordered_map<std::string, int> func_frequency;  // func_name -> count
+    std::unordered_map<std::string, std::string> func_location;  // func_name -> best location
+
+    for (int entry_v : relevant_entries) {
+        auto chain = computeDominatorChain(graph, entry_v, target_vertex);
+        if (!chain.empty()) {
+            results.push_back({graph.vertex_names[entry_v], std::move(chain)});
+            // Count frequency
+            for (const auto& wp : results.back().chain) {
+                func_frequency[wp.func_name]++;
+                // Keep the location from the first occurrence
+                if (func_location.find(wp.func_name) == func_location.end()) {
+                    func_location[wp.func_name] = wp.location;
+                }
+            }
+        }
+    }
+    auto t_dom_end = Clock::now();
+    std::cerr << "Dominator computation: " << results.size() << " reachable entries, "
+              << std::chrono::duration<double>(t_dom_end - t_dom).count() << "s total\n";
+
+    // Step 4: Sort functions by frequency (descending), then by name
+    std::vector<std::pair<std::string, int>> sorted_funcs(func_frequency.begin(), func_frequency.end());
+    std::sort(sorted_funcs.begin(), sorted_funcs.end(),
+        [](const auto& a, const auto& b) {
+            if (a.second != b.second) return a.second > b.second;
+            return a.first < b.first;
+        });
+
+    // Step 5: Output
+    *out << "# Frequency-ranked waypoints for target: " << cfg.target << "\n";
+    *out << "# Format: func@location (frequency/total_entries)\n";
+    *out << "# Total relevant entries: " << relevant_entries.size()
+         << ", reachable: " << results.size() << "\n";
+    *out << "#\n";
+
+    // Output per-entry chains
+    *out << "\n# === Per-entry dominator chains ===\n";
+    for (const auto& result : results) {
+        *out << "# entry:" << result.entry_name
+             << " (chain_length=" << result.chain.size() << ")\n";
+        for (size_t i = 0; i < result.chain.size(); i++) {
+            if (i > 0) *out << ",";
+            *out << result.chain[i].func_name << "@" << result.chain[i].location;
+        }
+        *out << "\n";
+    }
+
+    // Output frequency-ranked waypoints
+    *out << "\n# === Frequency-ranked waypoints ===\n";
+    *out << "# func@location,frequency,ratio\n";
+    for (const auto& [func, freq] : sorted_funcs) {
+        auto loc_it = func_location.find(func);
+        std::string loc = (loc_it != func_location.end()) ? loc_it->second : "unknown:0";
+        double ratio = static_cast<double>(freq) / results.size();
+        *out << func << "@" << loc << "," << freq << "," << std::fixed << std::setprecision(3) << ratio << "\n";
+    }
+
+    auto t_end = Clock::now();
+    std::cerr << "Total time: " << std::chrono::duration<double>(t_end - t0).count() << "s\n";
+}
+
+void printStats(const GraphData& graph, const std::vector<CallEdge>& edges,
+                const std::string& target, const std::string& entry_mode) {
+    std::cerr << "\n=== Graph Statistics ===\n";
+    std::cerr << "Vertices: " << igraph_vcount(&graph.g) << "\n";
+    std::cerr << "Edges: " << igraph_ecount(&graph.g) << "\n";
+
+    std::unordered_set<std::string> callers, callees;
+    for (const auto& e : edges) {
+        callers.insert(e.caller_name);
+        callees.insert(e.callee_name);
+    }
+    int source_count = 0;
+    for (const auto& c : callers) {
+        if (callees.find(c) == callees.end()) source_count++;
+    }
+    std::cerr << "Source nodes: " << source_count << "\n";
+
+    // Only compute source-node reachability for all-entries/relevant-entries modes.
+    // In single-entry mode this is unnecessary and extremely expensive (O(sources * (V+E))).
+    if (entry_mode.empty()) {
+        auto target_it = graph.name_to_vertex.find(target);
+        if (target_it != graph.name_to_vertex.end()) {
+            auto sources = detectSourceNodes(graph, edges);
+            int reachable_entries = 0;
+            for (int src : sources) {
+                igraph_vector_t vids;
+                igraph_vector_init(&vids, 0);
+                igraph_bfs_simple(const_cast<igraph_t*>(&graph.g), src, IGRAPH_OUT,
+                                  &vids, NULL, NULL);
+                for (long j = 0; j < igraph_vector_size(&vids); j++) {
+                    if ((int)VECTOR(vids)[j] == target_it->second) {
+                        reachable_entries++;
+                        break;
+                    }
+                }
+                igraph_vector_destroy(&vids);
+            }
+            std::cerr << "Entries reaching target: " << reachable_entries << "\n";
+        }
+    }
+    std::cerr << "========================\n\n";
+}
+
+int main(int argc, char* argv[]) {
+    Config cfg = parseArgs(argc, argv);
+    std::cerr << "DominatorAnalyzer: csv=" << cfg.csv_path
+              << " target=" << cfg.target;
+    if (!cfg.entry.empty()) std::cerr << " entry=" << cfg.entry;
+    else if (cfg.all_entries) std::cerr << " all-entries";
+    else if (cfg.relevant_entries) std::cerr << " relevant-entries";
+    std::cerr << "\n";
+
+    auto t_total_start = Clock::now();
+
+    auto t0 = Clock::now();
+    auto edges = parseCSV(cfg.csv_path);
+    auto t1 = Clock::now();
+    std::cerr << "Parsed " << edges.size() << " edges from CSV ("
+              << std::chrono::duration<double>(t1 - t0).count() << "s)\n";
+
+    if (edges.empty()) {
+        std::cerr << "Error: call graph is empty\n";
+        return 1;
+    }
+
+    t0 = Clock::now();
+    GraphData graph = buildGraph(edges);
+    t1 = Clock::now();
+    std::cerr << "Built graph: " << igraph_vcount(&graph.g) << " vertices, "
+              << igraph_ecount(&graph.g) << " edges ("
+              << std::chrono::duration<double>(t1 - t0).count() << "s)\n";
+
+    if (cfg.show_stats) {
+        printStats(graph, edges, cfg.target, cfg.entry);
+    }
+
+    // Output stream
+    std::ostream* out = &std::cout;
+    std::ofstream fout;
+    if (!cfg.output_path.empty()) {
+        fout.open(cfg.output_path);
+        if (!fout.is_open()) {
+            std::cerr << "Error: cannot open output file: " << cfg.output_path << "\n";
+            return 1;
+        }
+        out = &fout;
+    }
+
+    if (!cfg.entry.empty()) {
+        // Single-entry mode
+        auto entry_it = graph.name_to_vertex.find(cfg.entry);
+        if (entry_it == graph.name_to_vertex.end()) {
+            std::cerr << "Error: entry function '" << cfg.entry << "' not found in call graph\n";
+            return 1;
+        }
+        auto target_it = graph.name_to_vertex.find(cfg.target);
+        if (target_it == graph.name_to_vertex.end()) {
+            std::cerr << "Error: target function '" << cfg.target << "' not found in call graph\n";
+            return 1;
+        }
+
+        t0 = Clock::now();
+        auto chain = computeDominatorChain(graph, entry_it->second, target_it->second);
+        t1 = Clock::now();
+        std::cerr << "Dominator computation: " << std::chrono::duration<double>(t1 - t0).count() << "s\n";
+        if (chain.empty()) {
+            std::cerr << "Error: target '" << cfg.target << "' is not reachable from entry '"
+                      << cfg.entry << "'\n";
+            return 1;
+        }
+
+        for (size_t i = 0; i < chain.size(); i++) {
+            if (i > 0) *out << ",";
+            *out << chain[i].func_name << "@" << chain[i].location;
+        }
+        *out << "\n";
+    } else if (cfg.all_entries) {
+        // All-entries mode
+        auto target_it = graph.name_to_vertex.find(cfg.target);
+        if (target_it == graph.name_to_vertex.end()) {
+            std::cerr << "Error: target function '" << cfg.target << "' not found in call graph\n";
+            return 1;
+        }
+
+        auto sources = detectSourceNodes(graph, edges);
+        std::cerr << "Detected " << sources.size() << " source nodes\n";
+
+        struct EntryResult {
+            std::string entry_name;
+            std::vector<Waypoint> chain;
+        };
+        std::vector<EntryResult> results;
+
+        t0 = Clock::now();
+        int reachable_count = 0;
+        for (int entry_v : sources) {
+            auto chain = computeDominatorChain(graph, entry_v, target_it->second);
+            if (!chain.empty()) {
+                results.push_back({graph.vertex_names[entry_v], std::move(chain)});
+                reachable_count++;
+            }
+        }
+        t1 = Clock::now();
+        std::cerr << "Dominator computation: " << reachable_count << " reachable entries, "
+                  << std::chrono::duration<double>(t1 - t0).count() << "s total\n";
+
+        std::sort(results.begin(), results.end(),
+            [](const EntryResult& a, const EntryResult& b) {
+                if (a.chain.size() != b.chain.size())
+                    return a.chain.size() < b.chain.size();
+                return a.entry_name < b.entry_name;
+            });
+
+        std::cerr << "Found " << results.size() << " reachable entries\n";
+
+        for (const auto& result : results) {
+            *out << "# entry:" << result.entry_name
+                 << " (chain_length=" << result.chain.size() << ")\n";
+            for (size_t i = 0; i < result.chain.size(); i++) {
+                if (i > 0) *out << ",";
+                *out << result.chain[i].func_name << "@" << result.chain[i].location;
+            }
+            *out << "\n";
+        }
+    } else if (cfg.relevant_entries) {
+        // Relevant-entries mode: reverse BFS + frequency-ranked output
+        runRelevantEntries(graph, edges, cfg, out);
+    }
+
+    igraph_destroy(&graph.g);
+
+    auto t_total_end = Clock::now();
+    std::cerr << "Total time: " << std::chrono::duration<double>(t_total_end - t_total_start).count() << "s\n";
+
+    return 0;
+}
